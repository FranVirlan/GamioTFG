---
/**
 * NewsCard.astro — Card de noticia tipo blog
 * Imagen portada, título, resumen, tags, fecha
 */

interface Props {
  title: string;
  summary: string;
  tags: string[];
  date: string;
  image?: string;
}

const { title, summary, tags, date, image } = Astro.props;

const tagColors = ['tag-violet', 'tag-green', 'tag-blue', 'tag-orange'];
---

<article class="news-card">
  <div class="news-image" style={image ? `background-image: url(${image});` : ''}>
    {!image && (
      <div class="news-placeholder">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
          <circle cx="8.5" cy="8.5" r="1.5"/>
          <polyline points="21 15 16 10 5 21"/>
        </svg>
      </div>
    )}
  </div>
  <div class="news-content">
    <div class="news-tags">
      {tags.map((tag, i) => (
        <span class={`tag ${tagColors[i % tagColors.length]}`}>{tag}</span>
      ))}
    </div>
    <h3 class="news-title">{title}</h3>
    <p class="news-summary">{summary}</p>
    <div class="news-meta">
      <span class="news-date">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
          <line x1="16" y1="2" x2="16" y2="6"/>
          <line x1="8" y1="2" x2="8" y2="6"/>
          <line x1="3" y1="10" x2="21" y2="10"/>
        </svg>
        {date}
      </span>
      <a href="#" class="news-link">
        Leer más
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</article>

<style>
  .news-card {
    background: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .news-card:hover {
    border-color: rgba(56, 189, 248, 0.3);
    box-shadow: 0 0 25px rgba(56, 189, 248, 0.06), 0 8px 32px rgba(0, 0, 0, 0.2);
    transform: translateY(-3px);
  }

  .news-image {
    height: 180px;
    background-size: cover;
    background-position: center;
    background-color: var(--color-bg-tertiary);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .news-placeholder {
    color: var(--color-text-muted);
    opacity: 0.4;
  }

  .news-content {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .news-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .news-title {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.3;
  }

  .news-summary {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .news-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
  }

  .news-date {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .news-link {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-accent);
    transition: all 0.2s ease;
  }

  .news-link:hover {
    color: var(--color-accent-light);
    gap: 0.5rem;
  }
</style>
