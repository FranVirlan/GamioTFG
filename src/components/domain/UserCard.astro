---
/**
 * UserCard.astro — Card horizontal de usuario para matchmaking
 * Avatar, nombre, nivel/rango, juegos favoritos, botón invitar
 */

interface Props {
  name: string;
  level: number;
  rank: 'bronze' | 'silver' | 'gold' | 'platinum' | 'diamond' | string;
  games: string[];
  region: string;
  online?: boolean;
  gameStats?: {
    game?: string;
    handle?: string;
    rankName?: string;
    rankIcon?: string;
    rankTier?: string;
    rating?: string;
    kdRatio?: string;
    winRate?: string;
    verified?: boolean;
  } | null;
}

const { name, level, rank, games, region, online = true, gameStats = null } = Astro.props;

const rankLabels: Record<string, string> = {
  bronze: '🥉 Bronce',
  silver: '🥈 Plata',
  gold: '🥇 Oro',
  platinum: '💎 Platino',
  diamond: '👑 Diamante',
  master: '🔥 Master / Élite',
  radiant: '⚡ Radiant / Top',
};

const displayRankLabel = gameStats?.rankName || rankLabels[rank] || rankLabels.bronze;
const displayRankTier = gameStats?.rankTier || rank?.toLowerCase() || 'unranked';
---

<div 
  class="user-card js-matchmaking-card"
  data-rank={displayRankTier}
  data-region={region}
  data-games={games?.join(',') || ''}
>
  <div class="user-card-left">
    <div class="user-card-avatar">
      {name.charAt(0).toUpperCase()}
      {online && <span class="online-dot user-online-dot"></span>}
    </div>
    <div class="user-card-info">
      <div class="user-card-name-row">
        <span class="user-card-name">{name}</span>
        {gameStats?.verified ? (
          <span class="verified-rank-badge" title={`Cuenta verificada de ${gameStats.game}`}>
            {gameStats.rankIcon && <img src={gameStats.rankIcon} alt="" class="card-rank-icon" />}
            <span>{displayRankLabel}</span>
            <span class="v-check">✓</span>
          </span>
        ) : (
          <span class={`badge badge-${rank}`}>{displayRankLabel}</span>
        )}
      </div>

      <div class="user-card-meta">
        <span class="user-card-level">Nv. {level}</span>
        <span class="meta-separator">•</span>
        <span class="user-card-region tag tag-blue">{region}</span>
        {gameStats && (
          <>
            <span class="meta-separator">•</span>
            {gameStats.kdRatio && <span class="stat-tag">K/D {gameStats.kdRatio}</span>}
            {gameStats.winRate && <span class="stat-tag">{gameStats.winRate} Win</span>}
          </>
        )}
      </div>

      <div class="user-card-games">
        {games.slice(0, 3).map((game) => (
          <span class="game-chip">{game}</span>
        ))}
      </div>
    </div>
  </div>
  <a href={`/perfil?usuario=${encodeURIComponent(name)}`} class="btn-accent btn-sm invite-btn requires-auth" style="text-decoration: none; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
      <circle cx="12" cy="7" r="4"></circle>
    </svg>
    Ver perfil
  </a>
</div>

<style>
  .user-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: all 0.2s ease;
  }

  .user-card:hover {
    border-color: rgba(34, 197, 94, 0.3);
    background: var(--color-surface-hover);
    box-shadow: 0 0 20px rgba(34, 197, 94, 0.06);
  }

  .user-card-left {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-width: 0;
  }

  .user-card-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    font-weight: 700;
    color: white;
    position: relative;
    flex-shrink: 0;
  }

  .user-online-dot {
    position: absolute;
    bottom: 0;
    right: 0;
  }

  .user-card-info {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .user-card-name-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .user-card-name {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-text-primary);
  }

  .verified-rank-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.55rem;
    font-size: 0.72rem;
    font-weight: 700;
    background: rgba(0, 240, 255, 0.12);
    border: 1px solid rgba(0, 240, 255, 0.3);
    color: var(--color-primary-light);
    border-radius: var(--radius-full);
  }

  .card-rank-icon {
    width: 16px;
    height: 16px;
    object-fit: contain;
  }

  .v-check {
    color: #4ade80;
    font-weight: 800;
  }

  .stat-tag {
    color: var(--color-accent-light);
    font-weight: 600;
  }

  .user-card-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .user-card-level {
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .meta-separator {
    font-size: 0.6rem;
  }

  .user-card-games {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    margin-top: 0.15rem;
  }

  .game-chip {
    padding: 0.15rem 0.5rem;
    font-size: 0.68rem;
    font-weight: 500;
    background: rgba(124, 58, 237, 0.08);
    border: 1px solid rgba(124, 58, 237, 0.15);
    border-radius: var(--radius-full);
    color: var(--color-text-secondary);
  }

  .invite-btn {
    flex-shrink: 0;
  }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .user-card {
      flex-direction: column;
      align-items: stretch;
    }

    .invite-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
