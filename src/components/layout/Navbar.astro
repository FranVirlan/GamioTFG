---
/**
 * Navbar.astro — Barra de navegación para páginas públicas
 * Gaming aesthetic: violeta/azul neón, glassmorphism
 */
import SearchBar from '../ui/SearchBar.astro';

interface Props {
  user?: {
    id: string;
    email?: string;
    user_metadata?: {
      name?: string;
      [key: string]: any;
    };
  } | null;
}

const { user = null } = Astro.props;
const currentPath = Astro.url.pathname;
const userName = user?.user_metadata?.name || user?.email?.split('@')[0] || '';

const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/juegos', label: 'Juegos' },
  { href: '/comunidad', label: 'Comunidad' },
  { href: '/noticias', label: 'Noticias' },
];
---

<nav class:list={['navbar', 'glass-strong', { 'navbar-landing': currentPath === '/' }]} id="mainNav">
  <div class="nav-container container">
    <!-- Logo -->
    <a href="/" class="nav-logo">
      <span class="logo-icon">🎮</span>
      <span class="logo-text">Gamio</span>
    </a>

    <!-- Desktop Links -->
    <div class="nav-links" id="navLinks">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={['nav-link', { active: currentPath === link.href }]}
        >
          {link.label}
        </a>
      ))}

      <div class="desktop-search">
        <SearchBar />
      </div>

      {user ? (
        <div class="nav-user">
          <a href="/mensajes" class="nav-icon-link" aria-label="Mensajes" title="Tus Mensajes" id="nav-messages-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
            <span class="unread-badge" id="unread-badge" style="display:none;"></span>
          </a>

          <!-- Notificaciones (Bell) -->
          <div class="nav-notifications-wrapper" style="position: relative;">
            <button class="nav-icon-link" aria-label="Notificaciones" title="Notificaciones" id="nav-notifications-btn" style="background: none; border: none; cursor: pointer;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
              </svg>
              <span class="unread-badge" id="notifications-badge" style="display:none;"></span>
            </button>
            
            <div class="notifications-dropdown" id="notifications-dropdown">
              <div class="dropdown-header">
                <h4>Solicitudes de Amistad</h4>
              </div>
              <div class="dropdown-list" id="notifications-list">
                <div class="dropdown-empty">Cargando...</div>
              </div>
            </div>
          </div>
          
          <a href="/perfil" class="nav-user-link">
            <span class="user-avatar">{userName.charAt(0).toUpperCase()}</span>
            <span class="user-name-nav">{userName}</span>
          </a>
          <form method="POST" action="/api/auth/logout" class="logout-form">
            <button type="submit" class="nav-logout" id="logoutBtn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                <polyline points="16 17 21 12 16 7" />
                <line x1="21" y1="12" x2="9" y2="12" />
              </svg>
              Salir
            </button>
          </form>
        </div>
      ) : (
        <div class="nav-auth-buttons">
          <a href="/signup" class="btn-outline-cyan">Registrarse</a>
          <a href="/login" class="btn-primary">Iniciar Sesión</a>
        </div>
      )}
    </div>

    <!-- Mobile Hamburger -->
    <button class="nav-hamburger" id="navHamburger" aria-label="Abrir menú de navegación">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</nav>

<!-- Mobile Menu Overlay -->
<div class="mobile-menu" id="mobileMenu">
  <div class="mobile-menu-content">
    <div class="mobile-search">
      <SearchBar />
    </div>

    {navLinks.map((link) => (
      <a
        href={link.href}
        class:list={['mobile-link', { active: currentPath === link.href }]}
      >
        {link.label}
      </a>
    ))}

    {user ? (
      <>
        <a href="/mensajes" class="mobile-link" id="mobile-messages-link" style="color: var(--color-primary-light); display: flex; align-items: center; gap: 0.5rem; margin-top: -0.5rem; position: relative;">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
          Mis Mensajes
          <span class="unread-badge mobile-badge" id="unread-badge-mobile" style="display:none;"></span>
        </a>
        <div class="mobile-user-info">
          <span class="user-avatar-lg">{userName.charAt(0).toUpperCase()}</span>
          <span>{userName}</span>
        </div>
        <form method="POST" action="/api/auth/logout">
          <button type="submit" class="btn-primary mobile-cta mobile-logout">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
              <polyline points="16 17 21 12 16 7" />
              <line x1="21" y1="12" x2="9" y2="12" />
            </svg>
            Cerrar Sesión
          </button>
        </form>
      </>
    ) : (
      <a href="/login" class="btn-primary mobile-cta">Iniciar Sesión</a>
    )}
  </div>
</div>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    padding: 0.75rem 0;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* ── Navbar Landing (Transparent initially) ── */
  .navbar-landing:not(.scrolled) {
    background: transparent;
    border-color: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    padding: 1.5rem 0;
  }

  .navbar.scrolled {
    background: rgba(10, 14, 23, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(0, 240, 255, 0.1);
    padding: 0.75rem 0;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }

  .nav-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* ── Logo ── */
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    transition: transform 0.3s ease;
  }

  .nav-logo:hover {
    transform: scale(1.05);
  }

  .logo-icon {
    font-size: 1.5rem;
    animation: float 4s ease-in-out infinite;
  }

  .logo-text {
    font-family: var(--font-heading);
    color: var(--color-text-primary);
  }

  /* ── Desktop Nav Links ── */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-link {
    position: relative;
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    border-radius: var(--radius-sm);
    transition: all 0.25s ease;
  }

  .nav-link:hover {
    color: var(--color-text-primary);
    background: rgba(0, 240, 255, 0.05); /* Cyan subtle hover */
  }

  .nav-link.active {
    color: var(--color-primary); /* Cyan active text */
    background: rgba(0, 240, 255, 0.08); /* Cyan subtle active */
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 2px;
    left: 50%;
    transform: translateX(-50%) scaleX(0);
    width: 60%;
    height: 2px;
    background: var(--color-primary); /* Cyan underline */
    border-radius: 1px;
    transition: transform 0.25s ease;
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    transform: translateX(-50%) scaleX(1);
  }

  /* ── Auth CTA ── */
  .nav-auth-buttons {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: 1rem;
  }
  
  /* Override btn primary in nav to match Torneum's smaller format initially */
  .nav-auth-buttons .btn-primary,
  .nav-auth-buttons .btn-outline-cyan {
    padding: 0.6rem 1.2rem;
    font-size: 0.85rem;
  }

  /* ── User Section ── */
  .nav-user {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: 1rem;
  }

  .nav-icon-link {
    color: var(--color-text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.4rem;
    border-radius: 50%;
    transition: all 0.2s ease;
    position: relative;
  }

  .nav-icon-link:hover {
    color: var(--color-primary-light);
    background: rgba(124, 58, 237, 0.1);
    transform: scale(1.1);
  }

  .unread-badge {
    position: absolute;
    top: -4px;
    right: -4px;
    background: #ef4444;
    color: white;
    font-size: 0.65rem;
    font-weight: 700;
    min-width: 18px;
    height: 18px;
    border-radius: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
    box-shadow: 0 0 0 2px var(--color-bg-primary);
    animation: badge-pulse 2s ease-in-out infinite;
    line-height: 1;
  }

  .unread-badge.mobile-badge {
    position: static;
    margin-left: 0.5rem;
    animation: none;
  }

  @keyframes badge-pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.15); }
  }

  .nav-user-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: opacity 0.2s ease;
  }

  .nav-user-link:hover {
    opacity: 0.85;
  }

  .user-name-nav {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .user-avatar {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 700;
    color: white;
  }

  .logout-form {
    display: inline;
  }

  .nav-logout {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.75rem;
    font-size: 0.8rem;
    font-weight: 600;
    font-family: var(--font-sans);
    color: var(--color-text-secondary);
    background: rgba(239, 68, 68, 0.08);
    border: 1px solid rgba(239, 68, 68, 0.2);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .nav-logout:hover {
    color: var(--color-error-light);
    background: rgba(239, 68, 68, 0.15);
    border-color: rgba(239, 68, 68, 0.35);
  }

  /* ── Notifications Dropdown ── */
  .notifications-dropdown {
    position: absolute;
    top: calc(100% + 15px);
    right: -10px;
    width: 360px;
    background: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: all 0.2s ease;
    z-index: 1000;
  }

  .notifications-dropdown.show {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-header {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--color-border-light);
    background: rgba(255, 255, 255, 0.02);
    border-radius: var(--radius-md) var(--radius-md) 0 0;
  }
  
  .dropdown-header h4 {
    margin: 0;
    font-size: 1.05rem;
    color: var(--color-text-primary);
    font-family: var(--font-heading);
    letter-spacing: 0.5px;
  }

  .dropdown-list {
    max-height: 400px;
    overflow-y: auto;
  }

  .dropdown-empty {
    padding: 3rem 1rem;
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .notification-item {
    padding: 1.25rem;
    border-bottom: 1px solid var(--color-border-light);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: background 0.2s;
  }
  
  .notification-item:hover {
    background: rgba(255, 255, 255, 0.03);
  }

  .notification-user {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .notification-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    font-weight: bold;
    color: white;
    flex-shrink: 0;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
  }
  
  .notification-avatar img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  .notification-info {
    flex: 1;
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--color-text-secondary);
  }
  
  .notification-info strong {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .notification-actions {
    display: flex;
    gap: 0.75rem;
    margin-left: 3.5rem; /* Alineado con el texto, dejando el espacio del avatar */
  }

  .btn-accept, .btn-reject {
    flex: 1;
    padding: 0.5rem 0;
    border: none;
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    text-align: center;
  }

  .btn-accept {
    background: rgba(34, 197, 94, 0.15);
    color: #4ADE80;
    border: 1px solid rgba(34, 197, 94, 0.3);
  }
  .btn-accept:hover { background: rgba(34, 197, 94, 0.25); border-color: rgba(34, 197, 94, 0.5); }

  .btn-reject {
    background: rgba(239, 68, 68, 0.1);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.2);
  }
  .btn-reject:hover { background: rgba(239, 68, 68, 0.2); border-color: rgba(239, 68, 68, 0.3); }

  /* ── Mobile User ── */
  .mobile-user-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-top: 0.5rem;
  }

  .user-avatar-lg {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    font-weight: 700;
    color: white;
  }

  .mobile-logout {
    background: rgba(239, 68, 68, 0.15) !important;
    border: 1px solid rgba(239, 68, 68, 0.3);
    box-shadow: none !important;
  }

  /* ── Hamburger ── */
  .nav-hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 0.5rem;
    background: none;
    border: none;
    cursor: pointer;
    z-index: 1002;
  }

  .nav-hamburger span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-text-primary);
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .nav-hamburger.open span:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .nav-hamburger.open span:nth-child(2) {
    opacity: 0;
  }

  .nav-hamburger.open span:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  /* ── Mobile Menu ── */
  .mobile-menu {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 999;
    background: rgba(11, 15, 26, 0.95);
    backdrop-filter: blur(20px);
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
  }

  .mobile-menu.open {
    opacity: 1;
    visibility: visible;
  }

  .mobile-menu-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    height: 100%;
    padding: 2rem;
  }

  .mobile-link {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    padding: 0.75rem 2rem;
    border-radius: var(--radius-md);
    transition: all 0.25s ease;
  }

  .mobile-link:hover,
  .mobile-link.active {
    color: var(--color-primary-light);
    background: rgba(124, 58, 237, 0.1);
  }

  .mobile-cta {
    margin-top: 1rem;
    width: auto;
    padding: 0.75rem 2rem;
    font-size: 1rem;
  }

  .desktop-search {
    display: block;
    margin-left: 1rem;
  }

  .mobile-search {
    display: none;
    width: 100%;
    margin-bottom: 1.5rem;
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .nav-links {
      display: none;
    }

    .desktop-search {
      display: none;
    }

    .mobile-search {
      display: block;
    }

    .nav-hamburger {
      display: flex;
    }

    .mobile-menu {
      display: block;
    }
  }
</style>

<script>
  const hamburger = document.getElementById('navHamburger');
  const mobileMenu = document.getElementById('mobileMenu');

  hamburger?.addEventListener('click', () => {
    hamburger.classList.toggle('open');
    mobileMenu?.classList.toggle('open');
    document.body.style.overflow = mobileMenu?.classList.contains('open') ? 'hidden' : '';
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      hamburger?.classList.remove('open');
      mobileMenu?.classList.remove('open');
      document.body.style.overflow = '';
    });
  });

  const navbar = document.getElementById('mainNav');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      navbar?.classList.add('scrolled');
    } else {
      navbar?.classList.remove('scrolled');
    }
  });

  // --- Notification badge logic ---
  async function updateUnreadBadge() {
    try {
      const res = await fetch('/api/unread-count');
      if (!res.ok) return;
      const { count } = await res.json();
      setBadgeCount(count);
    } catch (err) {
      // Silently fail
    }
  }

  function setBadgeCount(count: number) {
    const badge = document.getElementById('unread-badge');
    const badgeMobile = document.getElementById('unread-badge-mobile');

    [badge, badgeMobile].forEach(el => {
      if (!el) return;
      if (count > 0) {
        el.textContent = count > 99 ? '99+' : String(count);
        el.style.display = 'flex';
      } else {
        el.style.display = 'none';
      }
    });
  }

  // Check immediately and then every 60 seconds as fallback
  updateUnreadBadge();
  setInterval(updateUnreadBadge, 60000);

  // --- Realtime: actualización instantánea ---
  import { supabase } from '../../lib/supabase';

  const realtimeChannel = supabase.channel('navbar-realtime-events');

  realtimeChannel
    .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'private_messages' }, () => {
      updateUnreadBadge();
    })
    .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'friend_requests' }, () => {
      fetchFriendRequests(); // Refrescar notificaciones
    })
    .on('postgres_changes', { event: 'UPDATE', schema: 'public', table: 'friend_requests' }, () => {
      fetchFriendRequests();
    })
    .subscribe();

  // Limpiar canal al navegar con View Transitions
  document.addEventListener('astro:before-swap', () => {
    supabase.removeChannel(realtimeChannel);
  });

  // --- Dropdown Logic ---
  const notifBtn = document.getElementById('nav-notifications-btn');
  const notifDropdown = document.getElementById('notifications-dropdown');

  if (notifBtn && notifDropdown) {
    notifBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      notifDropdown.classList.toggle('show');
      if (notifDropdown.classList.contains('show')) {
        fetchFriendRequests();
      }
    });

    document.addEventListener('click', (e) => {
      if (!notifDropdown.contains(e.target as Node) && !notifBtn.contains(e.target as Node)) {
        notifDropdown.classList.remove('show');
      }
    });
  }

  async function fetchFriendRequests() {
    const list = document.getElementById('notifications-list');
    const badge = document.getElementById('notifications-badge');
    if (!list) return;

    try {
      const res = await fetch('/api/friends/notifications');
      if (!res.ok) throw new Error();
      const { requests } = await res.json();
      
      // Update badge
      if (badge) {
        if (requests.length > 0) {
          badge.textContent = requests.length;
          badge.style.display = 'flex';
        } else {
          badge.style.display = 'none';
        }
      }

      if (requests.length === 0) {
        list.innerHTML = '<div class="dropdown-empty">No tienes notificaciones.</div>';
        return;
      }

      list.innerHTML = requests.map((req: any) => {
        const senderName = req.sender?.name || 'Usuario';
        const senderInitial = senderName.charAt(0).toUpperCase();
        return `
          <div class="notification-item" id="req-${req.id}">
            <div class="notification-user">
              <div class="notification-avatar">${senderInitial}</div>
              <div class="notification-info">
                <strong>${senderName}</strong> te ha enviado una solicitud de amistad.
              </div>
            </div>
            <div class="notification-actions">
              <button class="btn-accept" onclick="respondFriendRequest('${req.id}', 'accepted')">Aceptar</button>
              <button class="btn-reject" onclick="respondFriendRequest('${req.id}', 'rejected')">Rechazar</button>
            </div>
          </div>
        `;
      }).join('');
    } catch (e) {
      list.innerHTML = '<div class="dropdown-empty">Error al cargar.</div>';
    }
  }

  // Hacerla global para el onclick
  (window as any).respondFriendRequest = async (id: string, status: string) => {
    try {
      const res = await fetch('/api/friends/respond', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ request_id: id, status })
      });
      if (res.ok) {
        // Remover el item de la lista y actualizar el badge
        const item = document.getElementById(`req-${id}`);
        if (item) item.remove();
        fetchFriendRequests(); // Re-calcular badge y vaciar si es cero
      } else {
        alert('Hubo un error al procesar la solicitud.');
      }
    } catch (e) {
      alert('Error de conexión.');
    }
  };

  // Fetch initial notifications
  fetchFriendRequests();
</script>
