---
// src/components/pdf/ArchitectureDiagram.astro
---

<div class="card border border-[#1E2E4A] bg-[#0D162B] p-6 avoid-break relative overflow-hidden flex flex-col items-center">
  <!-- Grid background decoration -->
  <div class="absolute inset-0 opacity-5 bg-[linear-gradient(to_right,#1E2E4A_1px,transparent_1px),linear-gradient(to_bottom,#1E2E4A_1px,transparent_1px)] bg-[size:2rem_2rem]"></div>
  
  <h4 class="text-xs uppercase tracking-wider text-[#7A93B8] font-bold mt-0 mb-6 text-center z-10">
    DIAGRAMA DE FLUJO DE ARQUITECTURA DISTRIBUIDA
  </h4>

  <div class="w-full flex flex-col items-center gap-4 z-10">
    <!-- Client Layer -->
    <div class="w-64 border border-[#00E5FF] bg-[#060B19] rounded-lg p-3 text-center shadow-[0_0_10px_rgba(0,229,255,0.1)]">
      <span class="text-[8pt] text-[#00E5FF] font-mono uppercase tracking-wider block mb-1">CAPA DE CLIENTE</span>
      <strong class="text-sm text-white">Cliente Web (Astro + Islas React)</strong>
    </div>

    <!-- Arrow Down -->
    <div class="h-6 w-0.5 bg-gradient-to-b from-[#00E5FF] to-[#7C3AED] relative">
      <div class="absolute bottom-0 left-1/2 -translate-x-1/2 translate-y-1 w-2 h-2 border-r-2 border-b-2 border-[#7C3AED] rotate-45"></div>
    </div>

    <!-- Server Layer -->
    <div class="w-72 border border-[#7C3AED] bg-[#060B19] rounded-lg p-3 text-center shadow-[0_0_10px_rgba(124,58,237,0.1)]">
      <span class="text-[8pt] text-[#7C3AED] font-mono uppercase tracking-wider block mb-1">CAPA DE SERVIDOR (SERVERLESS EDGE)</span>
      <strong class="text-sm text-white">Servidor Astro (Vercel API Routes)</strong>
    </div>

    <!-- Arrow Down split -->
    <div class="w-48 h-6 relative">
      <!-- Horizontal line -->
      <div class="absolute top-0 left-0 right-0 h-0.5 bg-[#7C3AED]"></div>
      <!-- Vertical line Left -->
      <div class="absolute top-0 left-0 bottom-0 w-0.5 bg-[#7C3AED]"></div>
      <div class="absolute bottom-0 left-0 -translate-x-1/2 w-2 h-2 border-r-2 border-b-2 border-[#7C3AED] rotate-45"></div>
      <!-- Vertical line Right -->
      <div class="absolute top-0 right-0 bottom-0 w-0.5 bg-[#7C3AED]"></div>
      <div class="absolute bottom-0 right-0 translate-x-1/2 w-2 h-2 border-r-2 border-b-2 border-[#7C3AED] rotate-45"></div>
    </div>

    <!-- Sub-engines Layer -->
    <div class="w-full flex justify-between gap-4 mt-2">
      <div class="flex-1 border border-[#1E2E4A] bg-[#060B19] rounded-lg p-3 text-center">
        <span class="text-[8pt] text-[#7A93B8] font-mono uppercase tracking-wider block mb-1">BASE DE DATOS RELACIONAL</span>
        <strong class="text-xs text-white">Supabase PostgreSQL (RLS / Triggers)</strong>
      </div>
      <div class="flex-1 border border-[#1E2E4A] bg-[#060B19] rounded-lg p-3 text-center">
        <span class="text-[8pt] text-[#7A93B8] font-mono uppercase tracking-wider block mb-1">NOTIFICACIONES TRANSACCIONALES</span>
        <strong class="text-xs text-white">Nodemailer SMTP (Gmail app config)</strong>
      </div>
    </div>
  </div>
</div>
