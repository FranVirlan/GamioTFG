---
// src/components/pdf/CodeBlock.astro
interface Props {
  code: string;
  language?: string;
  title?: string;
}

const { code, language = "plaintext", title } = Astro.props;
---

<div class="my-4 avoid-break rounded-lg border border-[#1E2E4A] overflow-hidden bg-[#040812]">
  {title && (
    <div class="px-4 py-2 border-b border-[#1E2E4A] bg-[#0D162B] flex justify-between items-center">
      <span class="text-xs font-bold text-white font-sans">{title}</span>
      <span class="text-[9pt] font-mono text-[#7A93B8] uppercase">{language}</span>
    </div>
  )}
  <pre class="p-4 m-0 bg-transparent border-0 rounded-none overflow-x-auto text-[9pt] leading-relaxed text-[#E2E8F0] font-mono"><code>{code.trim()}</code></pre>
</div>
