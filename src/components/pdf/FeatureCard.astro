---
// src/components/pdf/FeatureCard.astro
interface Props {
  title: string;
  route?: string;
  objective: string;
  visuals: string;
  validations: string;
  codeSnippet?: string;
}

const { title, route, objective, visuals, validations, codeSnippet } = Astro.props;
---

<div class="card border border-[#1E2E4A] bg-[#0D162B] p-5 avoid-break">
  <!-- Header -->
  <div class="flex justify-between items-baseline border-b border-[#1E2E4A]/50 pb-3 mb-4">
    <h3 class="text-base font-extrabold text-white m-0">
      {title}
    </h3>
    {route && (
      <span class="text-[9pt] font-mono text-[#00E5FF] bg-[#00E5FF]/10 px-2 py-0.5 rounded border border-[#00E5FF]/20 select-none">
        {route}
      </span>
    )}
  </div>

  <!-- Body Grid -->
  <div class="grid grid-cols-3 gap-4 text-left mb-3">
    <div class="space-y-1">
      <span class="text-[8pt] uppercase tracking-wider text-[#7A93B8] font-bold">Objetivo Funcional</span>
      <p class="text-xs text-[#7A93B8] leading-relaxed mb-0 text-justify">
        {objective}
      </p>
    </div>
    <div class="space-y-1">
      <span class="text-[8pt] uppercase tracking-wider text-[#7A93B8] font-bold">Componentes UI</span>
      <p class="text-xs text-[#7A93B8] leading-relaxed mb-0 text-justify">
        {visuals}
      </p>
    </div>
    <div class="space-y-1">
      <span class="text-[8pt] uppercase tracking-wider text-[#7A93B8] font-bold">Validaciones / API</span>
      <p class="text-xs text-[#7A93B8] leading-relaxed mb-0 text-justify">
        {validations}
      </p>
    </div>
  </div>

  {codeSnippet && (
    <div class="mt-3 border-t border-[#1E2E4A]/30 pt-3">
      <span class="text-[8pt] uppercase tracking-wider text-[#7A93B8] font-bold block mb-1.5">Fragmento de Ruta / API</span>
      <pre class="m-0 p-3 bg-[#040812] border border-[#1E2E4A] rounded text-[8pt] text-[#E2E8F0] font-mono overflow-hidden"><code>{codeSnippet.trim()}</code></pre>
    </div>
  )}
</div>
