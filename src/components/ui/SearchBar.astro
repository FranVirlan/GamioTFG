---
/**
 * SearchBar.astro
 * Componente de búsqueda inteligente con autocompletado para encontrar usuarios.
 */
---

<div class="search-container" id="searchContainer">
  <div class="search-input-wrapper">
    <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
    <input 
      type="text" 
      id="globalSearchInput" 
      class="search-input" 
      placeholder="Buscar jugador..." 
      autocomplete="off" 
    />
    <div class="search-spinner hidden" id="searchSpinner"></div>
  </div>
  
  <div id="searchResults" class="search-results hidden">
    <ul class="results-list" id="resultsList">
      <!-- Los resultados se inyectarán aquí -->
    </ul>
  </div>
</div>

<style>
  .search-container {
    position: relative;
    width: 100%;
    max-width: 280px;
    margin: 0 1rem;
    z-index: 1100;
  }

  .search-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 10px;
    color: var(--color-text-muted);
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    padding: 0.5rem 1rem 0.5rem 2.2rem;
    font-size: 0.9rem;
    font-family: var(--font-sans);
    color: var(--color-text-primary);
    background: rgba(11, 15, 26, 0.5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    transition: all 0.2s ease;
  }

  .search-input:focus {
    outline: none;
    border-color: var(--color-primary);
    background: rgba(11, 15, 26, 0.8);
    box-shadow: 0 0 0 2px rgba(124, 58, 237, 0.2);
  }

  .search-input::placeholder {
    color: var(--color-text-muted);
  }

  .search-spinner {
    position: absolute;
    right: 10px;
    width: 14px;
    height: 14px;
    border: 2px solid var(--color-border);
    border-top-color: var(--color-primary);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .hidden {
    display: none !important;
  }

  /* Dropdown de Resultados */
  .search-results {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    width: 100%;
    background: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
    overflow: hidden;
  }

  .results-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-height: 300px;
    overflow-y: auto;
  }

  .results-list::-webkit-scrollbar { width: 4px; }
  .results-list::-webkit-scrollbar-thumb { background: var(--color-border); border-radius: 4px; }

  /* Estilos para los items generados por JS */
  :global(.search-result-item) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    text-decoration: none;
    color: var(--color-text-primary);
    border-bottom: 1px solid var(--color-border-light);
    transition: background 0.2s;
  }

  :global(.search-result-item:last-child) {
    border-bottom: none;
  }

  :global(.search-result-item:hover) {
    background: rgba(124, 58, 237, 0.1);
  }

  :global(.search-avatar) {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 0.8rem;
    color: white;
    overflow: hidden;
    flex-shrink: 0;
  }

  :global(.search-avatar img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  :global(.search-name) {
    font-size: 0.9rem;
    font-weight: 500;
  }

  :global(.search-empty) {
    padding: 1rem;
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  @media (max-width: 768px) {
    .search-container {
      max-width: 100%;
      margin: 1rem 0 0 0;
    }
  }
</style>

<script>
  let debounceTimer: ReturnType<typeof setTimeout>;
  
  const input = document.getElementById('globalSearchInput') as HTMLInputElement;
  const resultsContainer = document.getElementById('searchResults');
  const resultsList = document.getElementById('resultsList');
  const spinner = document.getElementById('searchSpinner');

  if (input && resultsContainer && resultsList && spinner) {
    // Cerrar si se hace clic fuera
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!target.closest('#searchContainer')) {
        resultsContainer.classList.add('hidden');
      }
    });

    input.addEventListener('focus', () => {
      if (input.value.trim().length >= 2) {
        resultsContainer.classList.remove('hidden');
      }
    });

    input.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value.trim();

      clearTimeout(debounceTimer);

      if (query.length < 2) {
        resultsContainer.classList.add('hidden');
        resultsList.innerHTML = '';
        return;
      }

      spinner.classList.remove('hidden');
      
      debounceTimer = setTimeout(async () => {
        try {
          const res = await fetch(`/api/users/search?q=${encodeURIComponent(query)}`);
          if (!res.ok) throw new Error('Error buscando');
          const data = await res.json();
          
          renderResults(data);
        } catch (error) {
          console.error(error);
          resultsList.innerHTML = `<li class="search-empty">Hubo un error en la búsqueda.</li>`;
        } finally {
          spinner.classList.add('hidden');
          resultsContainer.classList.remove('hidden');
        }
      }, 300); // 300ms debounce
    });

    function renderResults(users: any[]) {
      if (!users || users.length === 0) {
        resultsList!.innerHTML = `<li class="search-empty">No se encontraron jugadores.</li>`;
        return;
      }

      const html = users.map(user => {
        const avatarHtml = user.avatar_url 
          ? `<img src="${user.avatar_url}" alt="${user.name}" />`
          : `<span>${(user.name || '?').charAt(0).toUpperCase()}</span>`;

        return `
          <li>
            <a href="/perfil?usuario=${encodeURIComponent(user.name)}" class="search-result-item">
              <div class="search-avatar">${avatarHtml}</div>
              <span class="search-name">${user.name}</span>
            </a>
          </li>
        `;
      }).join('');

      resultsList!.innerHTML = html;
    }
  }
</script>
