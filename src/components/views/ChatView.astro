---

import { supabase } from '../../lib/supabase';

const user = Astro.locals.user;
// 1. Cargar historial del chat Server-Side (últimos 100 mensajes)
const { data: messagesData } = await supabase
  .from('messages')
  .select('*, profiles(name, avatar_url)')
  .order('created_at', { ascending: true })
  .limit(100);

const messages = messagesData || [];
---

<div class="chat-layout animate-fade-in-up" id="chat-root" data-current-user={user?.id} data-active-room="global">
    <!-- Sidebar de Canales -->
    <aside class="chat-sidebar">
      <div class="sidebar-header">
        <h3>Salas de Gamio</h3>
      </div>
      <ul class="channel-list">
        <li class="channel-item active" data-room="global">
          <span class="hashtag">#</span>
          Lobby Global
        </li>
      </ul>
    </aside>

    <!-- Zona Principal del Chat -->
    <main class="chat-main">
      <header class="chat-header">
        <div class="header-info">
          <span class="hashtag">#</span>
          <h2 id="chat-room-title">Lobby Global</h2>
        </div>
        <p class="header-desc" id="chat-room-desc">Chat público para encontrar jugadores de toda la comunidad.</p>
      </header>

      <!-- Mensajes -->
      <div class="messages-container" id="messages-container">
        {messages.map((msg) => {
          const isMine = user && msg.profile_id === user.id;
          const msgRoom = msg.room || 'global';
          return (
            <div class={`message ${isMine ? 'message-mine' : 'message-other'}`} data-room={msgRoom}>
              {!isMine && (
                <div class="avatar">
                  {msg.profiles?.avatar_url ? (
                    <img src={msg.profiles.avatar_url} alt="avatar" />
                  ) : (
                    <span>{msg.profiles?.name?.charAt(0).toUpperCase() || '?'}</span>
                  )}
                </div>
              )}
              <div class="message-content">
                {!isMine && (
                  <div class="message-header-row" style="display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;">
                    <div class="message-author">{msg.profiles?.name || 'Usuario'}</div>
                    <button class="chat-report-btn" data-reported-id={msg.profile_id} data-reported-name={msg.profiles?.name} data-message-content={msg.content} data-room={msgRoom} title="Reportar mensaje" style="background: transparent; border: none; color: var(--color-text-muted); cursor: pointer; padding: 2px 4px; border-radius: 4px; display: flex; align-items: center; gap: 2px; font-size: 0.72rem; transition: all 0.2s;">
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/>
                      </svg>
                      Reportar
                    </button>
                  </div>
                )}
                <div class="message-bubble">
                  {msg.content}
                </div>
                <div class="message-time">
                  {new Date(msg.created_at).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' })}
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Barra de escritura -->
      <div class="chat-input-area">
        {user ? (
          <form id="chat-form" class="chat-form">
            <button type="button" class="attach-btn" title="Adjuntar archivo">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48" />
              </svg>
            </button>
            <input 
              type="text" 
              id="chat-input" 
              class="chat-input" 
              placeholder="Enviar mensaje al #Lobby Global..." 
              autocomplete="off" 
              required 
            />
            <button type="submit" class="send-btn" id="send-btn" title="Enviar">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">
                <line x1="22" y1="2" x2="11" y2="13" />
                <polygon points="22 2 15 22 11 13 2 9 22 2" />
              </svg>
            </button>
          </form>
        ) : (
          <div class="chat-auth-prompt" style="text-align: center; padding: 0.5rem; background: rgba(11, 15, 26, 0.6); border: 1px dashed var(--color-border); border-radius: var(--radius-sm); color: var(--color-text-muted);">
            <a href="/login" style="color: var(--color-primary-light); text-decoration: underline;">Inicia sesión</a> para participar en el chat.
          </div>
        )}
      </div>
    </main>
  </div>

<!-- ══════════ MODAL: Reportar Mensaje ══════════ -->
{user && (
<div id="chat-report-modal" class="pv-modal-overlay pv-hidden">
  <div class="pv-modal-content animate-fade-in-up">
    <div class="pv-modal-header">
      <h3 style="color: #f87171; display: flex; align-items: center; gap: 0.5rem; font-family: var(--font-heading);">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/>
        </svg>
        Reportar Comportamiento
      </h3>
      <button class="pv-close-btn" data-close="chat-report-modal">&times;</button>
    </div>
    <form id="chat-report-form" class="pv-form">
      <input type="hidden" id="chat-report-target-id" value="" />
      <input type="hidden" id="chat-report-room" value="" />
      
      <div class="pv-form-group">
        <label>Jugador denunciado</label>
        <input type="text" id="chat-report-target-name" value="" disabled style="background: rgba(255,255,255,0.05); color: var(--color-text-secondary);" />
      </div>

      <div class="pv-form-group">
        <label for="chat-report-reason">Motivo de la denuncia</label>
        <select id="chat-report-reason" style="width: 100%; padding: 0.75rem 1rem; font-size: 0.95rem; font-family: var(--font-sans); color: var(--color-text-primary); background: rgba(11,15,26,0.6); border: 1px solid var(--color-border); border-radius: var(--radius-sm); outline: none; cursor: pointer;" required>
          <option value="chat_abuse" selected>Abuso o acoso en chat (insultos, toxicidad)</option>
          <option value="gameplay_abuse">Mala conducta al jugar (trampas, abandono)</option>
          <option value="spam">Spam / Publicidad molesta</option>
          <option value="other">Otro motivo</option>
        </select>
      </div>

      <div class="pv-form-group">
        <label for="chat-report-details">Mensaje reportado y detalles</label>
        <textarea id="chat-report-details" rows="4" placeholder="Describe brevemente lo ocurrido..." required></textarea>
      </div>

      <div class="pv-modal-footer">
        <button type="button" class="btn-secondary" data-close="chat-report-modal">Cancelar</button>
        <button type="submit" class="btn-primary" id="chat-submit-report-btn" style="background: #ef4444; border-color: rgba(239, 68, 68, 0.4); box-shadow: 0 4px 15px rgba(239, 68, 68, 0.2);">Enviar Denuncia 🚩</button>
      </div>
    </form>
  </div>
</div>
)}

<style is:global>
  .chat-layout {
    display: flex;
    height: 600px;
    max-height: 70vh;
    margin: 0; /* Se quitan los márgenes fijos para que encaje al 100% en su contenedor */
    background: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  /* ── Sidebar de Canales ── */
  .chat-sidebar {
    width: 200px; /* Reducido de 250px a 200px para dar más espacio a los mensajes */
    background: rgba(11, 15, 26, 0.4);
    border-right: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
  }

  .sidebar-header {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--color-border-light);
  }

  .sidebar-header h3 {
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .channel-list {
    list-style: none;
    padding: 1rem 0.5rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .channel-item {
    padding: 0.5rem 1rem;
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
    font-weight: 500;
    font-size: 0.95rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.2s ease;
  }

  .channel-item:hover {
    background: rgba(124, 58, 237, 0.1);
    color: var(--color-text-primary);
  }

  .channel-item.active {
    background: rgba(124, 58, 237, 0.2);
    color: white;
  }

  .hashtag {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    font-weight: 300;
  }

  /* ── Main Chat Area ── */
  .chat-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .chat-header {
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-card);
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .header-info {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .header-info h2 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .header-desc {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    margin: 0;
    border-left: 1px solid var(--color-border);
    padding-left: 1rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ── Messages Container ── */
  .messages-container {
    flex: 1;
    padding: 1.5rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* Scrollbar estético */
  .messages-container::-webkit-scrollbar {
    width: 6px;
  }
  .messages-container::-webkit-scrollbar-track {
    background: transparent;
  }
  .messages-container::-webkit-scrollbar-thumb {
    background: var(--color-border);
    border-radius: 10px;
  }

  .message {
    display: none;
    align-items: flex-end;
    gap: 0.75rem;
    max-width: 75%;
    animation: fadeIn 0.2s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Filtrar mensajes según la sala activa */
  .chat-layout[data-active-room="global"] .message[data-room="global"] {
    display: flex;
  }

  .chat-layout[data-active-room="rankeds"] .message[data-room="rankeds"] {
    display: flex;
  }

  /* Pulsing unread neon indicator badge */
  .unread-badge {
    width: 8px;
    height: 8px;
    background: var(--color-accent, #00f0ff);
    border-radius: 50%;
    margin-left: auto;
    box-shadow: 0 0 8px var(--color-accent, #00f0ff);
    flex-shrink: 0;
    animation: pulse 1.5s infinite;
  }

  @keyframes pulse {
    0% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.3); opacity: 0.7; }
    100% { transform: scale(1); opacity: 1; }
  }

  .message-other {
    align-self: flex-start;
  }

  .message-mine {
    align-self: flex-end;
    flex-direction: row-reverse;
  }

  .avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: bold;
    font-size: 0.85rem;
    flex-shrink: 0;
    overflow: hidden;
  }

  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .message-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .message-author {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    margin-left: 0.25rem;
  }

  .message-mine .message-author {
    display: none; /* No mostramos nombre en mensajes propios */
  }

  .message-bubble {
    padding: 0.75rem 1rem;
    border-radius: 18px;
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--color-text-primary);
  }

  .message-other .message-bubble {
    background: rgba(43, 53, 76, 0.6);
    border-bottom-left-radius: 4px;
  }

  .message-mine .message-bubble {
    background: var(--color-secondary);
    color: white;
    border-bottom-right-radius: 4px;
    box-shadow: 0 4px 15px rgba(108, 58, 255, 0.2);
  }

  .message-time {
    font-size: 0.65rem;
    color: var(--color-text-muted);
    margin-top: 2px;
  }

  .message-mine .message-time {
    text-align: right;
  }

  /* ── Chat Input ── */
  .chat-input-area {
    padding: 1rem 1.5rem;
    background: var(--color-surface-card);
    border-top: 1px solid var(--color-border);
  }

  .chat-form {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: rgba(11, 15, 26, 0.6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: 0.5rem 0.75rem;
    transition: all 0.2s ease;
  }

  .chat-form:focus-within {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 2px rgba(124, 58, 237, 0.15);
  }

  .attach-btn {
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    border-radius: 50%;
    transition: all 0.2s;
    flex-shrink: 0;
  }

  .attach-btn:hover {
    color: var(--color-text-primary);
    background: rgba(255, 255, 255, 0.05);
  }

  .chat-input {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--color-text-primary);
    font-size: 0.95rem;
    font-family: var(--font-sans);
    padding: 0.25rem;
    min-width: 0; /* Permite que el input se encoja correctamente sin empujar a los botones */
  }

  .chat-input:focus {
    outline: none;
  }

  .chat-input::placeholder {
    color: var(--color-text-muted);
  }

  .send-btn {
    background: var(--color-primary);
    color: white;
    border: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }

  .send-btn:hover {
    background: var(--color-primary-light);
    transform: scale(1.05);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .chat-layout {
      margin: 0;
      border-radius: 0;
      height: calc(100vh - var(--topbar-height));
      border: none;
      border-top: 1px solid var(--color-border);
    }
    
    .chat-sidebar {
      display: none; /* En móvil escondemos la sidebar por defecto, requiere tap para abrir */
    }

    .header-desc {
      display: none;
    }
    
    .message {
      max-width: 90%;
    }
  }
</style>

<script>
  import { supabase } from '../../lib/supabase';

  function initChat() {
    const chatRoot = document.getElementById('chat-root');
    const messagesContainer = document.getElementById('messages-container');
    const chatForm = document.getElementById('chat-form') as HTMLFormElement | null;
    const chatInput = document.getElementById('chat-input') as HTMLInputElement | null;
    const chatRoomTitle = document.getElementById('chat-room-title');
    const chatRoomDesc = document.getElementById('chat-room-desc');

    if (!chatRoot || !messagesContainer) return;

    const currentUserId = chatRoot.dataset.currentUser;
    let currentRoom = chatRoot.dataset.activeRoom || 'global';

    const roomDetails: Record<string, { title: string, desc: string, placeholder: string }> = {
      global: {
        title: 'Lobby Global',
        desc: 'Chat público para encontrar jugadores de toda la comunidad.',
        placeholder: 'Enviar mensaje al #Lobby Global...'
      },
      rankeds: {
        title: 'Buscando Equipo (Rankeds)',
        desc: 'Salas de reclutamiento para partidas competitivas y clasificatorias.',
        placeholder: 'Enviar mensaje al #Buscando Equipo (Rankeds)...'
      }
    };

    function scrollToBottom() {
      if (messagesContainer) {
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
      }
    }
    scrollToBottom();

    // ── Cambio de Canales en tiempo real (Disponible para todos) ──
    const channelItems = document.querySelectorAll('.channel-item');
    channelItems.forEach(item => {
      item.addEventListener('click', () => {
        const itemEl = item as HTMLElement;
        const newRoom = itemEl.dataset.room;
        if (!newRoom || newRoom === currentRoom) return;

        // Cambiar clases activas
        channelItems.forEach(c => c.classList.remove('active'));
        itemEl.classList.add('active');

        // Actualizar variables y dataset del contenedor
        currentRoom = newRoom;
        chatRoot.dataset.activeRoom = newRoom;

        // Actualizar textos de cabecera y placeholders
        const details = roomDetails[newRoom];
        if (details) {
          if (chatRoomTitle) chatRoomTitle.textContent = details.title;
          if (chatRoomDesc) chatRoomDesc.textContent = details.desc;
          if (chatInput) chatInput.placeholder = details.placeholder;
        }

        // Eliminar badge de no leídos al entrar
        const badge = itemEl.querySelector('.unread-badge');
        if (badge) badge.remove();

        scrollToBottom();
      });
    });

    // ── Enviar mensajes a la base de datos (Solo si está logueado) ──
    if (chatForm && chatInput && currentUserId) {
      chatForm.addEventListener('submit', async (e) => {
        e.preventDefault(); // Evitar la recarga
        const content = chatInput.value.trim();
        if (!content) return;

        chatInput.value = ''; // Limpiamos la caja rápido
        chatInput.focus();

        try {
          const res = await fetch('/api/messages', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ content, room: currentRoom })
          });
          
          if (!res.ok) throw new Error('Network error');
        } catch (err) {
          console.error('Error enviando mensaje:', err);
          alert('No se pudo enviar el mensaje. Error de servidor.');
        }
      });
    }

    // ── MAGIA: Canal WebSockets de Supabase ──
    const channel = supabase.channel('public:messages');

    channel
      .on(
        'postgres_changes',
        { event: 'INSERT', schema: 'public', table: 'messages' },
        async (payload) => {
          const newMessage = payload.new;
          const msgRoom = newMessage.room || 'global';
          
          const { data: authorProfile } = await supabase
            .from('profiles')
            .select('name, avatar_url')
            .eq('id', newMessage.profile_id)
            .single();

          const isMine = newMessage.profile_id === currentUserId;
          const time = new Date(newMessage.created_at).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });
          const authorName = authorProfile?.name || 'Usuario';
          const authorAvatar = authorProfile?.avatar_url 
            ? `<img src="${authorProfile.avatar_url}" alt="avatar" />`
            : `<span>${authorName.charAt(0).toUpperCase()}</span>`;

          const msgOuter = document.createElement('div');
          msgOuter.className = `message ${isMine ? 'message-mine' : 'message-other'}`;
          msgOuter.dataset.room = msgRoom;

          let innerHTML = '';
          if (!isMine) {
            innerHTML += `<div class="avatar">${authorAvatar}</div>`;
          }

          innerHTML += `<div class="message-content">`;
          if (!isMine) {
            innerHTML += `
              <div class="message-header-row" style="display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;">
                <div class="message-author">${authorName}</div>
                <button class="chat-report-btn" data-reported-id="${newMessage.profile_id}" data-reported-name="${authorName}" data-message-content="${newMessage.content}" data-room="${msgRoom}" title="Reportar mensaje" style="background: transparent; border: none; color: var(--color-text-muted); cursor: pointer; padding: 2px 4px; border-radius: 4px; display: flex; align-items: center; gap: 2px; font-size: 0.72rem; transition: all 0.2s;">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/>
                  </svg>
                  Reportar
                </button>
              </div>
            `;
          }
          innerHTML += `<div class="message-bubble">${newMessage.content}</div>`;
          innerHTML += `<div class="message-time">${time}</div>`;
          innerHTML += `</div>`;

          msgOuter.innerHTML = innerHTML;

          messagesContainer.appendChild(msgOuter);

          // Si el mensaje corresponde a la sala activa, hacer scroll. Si no, añadir un badge de alerta
          if (msgRoom === currentRoom) {
            scrollToBottom();
          } else {
            const otherChannelItem = document.querySelector(`.channel-item[data-room="${msgRoom}"]`);
            if (otherChannelItem) {
              let badge = otherChannelItem.querySelector('.unread-badge');
              if (!badge) {
                badge = document.createElement('span');
                badge.className = 'unread-badge';
                otherChannelItem.appendChild(badge);
              }
            }
          }
        }
      )
      .subscribe();

      // ── Delegación de Eventos para Reporte desde Chat (Evita desvinculaciones por Astro swaps) ──
      const onChatClick = (e: MouseEvent) => {
        const target = e.target as HTMLElement;
        const btn = target.closest('.chat-report-btn') as HTMLButtonElement | null;
        if (btn) {
          const reportedId = btn.dataset.reportedId;
          const reportedName = btn.dataset.reportedName;
          const messageContent = btn.dataset.messageContent;
          const room = btn.dataset.room;

          if (reportedId && reportedName) {
            const modal = document.getElementById('chat-report-modal');
            const inputId = document.getElementById('chat-report-target-id') as HTMLInputElement;
            const inputName = document.getElementById('chat-report-target-name') as HTMLInputElement;
            const inputRoom = document.getElementById('chat-report-room') as HTMLInputElement;
            const textDetails = document.getElementById('chat-report-details') as HTMLTextAreaElement;

            if (modal && inputId && inputName && inputRoom && textDetails) {
              inputId.value = reportedId;
              inputName.value = reportedName;
              inputRoom.value = room || 'global';
              textDetails.value = `Mala conducta en chat: "${messageContent}"`;
              
              modal.classList.remove('pv-hidden');
            }
          }
          return;
        }

        // Cerrar modal al hacer clic en botones de cerrar o fuera del modal
        const closeBtn = target.closest('[data-close="chat-report-modal"]');
        if (closeBtn || target === document.getElementById('chat-report-modal')) {
          document.getElementById('chat-report-modal')?.classList.add('pv-hidden');
        }
      };

      document.removeEventListener('click', onChatClick);
      document.addEventListener('click', onChatClick);

      // Enviar reporte del chat
      const chatReportForm = document.getElementById('chat-report-form') as HTMLFormElement | null;
      if (chatReportForm) {
        chatReportForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          const submitBtn = document.getElementById('chat-submit-report-btn') as HTMLButtonElement;
          const originalText = submitBtn.textContent;
          submitBtn.disabled = true;
          submitBtn.textContent = 'Enviando...';

          const reported_id = (document.getElementById('chat-report-target-id') as HTMLInputElement).value;
          const reason = (document.getElementById('chat-report-reason') as HTMLSelectElement).value;
          const details = (document.getElementById('chat-report-details') as HTMLTextAreaElement).value;
          const chat_room = (document.getElementById('chat-report-room') as HTMLInputElement).value;

          try {
            const res = await fetch('/api/reports', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ reported_id, reason, details, chat_room })
            });

            if (res.ok) {
              alert('¡Reporte enviado con éxito! Los moderadores revisarán la conducta en este chat.');
              document.getElementById('chat-report-modal')?.classList.add('pv-hidden');
              chatReportForm.reset();
            } else {
              const data = await res.json();
              alert('Error: ' + (data.error || 'No se pudo enviar el reporte.'));
              submitBtn.disabled = false;
              submitBtn.textContent = originalText;
            }
          } catch (err) {
            alert('Error conectando con el servidor.');
            submitBtn.disabled = false;
            submitBtn.textContent = originalText;
          }
        });
      }
      
      document.addEventListener('astro:before-swap', () => {
        supabase.removeChannel(channel);
      }, { once: true });
  }

  // Inicializar el chat cada vez que Astro carga una página
  document.addEventListener('astro:page-load', initChat);
</script>
