---
/**
 * CommunityView.astro
 * Vista de la comunidad con posts tipo feed.
 */

import { supabase } from '../../lib/supabase';
import CreatePostModal from './CreatePostModal.astro';

const user = Astro.locals.user;

// Solo mostrar anuncios de las últimas 2 horas
const twoHoursAgo = new Date(Date.now() - 2 * 60 * 60 * 1000).toISOString();

const { data } = await supabase
  .from('posts')
  .select('*, profiles(name, avatar_url)')
  .gte('created_at', twoHoursAgo)
  .order('created_at', { ascending: false });
const posts = data || [];
---

<div class="community-view animate-fade-in-up">
  <div class="community-header">
    <h2>Comunidad</h2>
    <button class="btn-primary requires-auth" id="open-create-post-btn">Crear Anuncio LFG</button>
  </div>

  <div class="feed-container">
    {posts.length > 0 ? (
      posts.map(post => (
        <div class="post-card">
          <div class="post-header">
            <div class="post-avatar">
              {post.profiles?.avatar_url ? (
                <img src={post.profiles.avatar_url} alt={post.profiles?.name} style="width:100%;height:100%;border-radius:50%;object-fit:cover;" />
              ) : (
                post.profiles?.name?.charAt(0).toUpperCase() || 'U'
              )}
            </div>
            <div class="post-meta">
              <span class="post-author">{post.profiles?.name || 'Usuario'}</span>
              <span class="post-time">{new Date(post.created_at).toLocaleDateString('es-ES', { day: 'numeric', month: 'short' })}</span>
            </div>
            {post.game && (
              <div class="post-game-badge ml-auto">
                {post.game}
              </div>
            )}
          </div>
          <div class="post-content">
            {(post.mode || post.spots || (post.tags && post.tags.length > 0)) && (
              <div class="post-lfg-info">
                {post.mode && <span class="badge mode-badge">{post.mode}</span>}
                {post.spots && <span class="badge spots-badge">Faltan {post.spots}</span>}
                {post.tags && post.tags.map((tag: string) => (
                  <span class="badge tag-badge">{tag}</span>
                ))}
              </div>
            )}
            <p>{post.content}</p>
          </div>
          <div class="post-actions">
            {user?.id === post.author_id && (
              <button class="action-btn delete-post-btn" data-post-id={post.id} title="Eliminar anuncio">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" color="#ef4444">
                  <polyline points="3 6 5 6 21 6"></polyline>
                  <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                </svg>
              </button>
            )}
            {(!user || user.id !== post.author_id) && (
              <button class="btn-primary message-btn ml-auto requires-auth" data-target-id={post.author_id}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                </svg>
                Enviar Mensaje
              </button>
            )}
          </div>
        </div>
      ))
    ) : (
      <div class="empty-state">
        <p>No hay publicaciones en la comunidad aún. ¡Sé el primero!</p>
      </div>
    )}
  </div>
</div>

<style>
  .community-view {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
  }

  .community-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .community-header h2 {
    font-family: var(--font-heading);
    font-size: 2rem;
  }

  .feed-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .post-card {
    background: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .post-card:hover {
    border-color: rgba(124, 58, 237, 0.3);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  }

  .post-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .post-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    color: white;
  }

  .post-meta {
    display: flex;
    flex-direction: column;
  }

  .post-author {
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .post-time {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .post-content {
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .post-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    border-top: 1px solid var(--color-border-light);
    padding-top: 1rem;
  }

  .action-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: 0.5rem;
    border-radius: var(--radius-sm);
    transition: all 0.2s ease;
  }

  .action-btn:hover {
    color: var(--color-primary);
    background: rgba(124, 58, 237, 0.1);
  }

  .ml-auto {
    margin-left: auto;
  }

  .post-game-badge {
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    color: white;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .post-lfg-info {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .badge {
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .mode-badge {
    background: rgba(56, 189, 248, 0.15);
    color: var(--color-accent);
    border: 1px solid rgba(56, 189, 248, 0.3);
  }

  .spots-badge {
    background: rgba(16, 185, 129, 0.15);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .tag-badge {
    background: rgba(43, 53, 76, 0.8);
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
  }

  .message-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    padding: 0.5rem 1rem;
  }

  .message-btn:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .empty-state {
    padding: 3rem;
    text-align: center;
    background: var(--color-surface-card);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
  }
</style>

<script>
  const msgBtns = document.querySelectorAll('.message-btn');
  msgBtns.forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const targetId = (e.currentTarget as HTMLElement).dataset.targetId;
      if (!targetId) return;

      const originalText = btn.textContent;
      btn.textContent = 'Conectando...';
      btn.setAttribute('disabled', 'true');

      try {
        const res = await fetch('/api/conversations', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ target_profile_id: targetId })
        });
        const data = await res.json();
        
        if (res.ok && data.id) {
          window.location.href = `/mensajes/${data.id}`;
        } else {
          alert('Error: ' + (data.error || 'No se pudo iniciar el chat'));
          btn.textContent = originalText || 'Enviar Mensaje';
          btn.removeAttribute('disabled');
        }
      } catch (err) {
        console.error(err);
        alert('Error conectando con el servidor.');
        btn.textContent = originalText || 'Enviar Mensaje';
        btn.removeAttribute('disabled');
      }
    });
  });

  const deleteBtns = document.querySelectorAll('.delete-post-btn');
  deleteBtns.forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const postId = (e.currentTarget as HTMLElement).dataset.postId;
      if (!postId) return;

      if (!confirm('¿Ya has encontrado a quien buscabas y quieres eliminar este anuncio?')) return;

      const originalHTML = btn.innerHTML;
      btn.innerHTML = '<span style="font-size: 0.8rem">...</span>';
      btn.setAttribute('disabled', 'true');

      try {
        const res = await fetch('/api/posts', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: postId })
        });
        
        if (res.ok) {
          window.location.reload();
        } else {
          const data = await res.json();
          alert('Error: ' + (data.error || 'No se pudo eliminar el anuncio'));
          btn.innerHTML = originalHTML;
          btn.removeAttribute('disabled');
        }
      } catch (err) {
        console.error(err);
        alert('Error conectando con el servidor.');
        btn.innerHTML = originalHTML;
        btn.removeAttribute('disabled');
      }
    });
  });
</script>
