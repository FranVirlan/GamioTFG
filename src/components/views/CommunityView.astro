---
/**
 * CommunityView.astro
 * Vista de la comunidad con posts tipo feed.
 */

import { supabase } from '../../lib/supabase';

const { data } = await supabase.from('posts').select('*, profiles(name, avatar_url)').order('created_at', { ascending: false });
const posts = data || [];
---

<div class="community-view animate-fade-in-up">
  <div class="community-header">
    <h2>Comunidad</h2>
    <button class="btn-primary requires-auth">Crear Post</button>
  </div>

  <div class="feed-container">
    {posts.length > 0 ? (
      posts.map(post => (
        <div class="post-card">
          <div class="post-header">
            <div class="post-avatar">
              {post.profiles?.avatar_url ? (
                <img src={post.profiles.avatar_url} alt={post.profiles?.name} style="width:100%;height:100%;border-radius:50%;object-fit:cover;" />
              ) : (
                post.profiles?.name?.charAt(0).toUpperCase() || 'U'
              )}
            </div>
            <div class="post-meta">
              <span class="post-author">{post.profiles?.name || 'Usuario'}</span>
              <span class="post-time">{new Date(post.created_at).toLocaleDateString('es-ES', { day: 'numeric', month: 'short' })}</span>
            </div>
          </div>
          <div class="post-content">
            <p>{post.content}</p>
          </div>
          <div class="post-actions">
            <button class="action-btn requires-auth">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
              </svg>
              <span>{post.likes_count}</span>
            </button>
            <button class="action-btn requires-auth">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
              </svg>
              <span>{post.comments_count}</span>
            </button>
            <button class="action-btn ml-auto">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="18" cy="5" r="3"></circle>
                <circle cx="6" cy="12" r="3"></circle>
                <circle cx="18" cy="19" r="3"></circle>
                <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
              </svg>
            </button>
          </div>
        </div>
      ))
    ) : (
      <div class="empty-state">
        <p>No hay publicaciones en la comunidad aún. ¡Sé el primero!</p>
      </div>
    )}
  </div>
</div>

<style>
  .community-view {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
  }

  .community-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .community-header h2 {
    font-family: var(--font-heading);
    font-size: 2rem;
  }

  .feed-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .post-card {
    background: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .post-card:hover {
    border-color: rgba(124, 58, 237, 0.3);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  }

  .post-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .post-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    color: white;
  }

  .post-meta {
    display: flex;
    flex-direction: column;
  }

  .post-author {
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .post-time {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .post-content {
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .post-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    border-top: 1px solid var(--color-border-light);
    padding-top: 1rem;
  }

  .action-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: 0.5rem;
    border-radius: var(--radius-sm);
    transition: all 0.2s ease;
  }

  .action-btn:hover {
    color: var(--color-primary);
    background: rgba(124, 58, 237, 0.1);
  }

  .ml-auto {
    margin-left: auto;
  }

  .empty-state {
    padding: 3rem;
    text-align: center;
    background: var(--color-surface-card);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
  }
</style>
