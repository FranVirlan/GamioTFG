---
/**
 * GamesView.astro
 * Vista de juegos disponibles con grid.
 */
import GameCard from '../domain/GameCard.astro';
import { supabase } from '../../lib/supabase';

const { data: dbGames } = await supabase.from('games').select('*');
const { data: profilesData } = await supabase.from('profiles').select('favorite_games');

// Calcular el número real de jugadores contando en tiempo real
const gameCounts: Record<string, number> = {};
if (profilesData) {
  profilesData.forEach(p => {
    if (p.favorite_games && Array.isArray(p.favorite_games)) {
      p.favorite_games.forEach(gameName => {
        let key = gameName.toLowerCase();
        // Normalizar nombres antiguos o desajustados para que coincidan con el catálogo
        if (key === 'call of duty') key = 'call of duty: warzone';
        if (key === 'ea fc 24') key = 'ea fc 25';
        
        gameCounts[key] = (gameCounts[key] || 0) + 1;
      });
    }
  });
}

const staticGames = [
  { name: 'League of Legends', genre: 'MOBA', color_theme: 'violet', image: 'https://images.igdb.com/igdb/image/upload/t_cover_big/co49wj.jpg' },
  { name: 'Valorant', genre: 'FPS TÁCTICO', color_theme: 'blue', image: 'https://images.igdb.com/igdb/image/upload/t_cover_big/co2mvt.jpg' },
  { name: 'EA FC 25', genre: 'Deportes', color_theme: 'green', image: 'https://steamcdn-a.akamaihd.net/steam/apps/2669320/library_600x900.jpg' },
  { name: 'Dead By Daylight', genre: 'Survival', color_theme: 'violet', image: 'https://steamcdn-a.akamaihd.net/steam/apps/381210/library_600x900.jpg' },
  { name: 'Call of Duty: Warzone', genre: 'Battle Royale', color_theme: 'orange', image: 'https://steamcdn-a.akamaihd.net/steam/apps/1962663/library_600x900.jpg' },
  { name: 'Rocket League', genre: 'Deportes', color_theme: 'blue', image: 'https://steamcdn-a.akamaihd.net/steam/apps/252950/library_600x900.jpg' },
  { name: 'Fortnite', genre: 'Battle Royale', color_theme: 'violet', image: 'https://upload.wikimedia.org/wikipedia/en/a/ae/Fortnite_Save_The_World.jpg' },
  { name: 'Apex Legends', genre: 'Battle Royale', color_theme: 'orange', image: 'https://steamcdn-a.akamaihd.net/steam/apps/1172470/library_600x900.jpg' }
];

const mergedGames = staticGames.map(staticGame => {
  const dbGame = dbGames?.find(g => g.name === staticGame.name);
  const realCount = gameCounts[staticGame.name.toLowerCase()] || 0;
  return { 
    ...staticGame, 
    ...dbGame, 
    players_count: realCount, // Número 100% real de la base de datos de perfiles
    image: staticGame.image 
  };
});

// Add any games from DB that are not in staticGames
if (dbGames) {
  dbGames.forEach(dbGame => {
    if (!mergedGames.find(g => g.name === dbGame.name)) {
      const realCount = gameCounts[dbGame.name.toLowerCase()] || 0;
      mergedGames.push({ ...dbGame, players_count: realCount });
    }
  });
}

// Ahora sí ordenamos por el conteo real
const games = mergedGames.sort((a, b) => b.players_count - a.players_count);
const categories = ['Todos', 'FPS', 'MOBA', 'Battle Royale', 'Deportes', 'Sandbox'];
---

<div class="games-view animate-fade-in-up">
  <div class="games-header">
    <div class="header-content">
      <h2>Catálogo de Juegos</h2>
      <p class="subtitle">Encuentra tu próximo juego y compañeros de equipo ideales.</p>
    </div>
    <div class="search-box">
      <input type="text" id="game-search" placeholder="Buscar juego..." class="search-input" />
      <button class="search-btn">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>
    </div>
  </div>

  <div class="categories-wrapper">
    {categories.map((cat, index) => (
      <button class={`category-chip ${index === 0 ? 'active' : ''}`}>{cat}</button>
    ))}
  </div>

  <div class="games-grid">
    {games.map(game => (
      <GameCard
        name={game.name}
        genre={game.genre}
        players={game.players_count}
        color={game.color_theme}
        image={game.image}
      />
    ))}

    <div class="empty-state" id="no-results" style="display: none;">
      <p>No se han encontrado juegos que coincidan con tu búsqueda.</p>
    </div>

    <div class="empty-state" id="initial-empty-state" style={games.length === 0 ? "display: block;" : "display: none;"}>
      <p>No hay juegos disponibles en este momento.</p>
    </div>
  </div>
</div>

<style>
  .games-view {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    width: 100%;
  }

  .games-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .header-content h2 {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: var(--color-text-secondary);
    margin: 0;
  }

  .search-box {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 350px;
  }

  .search-input {
    width: 100%;
    padding: 0.8rem 1rem 0.8rem 2.5rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-primary);
    font-family: inherit;
    transition: all 0.2s ease;
  }

  .search-input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 2px rgba(124, 58, 237, 0.2);
  }

  .search-btn {
    position: absolute;
    left: 0.75rem;
    background: none;
    border: none;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .categories-wrapper {
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
  }

  .category-chip {
    background: var(--color-surface-card);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    padding: 0.5rem 1.25rem;
    border-radius: var(--radius-full);
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .category-chip:hover {
    background: rgba(124, 58, 237, 0.1);
    color: var(--color-text-primary);
  }

  .category-chip.active {
    background: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
  }

  .games-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .games-header {
      flex-direction: column;
      align-items: flex-start;
    }
    
    .search-box {
      max-width: 100%;
    }
  }
  .empty-state {
    grid-column: 1 / -1;
    padding: 3rem;
    text-align: center;
    background: var(--color-surface-card);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
  }
</style>

<script>
  const searchInput = document.getElementById('game-search') as HTMLInputElement;
  const categoryChips = document.querySelectorAll('.category-chip');
  const gameCards = document.querySelectorAll('.game-card');
  const noResults = document.getElementById('no-results');
  const initialEmpty = document.getElementById('initial-empty-state');

  let currentSearch = '';
  let currentCategory = 'todos';

  function filterGames() {
    let visibleCount = 0;

    gameCards.forEach((card) => {
      const name = (card as HTMLElement).dataset.name || '';
      const genre = (card as HTMLElement).dataset.genre || '';
      
      const matchesSearch = name.includes(currentSearch);
      const matchesCategory = currentCategory === 'todos' || genre.includes(currentCategory);

      if (matchesSearch && matchesCategory) {
        (card as HTMLElement).style.display = 'block';
        visibleCount++;
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });

    if (noResults) {
      noResults.style.display = visibleCount === 0 && gameCards.length > 0 ? 'block' : 'none';
    }
    
    if (initialEmpty) {
        initialEmpty.style.display = gameCards.length === 0 ? 'block' : 'none';
    }
  }

  searchInput?.addEventListener('input', (e) => {
    currentSearch = (e.target as HTMLInputElement).value.toLowerCase().trim();
    filterGames();
  });

  categoryChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      // Update UI
      categoryChips.forEach(c => c.classList.remove('active'));
      chip.classList.add('active');

      // Update filter
      currentCategory = chip.textContent?.toLowerCase().trim() || 'todos';
      filterGames();
    });
  });
</script>
