---
/**
 * MatchmakingView.astro
 * Vista para mostrar jugadores que juegan a un juego específico.
 */
import UserCard from '../domain/UserCard.astro';
import { supabase } from '../../lib/supabase';

interface Props {
  game: string;
}

const { game } = Astro.props;

// Obtener perfiles reales de la DB
const { data: dbProfiles } = await supabase.from('profiles').select('*').limit(100);

const allPlayers = (dbProfiles || []).map(profile => ({
  name: profile.name || 'Jugador',
  level: profile.level || 1,
  rank: 'unranked' as any, // Sin rango por defecto, evitando aleatoriedad falsa
  games: profile.favorite_games || [], // Usar los juegos reales, sin inventar
  region: 'EUW',
  online: true // Asumimos online por ahora, sin falsear con random
}));

// Filtrar para que SOLO salgan los jugadores que realmente tengan este juego en favoritos
const filteredPlayers = allPlayers.filter(p => p.games.some((g: string) => {
  let key = g.toLowerCase();
  // Normalizar nombres antiguos o desajustados para que coincidan con el catálogo
  if (key === 'call of duty') key = 'call of duty: warzone';
  if (key === 'ea fc 24') key = 'ea fc 25';
  return key === game.toLowerCase();
}));

const shuffledPlayers = filteredPlayers.sort(() => 0.5 - Math.random());
---

<div class="matchmaking-view animate-fade-in-up">
  <div class="matchmaking-header">
    <div class="header-content">
      <h2>Jugadores de <span class="gradient-text">{game}</span></h2>
      <p class="subtitle">Encuentra a tus compañeros ideales y forma tu escuadrón.</p>
    </div>
    
    <div class="filters">
      <select class="filter-select" id="filter-rank">
        <option value="">Rango: Todos</option>
        <option value="diamond">Diamante</option>
        <option value="platinum">Platino</option>
        <option value="gold">Oro</option>
        <option value="silver">Plata</option>
        <option value="bronze">Bronce</option>
      </select>
      <select class="filter-select" id="filter-region">
        <option value="">Región: Todas</option>
        <option value="EUW">EUW</option>
        <option value="NA">NA</option>
        <option value="LATAM">LATAM</option>
      </select>
    </div>
  </div>

  <div class="players-grid" id="players-grid">
    {shuffledPlayers.map(player => (
      <UserCard
        name={player.name}
        level={player.level}
        rank={player.rank}
        games={player.games}
        region={player.region}
        online={player.online}
      />
    ))}
  </div>

  <div class="no-results-msg" id="no-results-msg" style="display: none;">
    <p>No se encontraron jugadores con esos filtros.</p>
  </div>
</div>

<style>
  .matchmaking-view {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    width: 100%;
  }

  .matchmaking-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border-light);
  }

  .header-content h2 {
    font-family: var(--font-heading);
    font-size: 2.2rem;
    margin-bottom: 0.5rem;
  }

  .gradient-text {
    background: linear-gradient(to right, var(--color-primary), var(--color-accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .subtitle {
    color: var(--color-text-secondary);
    margin: 0;
  }

  .filters {
    display: flex;
    gap: 1rem;
  }

  .filter-select {
    padding: 0.6rem 1rem;
    background: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-primary);
    font-family: inherit;
    font-size: 0.9rem;
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .filter-select:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .players-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 1.5rem;
  }

  .no-results-msg {
    padding: 3rem;
    text-align: center;
    background: var(--color-surface-card);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .matchmaking-header {
      flex-direction: column;
      align-items: flex-start;
    }
    
    .filters {
      width: 100%;
    }

    .filter-select {
      flex: 1;
    }
  }
</style>

<script>
  const rankFilter = document.getElementById('filter-rank') as HTMLSelectElement;
  const regionFilter = document.getElementById('filter-region') as HTMLSelectElement;
  const playerCards = document.querySelectorAll('.js-matchmaking-card');
  const noResultsMsg = document.getElementById('no-results-msg');

  function applyFilters() {
    const selectedRank = rankFilter?.value || '';
    const selectedRegion = regionFilter?.value || '';
    let visibleCount = 0;

    playerCards.forEach(card => {
      const el = card as HTMLElement;
      const cardRank = el.dataset.rank || '';
      const cardRegion = el.dataset.region || '';

      const matchesRank = !selectedRank || cardRank === selectedRank;
      const matchesRegion = !selectedRegion || cardRegion === selectedRegion;

      if (matchesRank && matchesRegion) {
        el.style.display = '';
        visibleCount++;
      } else {
        el.style.display = 'none';
      }
    });

    if (noResultsMsg) {
      noResultsMsg.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  rankFilter?.addEventListener('change', applyFilters);
  regionFilter?.addEventListener('change', applyFilters);
</script>
