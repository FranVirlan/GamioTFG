---
/**
 * MatchmakingView.astro
 * Vista para mostrar jugadores que juegan a un juego específico.
 */
import UserCard from '../domain/UserCard.astro';
import { supabase } from '../../lib/supabase';
import { buildTrackerGgUrl } from '../../lib/gameStats';

interface Props {
  game: string;
}

const { game } = Astro.props;
const currentUser = Astro.locals.user;

// Obtener perfiles reales de la DB con game_accounts
const { data: dbProfiles } = await supabase.from('profiles').select('*').limit(100);

const currentUserProfile = dbProfiles?.find(p => p.id === currentUser?.id);
const hasLinkedCurrentGame = currentUserProfile?.game_accounts?.[game] ? true : false;

// 1. Filtrar perfiles reales de la base de datos
const realPlayers = (dbProfiles || []).map(profile => {
  const linkedAccount = profile.game_accounts?.[game] || profile.game_accounts?.[game.toLowerCase()] || null;
  const favoriteGames: string[] = profile.favorite_games || [];
  
  const playsGame = favoriteGames.some((g: string) => {
    let key = g.toLowerCase();
    if (key === 'call of duty') key = 'call of duty: warzone';
    if (key === 'ea fc 24') key = 'ea fc 25';
    return key === game.toLowerCase();
  }) || linkedAccount != null;

  if (!playsGame) return null;

  return {
    name: profile.name || 'Jugador',
    level: profile.level || 1,
    rank: linkedAccount?.rankTier || 'diamond',
    games: favoriteGames.length > 0 ? favoriteGames : [game],
    region: linkedAccount?.region || profile.region || 'EUW',
    online: true,
    gameStats: linkedAccount
  };
}).filter(Boolean) as any[];

// 2. Generar jugadores de la comunidad para garantizar que ningún juego quede vacío
function getCommunityPlayersForGame(gameName: string) {
  const g = gameName.toLowerCase();
  const iconMap: Record<string, string> = {
    'valorant': 'https://api.iconify.design/simple-icons:valorant.svg?color=%23ff4655',
    'league of legends': 'https://api.iconify.design/simple-icons:leagueoflegends.svg?color=%23c8aa6e',
    'fortnite': 'https://api.iconify.design/simple-icons:fortnite.svg?color=%2300f0ff',
    'rocket league': 'https://api.iconify.design/simple-icons:epicgames.svg?color=%2300f0ff',
    'counter-strike 2': 'https://api.iconify.design/simple-icons:counterstrike.svg?color=%23de9b35',
    'apex legends': 'https://api.iconify.design/simple-icons:ea.svg?color=%23ff0000',
    'call of duty: warzone': 'https://api.iconify.design/simple-icons:activision.svg?color=%23ffffff',
    'ea fc 25': 'https://api.iconify.design/simple-icons:ea.svg?color=%2300f0ff'
  };
  const icon = iconMap[g] || 'https://api.iconify.design/simple-icons:epicgames.svg?color=%2300f0ff';

  const templates = [
    { name: 'AlexPro_99', handle: 'AlexPro_99', level: 88, rank: 'radiant', region: 'EUW', platform: 'Epic Games' },
    { name: 'Viper_Striker', handle: 'Viper_Striker', level: 74, rank: 'master', region: 'EUW', platform: 'Steam' },
    { name: 'Kiko_Gamer', handle: 'Kiko_Gamer', level: 62, rank: 'diamond', region: 'NA', platform: 'PlayStation' },
    { name: 'Luna_Esports', handle: 'Luna_Esports#EUW', level: 55, rank: 'platinum', region: 'EUW', platform: 'Riot Games' },
    { name: 'Shadow_N7', handle: 'Shadow_N7', level: 43, rank: 'gold', region: 'LATAM', platform: 'Xbox Live' },
    { name: 'MasterKey_ES', handle: 'MasterKey_ES', level: 91, rank: 'radiant', region: 'EUW', platform: 'Epic Games' }
  ];

  return templates.map(t => ({
    name: t.name,
    level: t.level,
    rank: t.rank,
    games: [gameName],
    region: t.region,
    online: true,
    gameStats: {
      game: gameName,
      handle: t.handle,
      platform: t.platform,
      region: t.region,
      rankName: 'Tracker.gg',
      rankIcon: icon,
      trackerUrl: buildTrackerGgUrl(gameName, t.handle, t.platform),
      verified: true,
      updatedAt: new Date().toISOString()
    }
  }));
}

const communityPlayers = getCommunityPlayersForGame(game);
const combinedPlayers = [...realPlayers];
if (combinedPlayers.length < 6) {
  communityPlayers.forEach(cp => {
    if (combinedPlayers.length < 6 && !combinedPlayers.some(p => p.name === cp.name)) {
      combinedPlayers.push(cp);
    }
  });
}

const shuffledPlayers = combinedPlayers.sort(() => 0.5 - Math.random());
---

<div class="matchmaking-view animate-fade-in-up">
  {!hasLinkedCurrentGame && (
    <div class="connect-game-banner">
      <div class="banner-content">
        <span class="banner-icon">⚡</span>
        <div>
          <h4>¿Juegas a {game}?</h4>
          <p>Vincula tu cuenta de juego en tu perfil para mostrar tu rango autenticado y estadísticas reales en la búsqueda de jugadores.</p>
        </div>
      </div>
      <a href="/perfil" class="btn-primary btn-sm" style="text-decoration: none; white-space: nowrap;">⚡ Vincular mi cuenta</a>
    </div>
  )}

  <div class="matchmaking-header">
    <div class="header-content">
      <h2>Jugadores de <span class="gradient-text">{game}</span></h2>
      <p class="subtitle">Encuentra a tus compañeros ideales y forma tu escuadrón.</p>
    </div>
    
    <div class="filters">
      <select class="filter-select" id="filter-rank">
        <option value="">Rango: Todos</option>
        <option value="radiant">Radiant / Top</option>
        <option value="master">Master / Élite</option>
        <option value="diamond">Diamante</option>
        <option value="platinum">Platino</option>
        <option value="gold">Oro</option>
        <option value="silver">Plata</option>
        <option value="bronze">Bronce</option>
      </select>
      <select class="filter-select" id="filter-region">
        <option value="">Región: Todas</option>
        <option value="EUW">EUW</option>
        <option value="NA">NA</option>
        <option value="LATAM">LATAM</option>
      </select>
    </div>
  </div>

  <div class="players-grid" id="players-grid">
    {shuffledPlayers.map(player => (
      <UserCard
        name={player.name}
        level={player.level}
        rank={player.rank}
        games={player.games}
        region={player.region}
        online={player.online}
        gameStats={player.gameStats}
      />
    ))}
  </div>

  <div class="no-results-msg" id="no-results-msg" style="display: none;">
    <p>No se encontraron jugadores con esos filtros.</p>
  </div>
</div>

<style>
  .connect-game-banner {
    background: linear-gradient(135deg, rgba(0, 240, 255, 0.12), rgba(124, 58, 237, 0.15));
    border: 1px solid rgba(0, 240, 255, 0.3);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .banner-content {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .banner-icon {
    font-size: 2rem;
    line-height: 1;
  }

  .banner-content h4 {
    margin: 0 0 0.2rem 0;
    font-size: 1.1rem;
    color: var(--color-text-primary);
    font-family: var(--font-heading);
  }

  .banner-content p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--color-text-secondary);
  }

  .matchmaking-view {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    width: 100%;
  }

  .matchmaking-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border-light);
  }

  .header-content h2 {
    font-family: var(--font-heading);
    font-size: 2.2rem;
    margin-bottom: 0.5rem;
  }

  .gradient-text {
    background: linear-gradient(to right, var(--color-primary), var(--color-accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .subtitle {
    color: var(--color-text-secondary);
    margin: 0;
  }

  .filters {
    display: flex;
    gap: 1rem;
  }

  .filter-select {
    padding: 0.6rem 1rem;
    background: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-primary);
    font-family: inherit;
    font-size: 0.9rem;
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .filter-select:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .players-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 1.5rem;
  }

  .no-results-msg {
    padding: 3rem;
    text-align: center;
    background: var(--color-surface-card);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .matchmaking-header {
      flex-direction: column;
      align-items: flex-start;
    }
    
    .filters {
      width: 100%;
    }

    .filter-select {
      flex: 1;
    }
  }
</style>

<script>
  const rankFilter = document.getElementById('filter-rank') as HTMLSelectElement;
  const regionFilter = document.getElementById('filter-region') as HTMLSelectElement;
  const playerCards = document.querySelectorAll('.js-matchmaking-card');
  const noResultsMsg = document.getElementById('no-results-msg');

  function applyFilters() {
    const selectedRank = rankFilter?.value || '';
    const selectedRegion = regionFilter?.value || '';
    let visibleCount = 0;

    playerCards.forEach(card => {
      const el = card as HTMLElement;
      const cardRank = el.dataset.rank || '';
      const cardRegion = el.dataset.region || '';

      const matchesRank = !selectedRank || cardRank === selectedRank;
      const matchesRegion = !selectedRegion || cardRegion === selectedRegion;

      if (matchesRank && matchesRegion) {
        el.style.display = '';
        visibleCount++;
      } else {
        el.style.display = 'none';
      }
    });

    if (noResultsMsg) {
      noResultsMsg.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  rankFilter?.addEventListener('change', applyFilters);
  regionFilter?.addEventListener('change', applyFilters);
</script>
