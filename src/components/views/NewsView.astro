---
/**
 * NewsView.astro
 * Vista de noticias estilo feed con destacados y filtros dinámicos.
 */
import NewsCard from '../domain/NewsCard.astro';
import { supabase } from '../../lib/supabase';

// Datos estáticos (Mock) para asegurar que siempre haya contenido visualmente atractivo
const mockNews = [
  {
    id: 'mock-1',
    title: 'Valorant: Notas del Parche 12.09 y Cambios al Sistema MMR',
    summary: 'Riot Games introduce nerfeos significativos a Neon y ajustes a todas las escopetas para fomentar un juego más táctico.',
    tags: ['Actualizaciones', 'Parches', 'Valorant'],
    created_at: new Date().toISOString(),
    image: '/images/news/valorant_patch.png',
    content: 'El parche 12.09 de Valorant ya está aquí y trae consigo cambios que sacudirán el meta. Neon recibe un nerfeo importante a su habilidad "High Gear", reduciendo su evasión y movilidad. Además, todas las escopetas han sido ajustadas para ser menos efectivas al moverse y saltar. Riot también ha anunciado que el esperado sistema de repeticiones llegará en el próximo parche 12.10, permitiendo revisar partidas directamente desde el perfil de tus amigos.'
  },
  {
    id: 'mock-2',
    title: 'League of Legends: Llega el Parche 26.10 con ajustes masivos',
    summary: 'Lee Sin recibe una actualización completa de su kit, mientras que el Emporio de Esencias Azules regresa temporalmente.',
    tags: ['Actualizaciones', 'League of Legends'],
    created_at: new Date(Date.now() - 86400000).toISOString(), // 1 día antes
    image: '/images/news/lol_patch.png',
    content: 'La temporada 2026 continúa con el Parche 26.10 de League of Legends. El cambio más destacado es la modernización del kit de Lee Sin, que incluye ajustes en sus escudos y enfriamientos para adaptarlo al meta actual. Otros campeones como Ashe, Zed, Zeri y Galio también han recibido balances. Para los coleccionistas, el Emporio de Esencias ha vuelto y estará disponible hasta junio, trayendo consigo el nuevo título exclusivo "Big Serious Gamer".'
  },
  {
    id: 'mock-3',
    title: 'Fortnite: Épica colaboración con Overwatch y Temporada 3',
    summary: 'D.Va, Genji, Tracer y Mercy llegan a la isla junto con armas y emotes temáticos de Overwatch.',
    tags: ['Actualizaciones', 'Fortnite'],
    created_at: new Date(Date.now() - 172800000).toISOString(),
    image: '/images/news/fortnite_collab.png',
    content: 'Una de las colaboraciones más esperadas se ha hecho realidad. A partir del 14 de mayo, los jugadores de Fortnite podrán adquirir las skins de los icónicos héroes de Overwatch: D.Va, Genji, Tracer y Mercy. La actualización también incluye elementos de los mapas de Overwatch y nuevas armas míticas. Mientras tanto, la comunidad se prepara para el final del Capítulo 7 Temporada 2 "Showdown" y el inminente inicio de la Temporada 3 este próximo mes de junio.'
  },
  {
    id: 'mock-4',
    title: 'EDward Gaming se corona campeón del VCT China Stage 1',
    summary: 'EDG derrota a Xi Lai Gaming en una final de infarto y asegura su pase al Masters de Londres.',
    tags: ['Esports', 'Torneos', 'Valorant'],
    created_at: new Date(Date.now() - 259200000).toISOString(),
    image: '/images/news/edg_valorant.png',
    content: 'El panorama competitivo de Valorant en China tiene un nuevo rey indiscutible. EDward Gaming (EDG) ha logrado asegurar la victoria en el VCT China Stage 1 tras derrotar a Xi Lai Gaming (XLG) en una espectacular gran final. Con este triunfo, EDG se posiciona como uno de los grandes favoritos para el próximo Masters de Londres. Riot Games también confirmó que a finales de año compartirán más detalles sobre la reestructuración del circuito VCT para 2027.'
  },
  {
    id: 'mock-5',
    title: 'Guía EA FC 26: Formaciones y tácticas para Ultimate Team',
    summary: 'Domina el modo competitivo con esta guía detallada sobre el nuevo meta y las formaciones tradicionales.',
    tags: ['Guías', 'Estrategia', 'EA FC 26'],
    created_at: new Date(Date.now() - 345600000).toISOString(),
    image: '/images/news/eafc_guide.png',
    content: 'Con la llegada de la nueva temporada en EA FC 26, el meta ha evolucionado significativamente. En esta guía exploramos las formaciones más sólidas para Ultimate Team, haciendo especial énfasis en cómo adaptar tu estilo de juego al dinámico modo 5v5 Rush. Aprenderás a configurar las instrucciones de los jugadores para maximizar la presión alta sin dejar huecos en la defensa, y descubrirás qué perfiles de jugadores rinden mejor en el actual motor gráfico.'
  }
];

// Obtener noticias de la DB (desactivado temporalmente para usar las noticias reales predefinidas)
// const { data: dbNews } = await supabase.from('news').select('*').order('created_at', { ascending: false });

// Usar directamente las noticias reales que hemos configurado
let news = mockNews;

const featuredNews = news[0];
const regularNews = news.slice(1);
---

<div class="news-view animate-fade-in-up">
  <div class="news-header">
    <h2>Últimas Noticias</h2>
    <div class="news-filters">
      <button class="filter-btn active">Todas</button>
      <button class="filter-btn">Actualizaciones</button>
      <button class="filter-btn">Esports</button>
      <button class="filter-btn">Guías</button>
    </div>
  </div>

  <!-- Featured News (Hero) -->
  {featuredNews && (
    <div class="featured-news-wrapper">
      <div class="featured-news" style={featuredNews.image ? `background-image: url('${featuredNews.image}')` : 'background: linear-gradient(135deg, var(--color-primary-dark), var(--color-bg-secondary));'}>
        <div class="featured-overlay"></div>
        <div class="featured-content">
          <div class="featured-tags">
            {featuredNews.tags?.map((tag: string) => (
              <span class="tag tag-accent">{tag}</span>
            ))}
          </div>
          <h3>{featuredNews.title}</h3>
          <p>{featuredNews.summary}</p>
          <div class="featured-actions">
            <button class="btn-primary read-more-btn" 
              data-title={featuredNews.title} 
              data-summary={featuredNews.summary} 
              data-date={new Date(featuredNews.created_at).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })} 
              data-image={featuredNews.image || ''} 
              data-content={featuredNews.content || ''}
              data-tags={(featuredNews.tags || []).join(',')}>
              Leer Noticia Completa
            </button>
            <span class="featured-date">{new Date(featuredNews.created_at).toLocaleDateString('es-ES', { day: 'numeric', month: 'short' })}</span>
          </div>
        </div>
      </div>
    </div>
  )}

  <!-- News Grid -->
  <div class="news-feed">
    {regularNews.length > 0 ? (
      regularNews.map((item: any) => (
        <NewsCard
          title={item.title}
          summary={item.summary}
          tags={item.tags || []}
          date={new Date(item.created_at).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' })}
          image={item.image}
          content={item.content}
        />
      ))
    ) : (
      !featuredNews && (
        <div class="empty-state" id="initial-empty-state">
          <p>No hay noticias recientes en este momento.</p>
        </div>
      )
    )}
    
    <div class="empty-state" id="no-results" style="display: none;">
      <p>No se han encontrado noticias en esta categoría.</p>
    </div>
  </div>

</div>

<style>
  .news-view {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    width: 100%;
  }

  .news-header {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .news-header h2 {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    margin: 0;
  }

  .news-filters {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
  }

  .filter-btn {
    background: var(--color-surface-card);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    padding: 0.5rem 1.25rem;
    border-radius: var(--radius-full);
    font-size: 0.95rem;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .filter-btn:hover {
    background: rgba(124, 58, 237, 0.1);
    color: var(--color-text-primary);
  }

  .filter-btn.active {
    background: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
  }

  /* Featured News */
  .featured-news-wrapper {
    width: 100%;
    margin-bottom: 1rem;
  }

  .featured-news {
    position: relative;
    width: 100%;
    min-height: 400px;
    border-radius: var(--radius-xl);
    background-size: cover;
    background-position: center;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    box-shadow: 0 15px 35px rgba(0,0,0,0.3);
  }

  .featured-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(11, 15, 26, 0.95) 0%, rgba(11, 15, 26, 0.5) 50%, transparent 100%);
  }

  .featured-content {
    position: relative;
    z-index: 2;
    padding: 3rem;
    width: 100%;
    max-width: 800px;
  }

  .featured-tags {
    margin-bottom: 1rem;
    display: flex;
    gap: 0.5rem;
  }

  .tag-accent {
    background: rgba(0, 240, 255, 0.2);
    color: var(--color-primary-light);
    border: 1px solid rgba(0, 240, 255, 0.4);
    font-size: 0.85rem;
    padding: 0.3rem 0.8rem;
  }

  .featured-content h3 {
    font-family: var(--font-heading);
    font-size: 2.2rem;
    color: white;
    margin-bottom: 1rem;
    line-height: 1.2;
    text-wrap: balance;
  }

  .featured-content p {
    color: var(--color-text-secondary);
    font-size: 1.1rem;
    line-height: 1.6;
    margin-bottom: 2rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .featured-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .featured-date {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .news-feed {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .empty-state {
    grid-column: 1 / -1;
    padding: 3rem;
    text-align: center;
    background: var(--color-surface-card);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .featured-content {
      padding: 2rem;
    }
    
    .featured-content h3 {
      font-size: 1.6rem;
    }

    .featured-news {
      min-height: 300px;
    }
  }
</style>

<script>
  // ===== Filtering logic =====
  const filterBtns = document.querySelectorAll('.filter-btn');
  const newsCards = document.querySelectorAll('.news-card');
  const featuredWrapper = document.querySelector('.featured-news-wrapper') as HTMLElement;
  const noResults = document.getElementById('no-results');

  let currentCategory = 'todas';

  function filterNews() {
    let visibleCount = 0;
    newsCards.forEach((card) => {
      const tagsString = (card as HTMLElement).dataset.tags || '';
      const matchesCategory = currentCategory === 'todas' || tagsString.includes(currentCategory);
      if (matchesCategory) {
        (card as HTMLElement).style.display = 'block';
        visibleCount++;
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });
    if (featuredWrapper) {
      if (currentCategory === 'todas') {
        featuredWrapper.style.display = 'block';
        visibleCount++;
      } else {
        featuredWrapper.style.display = 'none';
      }
    }
    if (noResults) {
      noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(c => c.classList.remove('active'));
      btn.classList.add('active');
      currentCategory = btn.textContent?.toLowerCase().trim() || 'todas';
      filterNews();
    });
  });

  // ===== Modal: creado dinámicamente en document.body =====
  // Esto evita el bug de CSS donde position:fixed se rompe
  // dentro de contenedores con transform (animate-fade-in-up).

  // Crear el overlay directamente en el body
  let modalOverlay = document.getElementById('news-modal-dynamic');
  if (!modalOverlay) {
    modalOverlay = document.createElement('div');
    modalOverlay.id = 'news-modal-dynamic';
    document.body.appendChild(modalOverlay);
  }

  // Inyectar estilos globales para el modal (una sola vez)
  if (!document.getElementById('news-modal-styles')) {
    const styleEl = document.createElement('style');
    styleEl.id = 'news-modal-styles';
    styleEl.textContent = `
      #news-modal-dynamic {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.85);
        backdrop-filter: blur(8px);
        z-index: 99999;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
      }
      #news-modal-dynamic.open {
        opacity: 1;
        pointer-events: auto;
      }
      #news-modal-dynamic .nm-box {
        background: #0A0E17;
        border: 1px solid #1E293B;
        border-radius: 20px;
        width: 100%;
        max-width: 800px;
        max-height: 85vh;
        overflow-y: auto;
        position: relative;
        transform: translateY(20px);
        transition: transform 0.3s cubic-bezier(0.4,0,0.2,1);
      }
      #news-modal-dynamic.open .nm-box {
        transform: translateY(0);
      }
      /* Scrollbar visible dentro del modal */
      #news-modal-dynamic .nm-box::-webkit-scrollbar {
        width: 10px;
      }
      #news-modal-dynamic .nm-box::-webkit-scrollbar-track {
        background: #131A28;
        border-radius: 0 20px 20px 0;
      }
      #news-modal-dynamic .nm-box::-webkit-scrollbar-thumb {
        background: #334155;
        border-radius: 10px;
        border: 2px solid #131A28;
      }
      #news-modal-dynamic .nm-box::-webkit-scrollbar-thumb:hover {
        background: #00F0FF;
      }
      #news-modal-dynamic .nm-close {
        position: sticky;
        top: 1rem;
        float: right;
        margin-right: 1rem;
        margin-top: 1rem;
        background: rgba(0,0,0,0.6);
        border: none;
        color: white;
        width: 40px; height: 40px;
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer;
        z-index: 10;
        transition: background 0.2s;
      }
      #news-modal-dynamic .nm-close:hover {
        background: #EF4444;
      }
      #news-modal-dynamic .nm-img {
        width: 100%;
        height: 300px;
        background-size: cover;
        background-position: center;
        background-color: #131A28;
        border-radius: 20px 20px 0 0;
        margin-top: -56px;
      }
      #news-modal-dynamic .nm-body {
        padding: 2.5rem 3rem 3rem;
      }
      #news-modal-dynamic .nm-tags {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1rem;
        flex-wrap: wrap;
      }
      #news-modal-dynamic .nm-tag {
        display: inline-flex;
        align-items: center;
        padding: 0.25rem 0.65rem;
        font-size: 0.72rem;
        font-weight: 600;
        border-radius: 9999px;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        background: rgba(124,58,237,0.15);
        color: #66FBFF;
        border: 1px solid rgba(124,58,237,0.25);
      }
      #news-modal-dynamic .nm-title {
        font-family: 'Space Grotesk','Inter',system-ui,sans-serif;
        font-size: 2.2rem;
        color: #F1F5F9;
        margin: 0 0 1rem 0;
        line-height: 1.2;
      }
      #news-modal-dynamic .nm-date {
        color: #64748B;
        font-size: 0.95rem;
        margin-bottom: 2rem;
        display: block;
      }
      #news-modal-dynamic .nm-summary {
        font-size: 1.2rem;
        color: #F1F5F9;
        line-height: 1.6;
        font-weight: 500;
        margin: 0 0 0 0;
      }
      #news-modal-dynamic .nm-divider {
        height: 1px;
        background: #1E293B;
        margin: 2rem 0;
      }
      #news-modal-dynamic .nm-content {
        color: #94A3B8;
        line-height: 1.8;
        font-size: 1.05rem;
        margin: 0;
      }
      @media (max-width: 768px) {
        #news-modal-dynamic { padding: 1rem; }
        #news-modal-dynamic .nm-body { padding: 1.5rem; }
        #news-modal-dynamic .nm-title { font-size: 1.5rem; }
        #news-modal-dynamic .nm-img { height: 200px; }
      }
    `;
    document.head.appendChild(styleEl);
  }

  // Contenido interno del modal
  modalOverlay.innerHTML = `
    <div class="nm-box">
      <button class="nm-close" aria-label="Cerrar">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <div class="nm-img" id="nm-img"></div>
      <div class="nm-body">
        <div class="nm-tags" id="nm-tags"></div>
        <h2 class="nm-title" id="nm-title"></h2>
        <span class="nm-date" id="nm-date"></span>
        <p class="nm-summary" id="nm-summary"></p>
        <div class="nm-divider"></div>
        <p class="nm-content" id="nm-content"></p>
      </div>
    </div>
  `;

  const nmBox = modalOverlay.querySelector('.nm-box') as HTMLElement;
  const nmClose = modalOverlay.querySelector('.nm-close') as HTMLElement;
  const nmImg = document.getElementById('nm-img') as HTMLElement;
  const nmTags = document.getElementById('nm-tags') as HTMLElement;
  const nmTitle = document.getElementById('nm-title') as HTMLElement;
  const nmDate = document.getElementById('nm-date') as HTMLElement;
  const nmSummary = document.getElementById('nm-summary') as HTMLElement;
  const nmContent = document.getElementById('nm-content') as HTMLElement;

  function openNewsModal(data: any) {
    // Imagen
    if (data.image) {
      nmImg.style.backgroundImage = `url('${data.image}')`;
      nmImg.style.display = 'block';
    } else {
      nmImg.style.display = 'none';
    }

    // Tags
    nmTags.innerHTML = '';
    if (data.tags) {
      const tagList = data.tags.split(',').filter((t: string) => t.trim() !== '');
      tagList.forEach((tag: string) => {
        const span = document.createElement('span');
        span.className = 'nm-tag';
        span.textContent = tag.trim();
        nmTags.appendChild(span);
      });
    }

    // Textos
    nmTitle.textContent = data.title || '';
    nmDate.textContent = data.date || '';
    nmSummary.textContent = data.summary || '';
    nmContent.textContent = data.content || data.summary || '';

    // Scroll del modal al inicio
    nmBox.scrollTop = 0;

    // Abrir
    modalOverlay!.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeNewsModal() {
    modalOverlay!.classList.remove('open');
    document.body.style.overflow = '';
  }

  // Escuchar botones "Leer más"
  const readMoreBtns = document.querySelectorAll('.read-more-btn');
  readMoreBtns.forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const el = e.currentTarget as HTMLElement;
      openNewsModal({
        title: el.dataset.title,
        summary: el.dataset.summary,
        date: el.dataset.date,
        image: el.dataset.image,
        tags: el.dataset.tags,
        content: el.dataset.content
      });
    });
  });

  // Cerrar con X
  nmClose.addEventListener('click', closeNewsModal);

  // Cerrar al hacer clic en el fondo oscuro
  modalOverlay.addEventListener('click', (e) => {
    if (e.target === modalOverlay) closeNewsModal();
  });

  // Cerrar con Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modalOverlay!.classList.contains('open')) {
      closeNewsModal();
    }
  });
</script>

