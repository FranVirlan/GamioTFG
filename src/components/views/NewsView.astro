---
/**
 * NewsView.astro
 * Vista de noticias estilo feed con destacados y noticias generales de la industria en tiempo real.
 */
import NewsCard from '../domain/NewsCard.astro';
import { supabase } from '../../lib/supabase';
import { fetchAndParseNews } from '../../lib/newsParser';

// Consultar el feed de noticias reales en tiempo real (con timeout controlado de 5s)
let news = await fetchAndParseNews(5000);

// Fallback robusto a noticias guardadas localmente en la base de datos si el RSS falla
if (!news || news.length === 0) {
  console.log("RSS de noticias vacío o lento. Cargando noticias de base de datos como fallback...");
  const { data: dbNews } = await supabase
    .from('news')
    .select('*')
    .order('created_at', { ascending: false });

  if (dbNews) {
    news = dbNews.map((item: any) => ({
      title: item.title,
      summary: item.summary,
      tags: item.tags || [],
      created_at: item.created_at,
      image: item.image || '',
      content: item.content || item.summary || '',
      link: '#',
      matchedGames: item.tags || []
    }));
  }
}

// Separar en noticia destacada (Hero) y listado general
const featuredNews = news[0];
const regularNews = news.slice(1);
---

<div class="news-view animate-fade-in-up">
  <div class="news-header">
    <div class="header-title-section">
      <h2>Noticias de la Industria 🎮</h2>
      <p class="subtitle-neon">Últimos acontecimientos, lanzamientos y reportajes del mundo de los videojuegos</p>
    </div>
  </div>

  <!-- Featured News (Hero) -->
  {featuredNews && (
    <div class="featured-news-wrapper">
      <div class="featured-news" style={featuredNews.image ? `background-image: url('${featuredNews.image}')` : 'background: linear-gradient(135deg, var(--color-primary-dark), var(--color-bg-secondary));'}>
        <div class="featured-overlay"></div>
        <div class="featured-content">
          <div class="featured-tags">
            {featuredNews.tags?.slice(0, 3).map((tag: string) => (
              <span class="tag tag-accent">{tag}</span>
            ))}
          </div>
          <h3>{featuredNews.title}</h3>
          <p>{featuredNews.summary}</p>
          <div class="featured-actions">
            <button class="btn-primary read-more-btn" 
              data-title={featuredNews.title} 
              data-summary={featuredNews.summary} 
              data-date={new Date(featuredNews.created_at).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })} 
              data-image={featuredNews.image || ''} 
              data-content={featuredNews.content || ''}
              data-tags={(featuredNews.tags || []).join(',')}
              data-link={featuredNews.link || '#'}>
              Leer Noticia Completa
            </button>
            <span class="featured-date">
              {new Date(featuredNews.created_at).toLocaleDateString('es-ES', { day: 'numeric', month: 'short' })}
            </span>
          </div>
        </div>
      </div>
    </div>
  )}

  <!-- News Grid -->
  <div class="news-feed">
    {regularNews.length > 0 ? (
      regularNews.map((item: any) => (
        <NewsCard
          title={item.title}
          summary={item.summary}
          tags={item.tags || []}
          date={new Date(item.created_at).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' })}
          image={item.image}
          content={item.content}
          link={item.link}
        />
      ))
    ) : (
      !featuredNews && (
        <div class="empty-state">
          <p>No hay noticias recientes en este momento.</p>
        </div>
      )
    )}
  </div>

</div>

<style>
  .news-view {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    width: 100%;
  }

  .news-header {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .header-title-section {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .news-header h2 {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    margin: 0;
    background: linear-gradient(135deg, #fff 30%, var(--color-accent-light, #8ae7ff) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .subtitle-neon {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    margin: 0;
  }

  /* Featured News */
  .featured-news-wrapper {
    width: 100%;
    margin-bottom: 1rem;
  }

  .featured-news {
    position: relative;
    width: 100%;
    min-height: 420px;
    border-radius: var(--radius-xl);
    background-size: cover;
    background-position: center;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    box-shadow: 0 15px 35px rgba(0,0,0,0.4);
    border: 1px solid var(--color-border);
    transition: border-color 0.3s ease;
  }

  .featured-news:hover {
    border-color: rgba(0, 240, 255, 0.4);
  }

  .featured-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(6, 9, 17, 0.98) 0%, rgba(6, 9, 17, 0.6) 50%, transparent 100%);
  }

  .featured-content {
    position: relative;
    z-index: 2;
    padding: 3rem;
    width: 100%;
    max-width: 850px;
  }

  .featured-tags {
    margin-bottom: 1rem;
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag-accent {
    background: rgba(0, 240, 255, 0.15);
    color: var(--color-accent-light, #8ae7ff);
    border: 1px solid rgba(0, 240, 255, 0.3);
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.3rem 0.8rem;
    border-radius: var(--radius-sm, 4px);
    text-transform: uppercase;
  }

  .featured-content h3 {
    font-family: var(--font-heading);
    font-size: 2.4rem;
    color: white;
    margin-bottom: 1.2rem;
    line-height: 1.2;
    text-wrap: balance;
    text-shadow: 0 2px 10px rgba(0,0,0,0.5);
  }

  .featured-content p {
    color: var(--color-text-secondary);
    font-size: 1.15rem;
    line-height: 1.6;
    margin-bottom: 2rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .featured-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .featured-date {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .news-feed {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .empty-state {
    grid-column: 1 / -1;
    padding: 4rem 2rem;
    text-align: center;
    background: var(--color-surface-card);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--color-text-muted);
    font-size: 1.1rem;
  }

  @media (max-width: 768px) {
    .featured-content {
      padding: 2rem;
    }
    
    .featured-content h3 {
      font-size: 1.8rem;
    }

    .featured-news {
      min-height: 320px;
    }
  }
</style>

<script>
  // ===== Modal dinámico insertado directamente en el body =====
  let modalOverlay = document.getElementById('news-modal-dynamic');
  if (!modalOverlay) {
    modalOverlay = document.createElement('div');
    modalOverlay.id = 'news-modal-dynamic';
    document.body.appendChild(modalOverlay);
  }

  // Inyectar estilos premium para el modal (una única vez)
  if (!document.getElementById('news-modal-styles')) {
    const styleEl = document.createElement('style');
    styleEl.id = 'news-modal-styles';
    styleEl.textContent = `
      #news-modal-dynamic {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(4, 6, 12, 0.9);
        backdrop-filter: blur(12px);
        z-index: 99999;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }
      #news-modal-dynamic.open {
        opacity: 1;
        pointer-events: auto;
      }
      #news-modal-dynamic .nm-box {
        background: #0A0E17;
        border: 1px solid #1E293B;
        border-radius: 20px;
        width: 100%;
        max-width: 800px;
        max-height: 85vh;
        overflow-y: auto;
        position: relative;
        transform: translateY(30px);
        transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
        box-shadow: 0 20px 50px rgba(0, 240, 255, 0.1), 0 0 1px 1px rgba(0, 240, 255, 0.15) inset;
      }
      #news-modal-dynamic.open .nm-box {
        transform: translateY(0);
      }
      #news-modal-dynamic .nm-box::-webkit-scrollbar {
        width: 8px;
      }
      #news-modal-dynamic .nm-box::-webkit-scrollbar-track {
        background: #070B13;
        border-radius: 0 20px 20px 0;
      }
      #news-modal-dynamic .nm-box::-webkit-scrollbar-thumb {
        background: #2D3748;
        border-radius: 10px;
      }
      #news-modal-dynamic .nm-box::-webkit-scrollbar-thumb:hover {
        background: #00F0FF;
      }
      #news-modal-dynamic .nm-close {
        position: absolute;
        top: 1.25rem;
        right: 1.25rem;
        background: rgba(0,0,0,0.5);
        border: 1px solid rgba(255,255,255,0.1);
        color: white;
        width: 42px; height: 42px;
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer;
        z-index: 10;
        transition: all 0.2s ease;
      }
      #news-modal-dynamic .nm-close:hover {
        background: #EF4444;
        border-color: #EF4444;
        transform: rotate(90deg);
      }
      #news-modal-dynamic .nm-img {
        width: 100%;
        height: 340px;
        background-size: cover;
        background-position: center;
        background-color: #131A28;
      }
      #news-modal-dynamic .nm-body {
        padding: 2.5rem 3rem;
      }
      #news-modal-dynamic .nm-tags {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1rem;
        flex-wrap: wrap;
      }
      #news-modal-dynamic .nm-tag {
        display: inline-flex;
        align-items: center;
        padding: 0.3rem 0.75rem;
        font-size: 0.75rem;
        font-weight: 700;
        border-radius: 4px;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        background: rgba(0, 240, 255, 0.1);
        color: #8ae7ff;
        border: 1px solid rgba(0, 240, 255, 0.25);
      }
      #news-modal-dynamic .nm-title {
        font-family: 'Space Grotesk','Inter',system-ui,sans-serif;
        font-size: 2.2rem;
        color: #F8FAFC;
        margin: 0 0 1rem 0;
        line-height: 1.25;
        font-weight: 800;
      }
      #news-modal-dynamic .nm-date {
        color: #64748B;
        font-size: 0.95rem;
        margin-bottom: 1.75rem;
        display: block;
        font-weight: 500;
      }
      #news-modal-dynamic .nm-summary {
        font-size: 1.15rem;
        color: #E2E8F0;
        line-height: 1.7;
        font-weight: 500;
        margin: 0;
      }
      #news-modal-dynamic .nm-divider {
        height: 1px;
        background: #1E293B;
        margin: 2rem 0;
      }
      #news-modal-dynamic .nm-content {
        color: #94A3B8;
        line-height: 1.8;
        font-size: 1.05rem;
        margin: 0;
      }
      #news-modal-dynamic .btn-source-neon {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: linear-gradient(135deg, #00F0FF 0%, #7C3AED 100%);
        color: white !important;
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        font-weight: 700;
        text-decoration: none !important;
        font-size: 0.92rem;
        cursor: pointer;
        box-shadow: 0 0 15px rgba(0, 240, 255, 0.35);
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        text-transform: uppercase;
        letter-spacing: 0.03em;
      }
      #news-modal-dynamic .btn-source-neon:hover {
        transform: translateY(-2px);
        box-shadow: 0 0 25px rgba(0, 240, 255, 0.6), 0 0 10px rgba(124, 58, 237, 0.4);
      }
      @media (max-width: 768px) {
        #news-modal-dynamic { padding: 1rem; }
        #news-modal-dynamic .nm-body { padding: 1.75rem 1.5rem; }
        #news-modal-dynamic .nm-title { font-size: 1.6rem; }
        #news-modal-dynamic .nm-img { height: 220px; }
      }
    `;
    document.head.appendChild(styleEl);
  }

  // Contenido interno estructurado del modal
  modalOverlay.innerHTML = `
    <div class="nm-box">
      <button class="nm-close" aria-label="Cerrar">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <div class="nm-img" id="nm-img"></div>
      <div class="nm-body">
        <div class="nm-tags" id="nm-tags"></div>
        <h2 class="nm-title" id="nm-title"></h2>
        <span class="nm-date" id="nm-date"></span>
        <p class="nm-summary" id="nm-summary"></p>
        <div class="nm-divider"></div>
        <p class="nm-content" id="nm-content"></p>
        <div class="nm-actions" style="margin-top: 2.5rem; display: flex; justify-content: flex-end;">
          <a href="#" id="nm-source-btn" target="_blank" rel="noopener noreferrer" class="btn-source-neon">
            Visitar fuente original 🌐
          </a>
        </div>
      </div>
    </div>
  `;

  const nmBox = modalOverlay.querySelector('.nm-box') as HTMLElement;
  const nmClose = modalOverlay.querySelector('.nm-close') as HTMLElement;
  const nmImg = document.getElementById('nm-img') as HTMLElement;
  const nmTags = document.getElementById('nm-tags') as HTMLElement;
  const nmTitle = document.getElementById('nm-title') as HTMLElement;
  const nmDate = document.getElementById('nm-date') as HTMLElement;
  const nmSummary = document.getElementById('nm-summary') as HTMLElement;
  const nmContent = document.getElementById('nm-content') as HTMLElement;
  const nmSourceBtn = document.getElementById('nm-source-btn') as HTMLAnchorElement;

  function openNewsModal(data: any) {
    // Portada
    if (data.image) {
      nmImg.style.backgroundImage = `url('${data.image}')`;
      nmImg.style.display = 'block';
    } else {
      nmImg.style.display = 'none';
    }

    // Categorías / tags
    nmTags.innerHTML = '';
    if (data.tags) {
      const tagList = data.tags.split(',').filter((t: string) => t.trim() !== '');
      tagList.forEach((tag: string) => {
        const span = document.createElement('span');
        span.className = 'nm-tag';
        span.textContent = tag.trim();
        nmTags.appendChild(span);
      });
    }

    // Textos principales
    nmTitle.textContent = data.title || '';
    nmDate.textContent = data.date || '';
    nmSummary.textContent = data.summary || '';
    nmContent.textContent = data.content || data.summary || '';

    // Enlace a fuente original (Eurogamer)
    if (nmSourceBtn) {
      if (data.link && data.link !== '#' && data.link !== '') {
        nmSourceBtn.href = data.link;
        nmSourceBtn.style.display = 'inline-flex';
      } else {
        nmSourceBtn.style.display = 'none';
      }
    }

    nmBox.scrollTop = 0;
    modalOverlay!.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeNewsModal() {
    modalOverlay!.classList.remove('open');
    document.body.style.overflow = '';
  }

  // Delegar clicks en "Leer más" o "Leer Noticia Completa"
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest('.read-more-btn') as HTMLElement;
    
    if (btn) {
      e.preventDefault();
      openNewsModal({
        title: btn.dataset.title,
        summary: btn.dataset.summary,
        date: btn.dataset.date,
        image: btn.dataset.image,
        tags: btn.dataset.tags,
        content: btn.dataset.content,
        link: btn.dataset.link
      });
    }
  });

  // Cerrar modal
  nmClose.addEventListener('click', closeNewsModal);
  modalOverlay.addEventListener('click', (e) => {
    if (e.target === modalOverlay) closeNewsModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modalOverlay!.classList.contains('open')) {
      closeNewsModal();
    }
  });
</script>
