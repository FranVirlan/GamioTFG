---
import { supabase } from '../../lib/supabase';

interface Props {
  conversationId: string;
  otherUser: {
    id: string;
    name: string;
    avatar_url?: string;
  };
}

const { conversationId, otherUser } = Astro.props;
const user = Astro.locals.user;

const { data: messagesData } = await supabase
  .from('private_messages')
  .select('*, profiles(name, avatar_url)')
  .eq('conversation_id', conversationId)
  .order('created_at', { ascending: true })
  .limit(100);

const messages = messagesData || [];
const accessToken = Astro.cookies.get('sb-access-token')?.value || '';
---

<div class="private-chat-container" id="private-chat-root" data-conversation-id={conversationId} data-current-user={user?.id} data-access-token={accessToken}>
  <header class="chat-header">
    <div class="header-user-info">
      <div class="avatar">
        {otherUser.avatar_url ? (
          <img src={otherUser.avatar_url} alt={otherUser.name} />
        ) : (
          <span>{otherUser.name?.charAt(0).toUpperCase()}</span>
        )}
      </div>
      <h2>{otherUser.name}</h2>
    </div>
  </header>

  <div class="messages-container" id="private-messages-container">
    {messages.map((msg) => {
      const isMine = user && msg.profile_id === user.id;
      return (
        <div class={`message ${isMine ? 'message-mine' : 'message-other'}`}>
          {!isMine && (
            <div class="avatar-small">
              {msg.profiles?.avatar_url ? (
                <img src={msg.profiles.avatar_url} alt="avatar" />
              ) : (
                <span>{msg.profiles?.name?.charAt(0).toUpperCase() || '?'}</span>
              )}
            </div>
          )}
          <div class="message-content">
            <div class="message-bubble">
              {msg.content}
            </div>
            <div class="message-time">
              {new Date(msg.created_at).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' })}
            </div>
          </div>
        </div>
      );
    })}
  </div>

  <div class="chat-input-area">
    <form id="private-chat-form" class="chat-form">
      <input 
        type="text" 
        id="private-chat-input" 
        class="chat-input" 
        placeholder={`Escribir a ${otherUser.name}...`}
        autocomplete="off" 
        required 
      />
      <button type="submit" class="send-btn" title="Enviar">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">
          <line x1="22" y1="2" x2="11" y2="13" />
          <polygon points="22 2 15 22 11 13 2 9 22 2" />
        </svg>
      </button>
    </form>
  </div>
</div>

<style is:global>
  .private-chat-container {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .chat-header {
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--color-border);
    display: flex;
    align-items: center;
  }

  .header-user-info {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: bold;
    overflow: hidden;
  }

  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .header-user-info h2 {
    margin: 0;
    font-size: 1.2rem;
  }

  .messages-container {
    flex: 1;
    padding: 1.5rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .messages-container::-webkit-scrollbar { width: 6px; }
  .messages-container::-webkit-scrollbar-thumb { background: var(--color-border); border-radius: 10px; }

  .message {
    display: flex;
    align-items: flex-end;
    gap: 0.75rem;
    max-width: 75%;
  }

  .message-other { align-self: flex-start; }
  .message-mine { align-self: flex-end; flex-direction: row-reverse; }

  .avatar-small {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: bold;
    font-size: 0.85rem;
    flex-shrink: 0;
    overflow: hidden;
  }

  .avatar-small img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .message-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .message-bubble {
    padding: 0.75rem 1rem;
    border-radius: 18px;
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--color-text-primary);
  }

  .message-other .message-bubble {
    background: rgba(43, 53, 76, 0.6);
    border-bottom-left-radius: 4px;
  }

  .message-mine .message-bubble {
    background: var(--color-secondary);
    color: white;
    border-bottom-right-radius: 4px;
  }

  .message-time {
    font-size: 0.65rem;
    color: var(--color-text-muted);
    margin-top: 2px;
  }
  .message-mine .message-time { text-align: right; }

  .chat-input-area {
    padding: 1rem 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .chat-form {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: rgba(11, 15, 26, 0.6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: 0.5rem 0.75rem;
  }

  .chat-input {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--color-text-primary);
    font-size: 0.95rem;
    outline: none;
    min-width: 0;
  }

  .send-btn {
    background: var(--color-primary);
    color: white;
    border: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
  }
</style>

<script>
  import { supabase } from '../../lib/supabase';

  const root = document.getElementById('private-chat-root');
  const container = document.getElementById('private-messages-container');
  const form = document.getElementById('private-chat-form') as HTMLFormElement;
  const input = document.getElementById('private-chat-input') as HTMLInputElement;

  if (root && container && form && input) {
    const conversationId = root.dataset.conversationId;
    const currentUserId = root.dataset.currentUser;
    const accessToken = root.dataset.accessToken;

    if (accessToken) {
      supabase.realtime.setAuth(accessToken);
    }

    const scrollToBottom = () => {
      container.scrollTop = container.scrollHeight;
    };
    scrollToBottom();

    // Enviar mensaje
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const content = input.value.trim();
      if (!content || !conversationId) return;

      // Optimistic UI: Mostrar el mensaje inmediatamente
      const time = new Date().toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });
      const div = document.createElement('div');
      div.className = 'message message-mine';
      div.innerHTML = `<div class="message-content">
        <div class="message-bubble">${content}</div>
        <div class="message-time">${time}</div>
      </div>`;
      container.appendChild(div);
      scrollToBottom();

      input.value = '';
      input.focus();

      try {
        const res = await fetch('/api/private-messages', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ conversation_id: conversationId, content })
        });
        
        if (!res.ok) {
          const errorData = await res.json();
          console.error('Error API:', errorData);
          alert('Error al guardar mensaje: ' + (errorData.error || 'Desconocido'));
        }
      } catch (err) {
        console.error('Error enviando mensaje privado:', err);
        alert('Error de red al enviar mensaje');
      }
    });

    // Escuchar tiempo real
    const channel = supabase.channel(`private_msgs_${conversationId}`);
    
    channel
      .on(
        'postgres_changes',
        { 
          event: 'INSERT', 
          schema: 'public', 
          table: 'private_messages',
          filter: `conversation_id=eq.${conversationId}` 
        },
        async (payload) => {
          const msg = payload.new;
          const isMine = msg.profile_id === currentUserId;
          
          // Ignorar mis propios mensajes porque ya se han pintado instantáneamente (Optimistic UI)
          if (isMine) return;

          const { data: profile } = await supabase
            .from('profiles')
            .select('name, avatar_url')
            .eq('id', msg.profile_id)
            .single();

          const time = new Date(msg.created_at).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });

          const div = document.createElement('div');
          div.className = `message ${isMine ? 'message-mine' : 'message-other'}`;

          let html = '';
          if (!isMine) {
            const avatar = profile?.avatar_url 
              ? `<img src="${profile.avatar_url}" />` 
              : `<span>${profile?.name?.charAt(0).toUpperCase() || '?'}</span>`;
            html += `<div class="avatar-small">${avatar}</div>`;
          }

          html += `<div class="message-content">
            <div class="message-bubble">${msg.content}</div>
            <div class="message-time">${time}</div>
          </div>`;

          div.innerHTML = html;
          container.appendChild(div);
          scrollToBottom();
        }
      )
      .subscribe();

      document.addEventListener('astro:before-swap', () => {
        supabase.removeChannel(channel);
      });
  }
</script>
