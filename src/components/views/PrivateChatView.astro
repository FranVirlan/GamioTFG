---
import { supabase } from '../../lib/supabase';

interface Props {
  conversationId: string;
  otherUser: {
    id: string;
    name: string;
    avatar_url?: string;
  };
}

const { conversationId, otherUser } = Astro.props;
const user = Astro.locals.user;

const { data: messagesData } = await supabase
  .from('private_messages')
  .select('*, profiles(name, avatar_url)')
  .eq('conversation_id', conversationId)
  .order('created_at', { ascending: true })
  .limit(100);

const messages = messagesData || [];
const accessToken = Astro.cookies.get('sb-access-token')?.value || '';
---

<div class="private-chat-container" id="private-chat-root" data-conversation-id={conversationId} data-current-user={user?.id} data-access-token={accessToken} data-other-user-name={otherUser.name} data-other-user-avatar={otherUser.avatar_url || ''}>
  <header class="chat-header">
    <a href="/mensajes" class="back-button" title="Volver a la lista de mensajes">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
    </a>
    <div class="header-user-info">
      <div class="avatar">
        {otherUser.avatar_url ? (
          <img src={otherUser.avatar_url} alt={otherUser.name} />
        ) : (
          <span>{otherUser.name?.charAt(0).toUpperCase()}</span>
        )}
      </div>
      <h2>{otherUser.name}</h2>
    </div>
  </header>

  <div class="messages-container" id="private-messages-container">
    {messages.map((msg) => {
      const isMine = user && msg.profile_id === user.id;
      return (
        <div class={`message ${isMine ? 'message-mine' : 'message-other'}`}>
          {!isMine && (
            <div class="avatar-small">
              {msg.profiles?.avatar_url ? (
                <img src={msg.profiles.avatar_url} alt="avatar" />
              ) : (
                <span>{msg.profiles?.name?.charAt(0).toUpperCase() || '?'}</span>
              )}
            </div>
          )}
          <div class="message-content">
            {!isMine && (
              <div class="message-header-row" style="display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; margin-bottom: 2px;">
                <button class="chat-report-btn" data-reported-id={msg.profile_id} data-reported-name={msg.profiles?.name} data-message-content={msg.content} data-room="chat_privado" title="Reportar mensaje" style="background: transparent; border: none; color: var(--color-text-muted); cursor: pointer; padding: 2px 4px; border-radius: 4px; display: flex; align-items: center; gap: 2px; font-size: 0.72rem; transition: all 0.2s;">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/>
                  </svg>
                  Reportar
                </button>
              </div>
            )}
            <div class="message-bubble">
              {msg.content}
            </div>
            <div class="message-time">
              {new Date(msg.created_at).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' })}
            </div>
          </div>
        </div>
      );
    })}
  </div>

  <div class="chat-input-area">
    <form id="private-chat-form" class="chat-form">
      <input 
        type="text" 
        id="private-chat-input" 
        class="chat-input" 
        placeholder={`Escribir a ${otherUser.name}...`}
        autocomplete="off" 
        required 
      />
      <button type="submit" class="send-btn" title="Enviar">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">
          <line x1="22" y1="2" x2="11" y2="13" />
          <polygon points="22 2 15 22 11 13 2 9 22 2" />
        </svg>
      </button>
    </form>
  </div>
</div>

<!-- ══════════ MODAL: Reportar Mensaje Privado ══════════ -->
{user && (
<div id="chat-report-modal" class="pv-modal-overlay pv-hidden">
  <div class="pv-modal-content animate-fade-in-up">
    <div class="pv-modal-header">
      <h3 style="color: #f87171; display: flex; align-items: center; gap: 0.5rem; font-family: var(--font-heading);">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/>
        </svg>
        Reportar Mensaje Privado
      </h3>
      <button class="pv-close-btn" data-close="chat-report-modal">&times;</button>
    </div>
    <form id="chat-report-form" class="pv-form">
      <input type="hidden" id="chat-report-target-id" value="" />
      <input type="hidden" id="chat-report-room" value="" />
      
      <div class="pv-form-group">
        <label>Jugador denunciado</label>
        <input type="text" id="chat-report-target-name" value="" disabled />
      </div>

      <div class="pv-form-group">
        <label for="chat-report-reason">Motivo de la denuncia</label>
        <select id="chat-report-reason" required>
          <option value="chat_abuse" selected>Abuso o acoso en chat (insultos, toxicidad)</option>
          <option value="gameplay_abuse">Mala conducta al jugar (trampas, abandono)</option>
          <option value="spam">Spam / Publicidad molesta</option>
          <option value="other">Otro motivo</option>
        </select>
      </div>

      <div class="pv-form-group">
        <label for="chat-report-details">Mensaje reportado y detalles</label>
        <textarea id="chat-report-details" rows="4" placeholder="Describe brevemente lo ocurrido..." required></textarea>
      </div>

      <div class="pv-modal-footer">
        <button type="button" class="btn-secondary" data-close="chat-report-modal">Cancelar</button>
        <button type="submit" class="btn-primary btn-modal-submit-danger" id="chat-submit-report-btn">Enviar Denuncia 🚩</button>
      </div>
    </form>
  </div>
</div>
)}

<style is:global>
  .private-chat-container {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .chat-header {
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--color-border);
    display: flex;
    align-items: center;
  }

  .header-user-info {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: bold;
    overflow: hidden;
  }

  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .header-user-info h2 {
    margin: 0;
    font-size: 1.2rem;
  }

  .messages-container {
    flex: 1;
    padding: 1.5rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .messages-container::-webkit-scrollbar { width: 6px; }
  .messages-container::-webkit-scrollbar-thumb { background: var(--color-border); border-radius: 10px; }

  .message {
    display: flex;
    align-items: flex-end;
    gap: 0.75rem;
    max-width: 75%;
  }

  .message-other { align-self: flex-start; }
  .message-mine { align-self: flex-end; flex-direction: row-reverse; }

  .avatar-small {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: bold;
    font-size: 0.85rem;
    flex-shrink: 0;
    overflow: hidden;
  }

  .avatar-small img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .message-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .message-bubble {
    padding: 0.75rem 1rem;
    border-radius: 18px;
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--color-text-primary);
  }

  .message-other .message-bubble {
    background: rgba(43, 53, 76, 0.6);
    border-bottom-left-radius: 4px;
  }

  .message-mine .message-bubble {
    background: var(--color-secondary);
    color: white;
    border-bottom-right-radius: 4px;
  }

  .message-time {
    font-size: 0.65rem;
    color: var(--color-text-muted);
    margin-top: 2px;
  }
  .message-mine .message-time { text-align: right; }

  .chat-input-area {
    padding: 1rem 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .chat-form {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: rgba(11, 15, 26, 0.6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: 0.5rem 0.75rem;
  }

  .chat-input {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--color-text-primary);
    font-size: 0.95rem;
    outline: none;
    min-width: 0;
  }

  .send-btn {
    background: var(--color-primary);
    color: white;
    border: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
  }

  .back-button {
    display: none; /* Oculto por defecto en escritorio */
    align-items: center;
    justify-content: center;
    color: var(--color-text-secondary);
    margin-right: 0.75rem;
    transition: all 0.2s ease;
    background: transparent;
    border: none;
    cursor: pointer;
    width: 32px;
    height: 32px;
    border-radius: 50%;
  }

  .back-button:hover {
    color: var(--color-primary);
    background: rgba(255, 255, 255, 0.05);
  }

  @media (max-width: 768px) {
    .back-button {
      display: inline-flex; /* Visible únicamente en móvil */
    }
    
    .chat-header {
      padding: 0.75rem 1rem;
    }
    
    .messages-container {
      padding: 1rem;
      gap: 1rem;
    }
    
    .message {
      max-width: 85%;
    }
    
    .chat-input-area {
      padding: 0.75rem 1rem;
    }
  }
</style>

<script>
  import { supabase } from '../../lib/supabase';

  const root = document.getElementById('private-chat-root');
  const container = document.getElementById('private-messages-container');
  const form = document.getElementById('private-chat-form') as HTMLFormElement;
  const input = document.getElementById('private-chat-input') as HTMLInputElement;

  if (root && container && form && input) {
    const conversationId = root.dataset.conversationId;
    const currentUserId = root.dataset.currentUser;
    const accessToken = root.dataset.accessToken;

    if (accessToken) {
      supabase.realtime.setAuth(accessToken);
    }

    const scrollToBottom = () => {
      container.scrollTop = container.scrollHeight;
    };
    scrollToBottom();

    // Marcar mensajes como leídos al abrir la conversación
    if (conversationId) {
      fetch('/api/mark-read', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ conversation_id: conversationId })
      }).catch(() => {});
    }

    // Enviar mensaje
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const content = input.value.trim();
      if (!content || !conversationId) return;

      // Optimistic UI: Mostrar el mensaje inmediatamente
      const time = new Date().toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });
      const div = document.createElement('div');
      div.className = 'message message-mine';
      div.innerHTML = `<div class="message-content">
        <div class="message-bubble">${content}</div>
        <div class="message-time">${time}</div>
      </div>`;
      container.appendChild(div);
      scrollToBottom();

      input.value = '';
      input.focus();

      try {
        const res = await fetch('/api/private-messages', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ conversation_id: conversationId, content })
        });
        
        if (!res.ok) {
          const errorData = await res.json();
          console.error('Error API:', errorData);
          alert('Error al guardar mensaje: ' + (errorData.error || 'Desconocido'));
        }
      } catch (err) {
        console.error('Error enviando mensaje privado:', err);
        alert('Error de red al enviar mensaje');
      }
    });

    const otherUserName = root.dataset.otherUserName || 'Usuario';
    const otherUserAvatar = root.dataset.otherUserAvatar || '';

    // Escuchar tiempo real
    const channel = supabase.channel(`private_msgs_${conversationId}`);
    
    channel
      .on(
        'postgres_changes',
        { 
          event: 'INSERT', 
          schema: 'public', 
          table: 'private_messages',
          filter: `conversation_id=eq.${conversationId}` 
        },
        (payload) => {
          const msg = payload.new;
          const isMine = msg.profile_id === currentUserId;
          
          // Ignorar mis propios mensajes porque ya se han pintado instantáneamente (Optimistic UI)
          if (isMine) return;

          const time = new Date(msg.created_at).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });

          const div = document.createElement('div');
          div.className = `message message-other`;

          const avatar = otherUserAvatar 
            ? `<img src="${otherUserAvatar}" />` 
            : `<span>${otherUserName.charAt(0).toUpperCase()}</span>`;
          
          let html = `<div class="avatar-small">${avatar}</div>`;
          html += `<div class="message-content">`;
          html += `
            <div class="message-header-row" style="display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; margin-bottom: 2px;">
              <button class="chat-report-btn" data-reported-id="${msg.profile_id}" data-reported-name="${otherUserName}" data-message-content="${msg.content}" data-room="chat_privado" title="Reportar mensaje" style="background: transparent; border: none; color: var(--color-text-muted); cursor: pointer; padding: 2px 4px; border-radius: 4px; display: flex; align-items: center; gap: 2px; font-size: 0.72rem; transition: all 0.2s;">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/>
                </svg>
                Reportar
              </button>
            </div>
          `;
          html += `
            <div class="message-bubble">${msg.content}</div>
            <div class="message-time">${time}</div>
          </div>`;

          div.innerHTML = html;
          container.appendChild(div);
          scrollToBottom();
        }
      )
      .subscribe();

      // ── Delegación de Eventos para Reporte desde Chat Privado ──
      const onPrivateChatClick = (e: MouseEvent) => {
        const target = e.target as HTMLElement;
        const btn = target.closest('.chat-report-btn') as HTMLButtonElement | null;
        if (btn) {
          const reportedId = btn.dataset.reportedId;
          const reportedName = btn.dataset.reportedName;
          const messageContent = btn.dataset.messageContent;
          const room = btn.dataset.room;

          if (reportedId && reportedName) {
            const modal = document.getElementById('chat-report-modal');
            const inputId = document.getElementById('chat-report-target-id') as HTMLInputElement;
            const inputName = document.getElementById('chat-report-target-name') as HTMLInputElement;
            const inputRoom = document.getElementById('chat-report-room') as HTMLInputElement;
            const textDetails = document.getElementById('chat-report-details') as HTMLTextAreaElement;

            if (modal && inputId && inputName && inputRoom && textDetails) {
              inputId.value = reportedId;
              inputName.value = reportedName;
              inputRoom.value = room || 'chat_privado';
              textDetails.value = `Mala conducta en chat: "${messageContent}"`;
              
              modal.classList.remove('pv-hidden');
            }
          }
          return;
        }

        // Cerrar modal
        const closeBtn = target.closest('[data-close="chat-report-modal"]');
        if (closeBtn || target === document.getElementById('chat-report-modal')) {
          document.getElementById('chat-report-modal')?.classList.add('pv-hidden');
        }
      };

      document.removeEventListener('click', onPrivateChatClick);
      document.addEventListener('click', onPrivateChatClick);

      // Enviar reporte del chat privado
      const chatReportForm = document.getElementById('chat-report-form') as HTMLFormElement | null;
      if (chatReportForm) {
        chatReportForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          const submitBtn = document.getElementById('chat-submit-report-btn') as HTMLButtonElement;
          const originalText = submitBtn.textContent;
          submitBtn.disabled = true;
          submitBtn.textContent = 'Enviando...';

          const reported_id = (document.getElementById('chat-report-target-id') as HTMLInputElement).value;
          const reason = (document.getElementById('chat-report-reason') as HTMLSelectElement).value;
          const details = (document.getElementById('chat-report-details') as HTMLTextAreaElement).value;
          const chat_room = (document.getElementById('chat-report-room') as HTMLInputElement).value;

          try {
            const res = await fetch('/api/reports', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ reported_id, reason, details, chat_room })
            });

            if (res.ok) {
              alert('¡Reporte enviado con éxito! Los moderadores revisarán la conducta en este chat.');
              document.getElementById('chat-report-modal')?.classList.add('pv-hidden');
              chatReportForm.reset();
            } else {
              const data = await res.json();
              alert('Error: ' + (data.error || 'No se pudo enviar el reporte.'));
              submitBtn.disabled = false;
              submitBtn.textContent = originalText;
            }
          } catch (err) {
            alert('Error conectando con el servidor.');
            submitBtn.disabled = false;
            submitBtn.textContent = originalText;
          }
        });
      }

      document.addEventListener('astro:before-swap', () => {
        supabase.removeChannel(channel);
      });
  }
</script>
