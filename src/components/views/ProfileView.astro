---
/**
 * ProfileView.astro
 * Vista del perfil de usuario con avatar, información y estadísticas.
 */
interface Props {
  isOwnProfile?: boolean;
  friendStatus?: string;
  friendRequestId?: string | null;
  friendsList?: any[];
  user?: {
    id?: string;
    name: string;
    avatarUrl?: string;
    level: number;
    xp?: number;
    points?: number;
    selectedTitle?: string;
    selectedBorder?: string;
    followers: number;
    gamesPlayed: number;
    description: string;
    favoriteGames?: string[];
    playStyle?: string;
    playerTypeSought?: string;
  };
}

const { 
  isOwnProfile = true,
  friendStatus = 'none',
  friendRequestId = null,
  friendsList = [],
  user
} = Astro.props;

const popularGames = [
  "League of Legends", "Valorant", "Counter-Strike 2",
  "Dead By Daylight", "Fortnite", "Apex Legends",
  "Overwatch 2", "Call of Duty: Warzone", "Rocket League", "EA FC 25"
];
---

<div class="profile-view animate-fade-in-up">
  <!-- Cabecera de perfil -->
  <div class="profile-header">
    <div class="profile-banner"></div>
    <div class="profile-info-container">
      <div class={`profile-avatar ${user.selectedBorder || ''}`}>
        {user.avatarUrl ? (
          <img src={user.avatarUrl} alt={user.name} />
        ) : (
          <span>{user.name.charAt(0).toUpperCase()}</span>
        )}
      </div>
      <div class="profile-basic-info">
        <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
          <h2 class="profile-name" style="margin: 0; font-family: var(--font-heading); font-size: 1.8rem;">{user.name}</h2>
          {user.selectedTitle && (
            <span class="profile-title-badge">{user.selectedTitle}</span>
          )}
        </div>
        <p class="profile-description" style="margin-top: 0.5rem; color: var(--color-text-secondary); font-size: 0.95rem; line-height: 1.5;">{user.description}</p>
      </div>
      <div class="profile-actions">
        {isOwnProfile ? (
          <>
            <button class="btn-primary" id="edit-profile-btn">Editar Perfil</button>
            <button class="btn-secondary" id="settings-btn">Ajustes</button>
          </>
        ) : (
          <>
            {friendStatus === 'accepted' && <button class="btn-primary" disabled style="background: rgba(34, 197, 94, 0.2); color: #4ADE80; border-color: rgba(34, 197, 94, 0.4);">✓ Amigos</button>}
            {friendStatus === 'pending_sent' && <button class="btn-primary" disabled style="background: rgba(124, 58, 237, 0.2); color: #C4B5FD; border-color: rgba(124, 58, 237, 0.4);">Solicitud Pendiente</button>}
            {friendStatus === 'pending_received' && <button class="btn-primary btn-accept-friend-req" data-request-id={friendRequestId}>Aceptar Solicitud</button>}
            {friendStatus === 'none' && <button class="btn-primary btn-add-friend" data-target-id={user.id}>Añadir Amigo</button>}
            
            <button class="btn-secondary message-btn" data-target-id={user.id}>Mensaje</button>
            <button class="btn-danger report-profile-btn" data-target-id={user.id} style="padding: 0.6rem 1.2rem; display: flex; align-items: center; gap: 0.5rem; background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171; border-radius: var(--radius-sm); font-weight: 600; cursor: pointer; transition: all 0.2s;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/>
              </svg>
              Reportar
            </button>
          </>
        )}
      </div>
    </div>
  </div>

  <!-- Estadísticas -->
  <div class="profile-stats">
    <div class="stat-card" style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.5rem; min-height: 120px;">
      <span class="stat-value text-primary">Nv. {user.level}</span>
      <span class="stat-label">Nivel Actual</span>
      {typeof user.xp !== 'undefined' && (
        <div style="width: 100%; margin-top: 0.5rem;">
          <div style="display: flex; justify-content: space-between; font-size: 0.7rem; color: var(--color-text-muted); margin-bottom: 0.25rem;">
            <span>XP: {user.xp % 100}/100</span>
            <span>Tot: {user.xp} XP</span>
          </div>
          <div class="xp-progress-container">
            <div class="xp-progress-bar" style={`width: ${user.xp % 100}%`}></div>
          </div>
        </div>
      )}
    </div>
    <div class="stat-card" style="display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 120px;">
      <span class="stat-value" style="color: #FFB800;">✨ {user.points || 0}</span>
      <span class="stat-label">Puntos Gamio</span>
    </div>
    <div class="stat-card" style="display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 120px;">
      <span class="stat-value text-accent">{user.gamesPlayed}</span>
      <span class="stat-label">Partidas Jugadas</span>
    </div>
    <div class="stat-card clickable-stat" id="friends-stat-card" style="display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 120px;">
      <span class="stat-value text-secondary">{user.followers}</span>
      <span class="stat-label">Amigos</span>
    </div>
  </div>

  <!-- Preferencias de Jugador -->
  {(user.playStyle || user.playerTypeSought || (user.favoriteGames && user.favoriteGames.length > 0)) && (
    <div class="profile-preferences">
      <h3>Preferencias de Jugador</h3>
      <div class="preferences-grid">
        {user.favoriteGames && user.favoriteGames.length > 0 && (
          <div class="preference-card">
            <h4>🎮 Juegos Favoritos</h4>
            <div class="tags-container">
              {user.favoriteGames.map((game: string) => (
                <span class="tag game-tag">{game}</span>
              ))}
            </div>
          </div>
        )}
        {(user.playStyle || user.playerTypeSought) && (
          <div class="preference-card">
            <h4>⚔️ Estilo y Búsqueda</h4>
            <div class="tags-container">
              {user.playStyle && (
                <span class="tag style-tag">Estilo: {user.playStyle}</span>
              )}
              {user.playerTypeSought && (
                <span class="tag sought-tag">Busca: {user.playerTypeSought}</span>
              )}
            </div>
          </div>
        )}
      </div>
    </div>
  )}

  <!-- Juegos Recientes -->
  <div class="profile-recent">
    <h3>Juegos Recientes</h3>
    <div class="empty-state">
      <p>Aún no hay juegos recientes para mostrar.</p>
    </div>
  </div>
</div>

<!-- ══════════ MODAL: Editar Perfil ══════════ -->
{isOwnProfile && (
<div id="edit-profile-modal" class="pv-modal-overlay pv-hidden">
  <div class="pv-modal-content animate-fade-in-up">
    <div class="pv-modal-header">
      <h3>✏️ Editar Perfil</h3>
      <button class="pv-close-btn" data-close="edit-profile-modal">&times;</button>
    </div>
    <form id="edit-profile-form" class="pv-form">
      <div class="pv-form-group">
        <label for="edit-name">Nombre de usuario</label>
        <input type="text" id="edit-name" value={user.name} required />
      </div>
      <div class="pv-form-group">
        <label for="edit-description">Descripción</label>
        <textarea id="edit-description" rows="3">{user.description}</textarea>
      </div>

      <div class="pv-form-group">
        <label>Juegos Favoritos (Puedes elegir varios)</label>
        <div class="pv-games-grid">
          {popularGames.map(game => (
            <label class="pv-game-checkbox">
              <input type="checkbox" name="edit-games" value={game}
                checked={user.favoriteGames?.includes(game)} />
              <span class="pv-game-pill">{game}</span>
            </label>
          ))}
        </div>
      </div>

      <div class="pv-form-group">
        <label>Estilo de juego</label>
        <div class="pv-radio-group">
          {["Casual", "Competitivo", "Tryhard", "Depende del día"].map(style => (
            <label class="pv-radio-option">
              <input type="radio" name="edit-play-style" value={style}
                checked={user.playStyle === style} />
              <span class="pv-radio-pill">{style}</span>
            </label>
          ))}
        </div>
      </div>

      <div class="pv-form-group">
        <label>Tipo de jugadores que buscas</label>
        <div class="pv-radio-group">
          {["Social", "Ranked", "Mixto"].map(type => (
            <label class="pv-radio-option">
              <input type="radio" name="edit-player-type" value={type}
                checked={user.playerTypeSought === type} />
              <span class="pv-radio-pill">{type}</span>
            </label>
          ))}
        </div>
      </div>

      <div class="pv-modal-footer">
        <button type="button" class="btn-secondary" data-close="edit-profile-modal">Cancelar</button>
        <button type="submit" class="btn-primary" id="save-profile-btn">Guardar Cambios</button>
      </div>
    </form>
  </div>
</div>
)}

<!-- ══════════ MODAL: Ajustes ══════════ -->
{isOwnProfile && (
<div id="settings-modal" class="pv-modal-overlay pv-hidden">
  <div class="pv-modal-content animate-fade-in-up">
    <div class="pv-modal-header">
      <h3>⚙️ Ajustes</h3>
      <button class="pv-close-btn" data-close="settings-modal">&times;</button>
    </div>
    <div class="pv-form">
      <!-- Cambiar contraseña -->
      <div class="pv-settings-section">
        <h4>🔒 Cambiar Contraseña</h4>
        <div class="pv-form-group">
          <label for="new-password">Nueva contraseña</label>
          <input type="password" id="new-password" placeholder="Mínimo 6 caracteres" minlength="6" />
        </div>
        <div class="pv-form-group">
          <label for="confirm-password">Confirmar contraseña</label>
          <input type="password" id="confirm-password" placeholder="Repite la contraseña" minlength="6" />
        </div>
        <button class="btn-primary btn-block" id="change-password-btn">Actualizar Contraseña</button>
      </div>

      <div class="pv-divider"></div>

      <!-- Zona peligrosa -->
      <div class="pv-settings-section pv-danger-zone">
        <h4>⚠️ Zona de Peligro</h4>
        <p class="pv-danger-text">Estas acciones no se pueden deshacer.</p>
        <a href="/api/auth/signout" class="btn-danger btn-block" id="logout-btn">Cerrar Sesión</a>
      </div>
    </div>
  </div>
</div>
)}

<!-- ══════════ MODAL: Reportar Jugador ══════════ -->
{!isOwnProfile && (
<div id="report-user-modal" class="pv-modal-overlay pv-hidden">
  <div class="pv-modal-content animate-fade-in-up">
    <div class="pv-modal-header">
      <h3 style="color: #f87171; display: flex; align-items: center; gap: 0.5rem;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/>
        </svg>
        Reportar a {user.name}
      </h3>
      <button class="pv-close-btn" data-close="report-user-modal">&times;</button>
    </div>
    <form id="report-user-form" class="pv-form">
      <input type="hidden" id="report-target-id" value={user.id} />
      
      <div class="pv-form-group">
        <label for="report-reason">Motivo de la denuncia</label>
        <select id="report-reason" style="width: 100%; padding: 0.75rem 1rem; font-size: 0.95rem; font-family: var(--font-sans); color: var(--color-text-primary); background: rgba(11,15,26,0.6); border: 1px solid var(--color-border); border-radius: var(--radius-sm); outline: none; cursor: pointer;" required>
          <option value="" disabled selected>Selecciona un motivo...</option>
          <option value="chat_abuse">Abuso o acoso en chat (insultos, toxicidad)</option>
          <option value="gameplay_abuse">Mala conducta al jugar (trampas, abandono)</option>
          <option value="spam">Spam / Publicidad molesta</option>
          <option value="other">Otro motivo</option>
        </select>
      </div>

      <div class="pv-form-group">
        <label for="report-details">Detalles adicionales</label>
        <textarea id="report-details" rows="4" placeholder="Describe brevemente lo ocurrido..." required></textarea>
      </div>

      <div class="pv-modal-footer">
        <button type="button" class="btn-secondary" data-close="report-user-modal">Cancelar</button>
        <button type="submit" class="btn-primary" id="submit-report-btn" style="background: #ef4444; border-color: rgba(239, 68, 68, 0.4); box-shadow: 0 4px 15px rgba(239, 68, 68, 0.2);">Enviar Denuncia 🚩</button>
      </div>
    </form>
  </div>
</div>
)}

<!-- ══════════ MODAL: Lista de Amigos ══════════ -->
<div id="friends-modal" class="pv-modal-overlay pv-hidden">
  <div class="pv-modal-content animate-fade-in-up">
    <div class="pv-modal-header">
      <h3>🫂 Lista de Amigos</h3>
      <button class="pv-close-btn" data-close="friends-modal">&times;</button>
    </div>
    <div class="pv-friends-list">
      {(!friendsList || friendsList.length === 0) ? (
        <div class="empty-state" style="padding: 2rem;">
          <p>No hay amigos que mostrar.</p>
        </div>
      ) : (
        friendsList.map((friend) => (
          <div class="pv-friend-item">
            <a href={`/perfil?usuario=${friend.name}`} class="pv-friend-link">
              <div class="pv-friend-avatar">
                {friend.avatar_url ? (
                  <img src={friend.avatar_url} alt={friend.name} />
                ) : (
                  <span>{friend.name.charAt(0).toUpperCase()}</span>
                )}
              </div>
              <span class="pv-friend-name">{friend.name}</span>
            </a>
          </div>
        ))
      )}
    </div>
  </div>
</div>

<style>
  /* ── Profile Layout ── */
  .profile-view { display: flex; flex-direction: column; gap: 2rem; width: 100%; }
  .profile-header { background: var(--color-surface-card); border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; }
  .profile-banner { height: 150px; background: linear-gradient(135deg, rgba(124,58,237,0.4), rgba(56,189,248,0.4)); width: 100%; }
  .profile-info-container { padding: 0 2rem 2rem; display: flex; flex-wrap: wrap; align-items: flex-end; gap: 1.5rem; position: relative; margin-top: -50px; }
  .profile-avatar { width: 100px; height: 100px; border-radius: 50%; background: linear-gradient(135deg, var(--color-primary), var(--color-accent)); border: 4px solid var(--color-surface-card); display: flex; align-items: center; justify-content: center; font-size: 2.5rem; font-weight: 700; color: white; overflow: hidden; flex-shrink: 0; }
  .profile-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .profile-basic-info { flex: 1; min-width: 250px; padding-bottom: 0.5rem; }
  .profile-name { font-family: var(--font-heading); font-size: 1.8rem; margin-bottom: 0.5rem; }
  .profile-description { color: var(--color-text-secondary); font-size: 0.95rem; line-height: 1.5; }
  .profile-actions { display: flex; gap: 1rem; padding-bottom: 0.5rem; }

  /* ── Stats ── */
  .profile-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; }
  .stat-card { background: var(--color-surface-card); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 1.5rem; text-align: center; display: flex; flex-direction: column; gap: 0.5rem; }
  .clickable-stat { cursor: pointer; transition: transform 0.2s, box-shadow 0.2s; }
  .clickable-stat:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(0,0,0,0.2); }
  .stat-value { font-family: var(--font-heading); font-size: 2rem; font-weight: 700; }
  .text-primary { color: var(--color-primary); }
  .text-accent { color: var(--color-accent); }
  .text-secondary { color: var(--color-secondary); }
  .stat-label { color: var(--color-text-muted); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; }

  /* ── Preferences ── */
  .profile-preferences h3 { margin-bottom: 1rem; font-family: var(--font-heading); }
  .preferences-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 1.5rem; }
  .preference-card { background: var(--color-surface-card); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 1.5rem; }
  .preference-card h4 { font-size: 1.05rem; margin-bottom: 1rem; color: var(--color-text-primary); }
  .tags-container { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .tag { padding: 0.4rem 0.8rem; border-radius: 100px; font-size: 0.85rem; font-weight: 500; }
  .game-tag { background: rgba(0,240,255,0.1); color: var(--color-primary-light); border: 1px solid rgba(0,240,255,0.2); }
  .style-tag { background: rgba(108,58,255,0.1); color: var(--color-accent-light); border: 1px solid rgba(108,58,255,0.2); }
  .sought-tag { background: rgba(255,60,172,0.1); color: var(--color-secondary-light); border: 1px solid rgba(255,60,172,0.2); }

  /* ── Recent ── */
  .profile-recent h3 { margin-bottom: 1rem; font-family: var(--font-heading); }
  .empty-state { padding: 3rem; text-align: center; background: var(--color-surface-card); border: 1px dashed var(--color-border); border-radius: var(--radius-md); color: var(--color-text-muted); }

  /* ══════════ Modals ══════════ */
  .pv-modal-overlay {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0,0,0,0.65); backdrop-filter: blur(6px);
    display: flex; align-items: center; justify-content: center;
    z-index: 999999; padding: 1rem; overflow-y: auto;
    opacity: 1; visibility: visible; transition: opacity 0.2s, visibility 0.2s;
  }
  .pv-modal-overlay.pv-hidden { opacity: 0; visibility: hidden; pointer-events: none; }

  .pv-modal-content {
    background: var(--color-surface-card); border: 1px solid var(--color-border);
    border-radius: var(--radius-lg); width: 100%; max-width: 540px;
    padding: 2rem; box-shadow: 0 15px 40px rgba(0,0,0,0.5);
    margin: auto; max-height: calc(100vh - 2rem); overflow-y: auto;
  }

  .pv-modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
  .pv-modal-header h3 { margin: 0; font-size: 1.3rem; font-family: var(--font-heading); }
  .pv-close-btn { background: transparent; border: none; color: var(--color-text-muted); font-size: 1.6rem; cursor: pointer; line-height: 1; transition: color 0.2s; }
  .pv-close-btn:hover { color: var(--color-text-primary); }

  .pv-form { display: flex; flex-direction: column; gap: 1.25rem; }
  .pv-form-group { display: flex; flex-direction: column; gap: 0.4rem; }
  .pv-form-group label { font-size: 0.9rem; font-weight: 600; color: var(--color-text-secondary); }
  .pv-form-group input, .pv-form-group textarea {
    width: 100%; padding: 0.75rem 1rem; font-size: 0.95rem; font-family: var(--font-sans);
    color: var(--color-text-primary); background: rgba(11,15,26,0.6);
    border: 1px solid var(--color-border); border-radius: var(--radius-sm);
    outline: none; transition: border-color 0.2s;
  }
  .pv-form-group input:focus, .pv-form-group textarea:focus {
    border-color: var(--color-primary); box-shadow: 0 0 0 3px rgba(0,240,255,0.12);
  }

  /* Games grid in modal */
  .pv-games-grid { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .pv-game-checkbox { cursor: pointer; }
  .pv-game-checkbox input { display: none; }
  .pv-game-pill {
    display: inline-block; padding: 0.5rem 1rem;
    background: rgba(11,15,26,0.6); border: 1px solid var(--color-border);
    border-radius: 100px; font-size: 0.9rem; color: var(--color-text-secondary);
    transition: all 0.2s;
  }
  .pv-game-checkbox:hover .pv-game-pill { background: rgba(255,255,255,0.05); color: var(--color-text-primary); }
  .pv-game-checkbox input:checked + .pv-game-pill {
    background: rgba(0,240,255,0.15); border-color: var(--color-primary);
    color: var(--color-primary-light); box-shadow: 0 0 12px rgba(0,240,255,0.15);
  }

  /* Radio pills in modal */
  .pv-radio-group { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .pv-radio-option { cursor: pointer; }
  .pv-radio-option input { display: none; }
  .pv-radio-pill {
    display: inline-block; padding: 0.5rem 1rem;
    background: rgba(11,15,26,0.6); border: 1px solid var(--color-border);
    border-radius: 100px; font-size: 0.9rem; color: var(--color-text-secondary);
    transition: all 0.2s;
  }
  .pv-radio-option:hover .pv-radio-pill { background: rgba(255,255,255,0.05); }
  .pv-radio-option input:checked + .pv-radio-pill {
    background: rgba(108,58,255,0.15); border-color: var(--color-accent);
    color: var(--color-accent-light); box-shadow: 0 0 12px rgba(108,58,255,0.15);
  }

  .pv-modal-footer { display: flex; justify-content: flex-end; gap: 1rem; margin-top: 0.5rem; padding-top: 1rem; border-top: 1px solid var(--color-border); }

  /* Settings specific */
  .pv-settings-section { display: flex; flex-direction: column; gap: 1rem; }
  .pv-settings-section h4 { font-family: var(--font-heading); font-size: 1.1rem; margin: 0; }
  .pv-divider { height: 1px; background: var(--color-border); margin: 0.5rem 0; }
  .btn-block { width: 100%; padding: 0.75rem; text-align: center; border-radius: var(--radius-sm); font-weight: 600; cursor: pointer; font-size: 0.95rem; transition: all 0.2s; }
  .btn-danger { background: rgba(239,68,68,0.15); border: 1px solid rgba(239,68,68,0.3); color: #f87171; display: block; text-decoration: none; }
  .btn-danger:hover { background: rgba(239,68,68,0.25); }
  .pv-danger-zone { }
  .pv-danger-text { font-size: 0.85rem; color: var(--color-text-muted); margin: 0; }

  /* Friends List Modal */
  .pv-friends-list { display: flex; flex-direction: column; gap: 0.75rem; max-height: 400px; overflow-y: auto; padding-right: 0.5rem; }
  .pv-friends-list::-webkit-scrollbar { width: 6px; }
  .pv-friends-list::-webkit-scrollbar-thumb { background-color: var(--color-border); border-radius: 10px; }
  .pv-friend-item { background: rgba(11,15,26,0.6); border: 1px solid var(--color-border); border-radius: var(--radius-md); transition: all 0.2s; }
  .pv-friend-item:hover { border-color: var(--color-secondary); transform: translateX(4px); }
  .pv-friend-link { display: flex; align-items: center; gap: 1rem; padding: 1rem; text-decoration: none; color: inherit; }
  .pv-friend-avatar { width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); display: flex; align-items: center; justify-content: center; font-weight: bold; overflow: hidden; flex-shrink: 0; }
  .pv-friend-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .pv-friend-name { font-weight: 600; font-size: 1.05rem; }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .profile-view { gap: 1.25rem; }

    .profile-banner { height: 100px; }
    .profile-info-container {
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 0 1rem 1.5rem;
      margin-top: -40px;
      gap: 1rem;
    }

    .profile-avatar { width: 80px; height: 80px; font-size: 2rem; border-width: 3px; }
    .profile-basic-info { min-width: unset; width: 100%; padding-bottom: 0; }
    .profile-basic-info h2,
    .profile-basic-info .profile-name { font-size: 1.4rem !important; }
    .profile-basic-info p,
    .profile-basic-info .profile-description { font-size: 0.85rem !important; }

    .profile-actions {
      justify-content: center;
      width: 100%;
      flex-wrap: wrap;
      gap: 0.75rem;
      padding-bottom: 0;
    }
    .profile-actions .btn-primary,
    .profile-actions .btn-secondary,
    .profile-actions .btn-danger {
      font-size: 0.85rem !important;
      padding: 0.55rem 1rem !important;
      flex: 1 1 auto;
      min-width: 0;
      justify-content: center;
    }

    /* Stats grid: 2 cols on mobile */
    .profile-stats {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }
    .stat-card { padding: 1rem; min-height: 90px !important; }
    .stat-value { font-size: 1.5rem; }
    .stat-label { font-size: 0.75rem; }

    /* Preferences */
    .profile-preferences h3 { font-size: 1.1rem; }
    .preferences-grid { grid-template-columns: 1fr; gap: 1rem; }
    .preference-card { padding: 1rem; }
    .preference-card h4 { font-size: 0.95rem; margin-bottom: 0.75rem; }
    .tag { padding: 0.3rem 0.6rem; font-size: 0.8rem; }

    /* Recent */
    .profile-recent h3 { font-size: 1.1rem; }
    .empty-state { padding: 2rem 1rem; font-size: 0.9rem; }

    /* ── Modals: full-screen feel on mobile ── */
    .pv-modal-overlay { padding: 0.5rem; align-items: flex-start; padding-top: 2rem; }
    .pv-modal-content {
      max-width: 100%;
      padding: 1.25rem;
      border-radius: var(--radius-md);
      max-height: calc(100vh - 3rem);
    }
    .pv-modal-header { margin-bottom: 1rem; }
    .pv-modal-header h3 { font-size: 1.1rem; }
    .pv-close-btn { font-size: 1.8rem; padding: 0.25rem; }

    /* Form inputs touch-friendly */
    .pv-form { gap: 1rem; }
    .pv-form-group label { font-size: 0.85rem; }
    .pv-form-group input, .pv-form-group textarea {
      padding: 0.7rem 0.85rem;
      font-size: 1rem; /* 16px prevents iOS zoom */
    }

    /* Games grid pills */
    .pv-games-grid { gap: 0.5rem; }
    .pv-game-pill { padding: 0.4rem 0.75rem; font-size: 0.8rem; }

    /* Radio pills */
    .pv-radio-group { gap: 0.5rem; }
    .pv-radio-pill { padding: 0.4rem 0.75rem; font-size: 0.8rem; }

    .pv-modal-footer {
      flex-direction: column-reverse;
      gap: 0.75rem;
    }
    .pv-modal-footer .btn-primary,
    .pv-modal-footer .btn-secondary {
      width: 100%;
      text-align: center;
      padding: 0.75rem;
      font-size: 0.95rem;
    }

    /* Settings specific */
    .pv-settings-section h4 { font-size: 1rem; }
    .btn-block { padding: 0.7rem; font-size: 0.9rem; }
    .pv-danger-text { font-size: 0.8rem; }
    .pv-divider { margin: 0.75rem 0; }

    /* Friends list */
    .pv-friends-list { max-height: 50vh; }
    .pv-friend-link { padding: 0.75rem; }
    .pv-friend-avatar { width: 36px; height: 36px; }
    .pv-friend-name { font-size: 0.95rem; }

    /* Profile title badge */
    .profile-title-badge { font-size: 0.75rem; }
  }

  /* Extra small screens */
  @media (max-width: 400px) {
    .profile-stats { grid-template-columns: 1fr; }
    .profile-actions { flex-direction: column; }
    .profile-actions .btn-primary,
    .profile-actions .btn-secondary,
    .profile-actions .btn-danger {
      width: 100%;
    }
    .pv-modal-content { padding: 1rem; }
    .pv-games-grid { gap: 0.4rem; }
    .pv-game-pill { padding: 0.35rem 0.6rem; font-size: 0.75rem; }
  }
</style>

<script>
  // ── Modal helpers ──
  function openModal(id: string) {
    document.getElementById(id)?.classList.remove('pv-hidden');
  }
  function closeModal(id: string) {
    document.getElementById(id)?.classList.add('pv-hidden');
  }

  // Close buttons
  document.querySelectorAll('[data-close]').forEach(btn => {
    btn.addEventListener('click', () => {
      const modalId = (btn as HTMLElement).dataset.close!;
      closeModal(modalId);
    });
  });

  // Close on overlay click
  document.querySelectorAll('.pv-modal-overlay').forEach(overlay => {
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) closeModal(overlay.id);
    });
  });

  // ── Open Edit Profile ──
  document.getElementById('edit-profile-btn')?.addEventListener('click', () => {
    openModal('edit-profile-modal');
  });

  // ── Open Report User Modal ──
  document.querySelector('.report-profile-btn')?.addEventListener('click', () => {
    openModal('report-user-modal');
  });

  // ── Submit Report ──
  const reportForm = document.getElementById('report-user-form') as HTMLFormElement;
  if (reportForm) {
    reportForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = document.getElementById('submit-report-btn') as HTMLButtonElement;
      const originalText = submitBtn.textContent;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Enviando...';

      const reported_id = (document.getElementById('report-target-id') as HTMLInputElement).value;
      const reason = (document.getElementById('report-reason') as HTMLSelectElement).value;
      const details = (document.getElementById('report-details') as HTMLTextAreaElement).value;

      try {
        const res = await fetch('/api/reports', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reported_id, reason, details })
        });

        if (res.ok) {
          alert('¡Denuncia enviada correctamente! Un administrador revisará la incidencia.');
          closeModal('report-user-modal');
          reportForm.reset();
        } else {
          const data = await res.json();
          alert('Error: ' + (data.error || 'No se pudo enviar la denuncia.'));
          submitBtn.disabled = false;
          submitBtn.textContent = originalText;
        }
      } catch (err) {
        alert('Error conectando con el servidor.');
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
      }
    });
  }

  // ── Open Settings ──
  document.getElementById('settings-btn')?.addEventListener('click', () => {
    openModal('settings-modal');
  });

  // ── Open Friends List ──
  document.getElementById('friends-stat-card')?.addEventListener('click', () => {
    openModal('friends-modal');
  });

  // ── Save Profile ──
  const editForm = document.getElementById('edit-profile-form') as HTMLFormElement;
  if (editForm) {
    editForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const saveBtn = document.getElementById('save-profile-btn') as HTMLButtonElement;
      const originalText = saveBtn.textContent;
      saveBtn.disabled = true;
      saveBtn.textContent = 'Guardando...';

      const name = (document.getElementById('edit-name') as HTMLInputElement).value;
      const description = (document.getElementById('edit-description') as HTMLTextAreaElement).value;
      const favorite_games = Array.from(editForm.querySelectorAll('input[name="edit-games"]:checked')).map(el => (el as HTMLInputElement).value);
      const play_style = (editForm.querySelector('input[name="edit-play-style"]:checked') as HTMLInputElement)?.value || '';
      const player_type_sought = (editForm.querySelector('input[name="edit-player-type"]:checked') as HTMLInputElement)?.value || '';

      try {
        const res = await fetch('/api/profile', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, description, favorite_games, play_style, player_type_sought })
        });

        if (res.ok) {
          window.location.reload();
        } else {
          const data = await res.json();
          alert('Error: ' + (data.error || 'No se pudo guardar'));
          saveBtn.disabled = false;
          saveBtn.textContent = originalText;
        }
      } catch (err) {
        alert('Error conectando con el servidor.');
        saveBtn.disabled = false;
        saveBtn.textContent = originalText;
      }
    });
  }

  // ── Change Password ──
  document.getElementById('change-password-btn')?.addEventListener('click', async () => {
    const newPass = (document.getElementById('new-password') as HTMLInputElement).value;
    const confirmPass = (document.getElementById('confirm-password') as HTMLInputElement).value;

    if (!newPass || newPass.length < 6) {
      alert('La contraseña debe tener al menos 6 caracteres.');
      return;
    }
    if (newPass !== confirmPass) {
      alert('Las contraseñas no coinciden.');
      return;
    }

    const btn = document.getElementById('change-password-btn') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Actualizando...';

    try {
      const res = await fetch('/api/auth/change-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password: newPass })
      });

      if (res.ok) {
        alert('¡Contraseña actualizada correctamente!');
        (document.getElementById('new-password') as HTMLInputElement).value = '';
        (document.getElementById('confirm-password') as HTMLInputElement).value = '';
        closeModal('settings-modal');
      } else {
        const data = await res.json();
        alert('Error: ' + (data.error || 'No se pudo actualizar'));
      }
    } catch (err) {
      alert('Error conectando con el servidor.');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Actualizar Contraseña';
    }
  });

  // ── Event Delegation for Profile Buttons ──
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;

    // --- Message Button ---
    const msgBtn = target.closest('.message-btn') as HTMLButtonElement;
    if (msgBtn && !msgBtn.disabled) {
      const targetId = msgBtn.dataset.targetId;
      if (!targetId) return;
      
      const originalText = msgBtn.textContent;
      msgBtn.textContent = 'Iniciando...';
      msgBtn.disabled = true;
      try {
        const res = await fetch('/api/conversations', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ target_profile_id: targetId })
        });
        const data = await res.json();
        if (res.ok && data.id) {
          window.location.href = `/mensajes/${data.id}`;
        } else {
          alert('Error: ' + (data.error || 'No se pudo iniciar el chat'));
          msgBtn.textContent = originalText;
          msgBtn.disabled = false;
        }
      } catch (err) {
        alert('Error conectando con el servidor.');
        msgBtn.textContent = originalText;
        msgBtn.disabled = false;
      }
      return; // Stop here if handled
    }

    // --- Add Friend Button ---
    const addBtn = target.closest('.btn-add-friend') as HTMLButtonElement;
    if (addBtn && !addBtn.disabled) {
      const targetId = addBtn.dataset.targetId;
      if (!targetId) return;
      
      const originalText = addBtn.textContent;
      addBtn.textContent = 'Enviando...';
      addBtn.disabled = true;
      try {
        const res = await fetch('/api/friends/request', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ receiver_id: targetId })
        });
        if (res.ok) {
          window.location.reload(); 
        } else {
          const data = await res.json();
          alert('Error: ' + (data.error || 'No se pudo enviar la solicitud.'));
          addBtn.textContent = originalText;
          addBtn.disabled = false;
        }
      } catch (err) {
        alert('Error conectando con el servidor.');
        addBtn.textContent = originalText;
        addBtn.disabled = false;
      }
      return; // Stop here if handled
    }

    // --- Accept Friend Request Button (on Profile) ---
    const acceptReqBtn = target.closest('.btn-accept-friend-req') as HTMLButtonElement;
    if (acceptReqBtn && !acceptReqBtn.disabled) {
      const reqId = acceptReqBtn.dataset.requestId;
      if (!reqId) return;
      
      const originalText = acceptReqBtn.textContent;
      acceptReqBtn.textContent = 'Aceptando...';
      acceptReqBtn.disabled = true;
      try {
        const res = await fetch('/api/friends/respond', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ request_id: reqId, status: 'accepted' })
        });
        if (res.ok) {
          window.location.reload();
        } else {
          alert('Error al aceptar solicitud.');
          acceptReqBtn.textContent = originalText;
          acceptReqBtn.disabled = false;
        }
      } catch (err) {
        alert('Error de conexión.');
        acceptReqBtn.textContent = originalText;
        acceptReqBtn.disabled = false;
      }
    }
  });
</script>
