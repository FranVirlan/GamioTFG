  }

  .pv-modal-footer { display: flex; justify-content: flex-end; align-items: center; gap: 0.75rem; margin-top: 0.5rem; padding-top: 1rem; border-top: 1px solid var(--color-border); width: 100%; flex-wrap: wrap; }
  .pv-modal-footer .btn-primary,
  .pv-modal-footer .btn-secondary,
  .pv-modal-footer .btn-danger {
    padding: 0.65rem 1.25rem !important;
