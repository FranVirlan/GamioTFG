  /* Friends List Modal */
  .pv-friends-list { display: flex; flex-direction: column; gap: 0.75rem; max-height: 400px; overflow-y: auto; padding-right: 0.5rem; }
  .pv-friends-list::-webkit-scrollbar { width: 6px; }
  .pv-friends-list::-webkit-scrollbar-thumb { background-color: var(--color-border); border-radius: 10px; }
  .pv-friend-item { background: rgba(11,15,26,0.6); border: 1px solid var(--color-border); border-radius: var(--radius-md); transition: all 0.2s; }
  .pv-friend-item:hover { border-color: var(--color-secondary); transform: translateX(4px); }
  .pv-friend-link { display: flex; align-items: center; gap: 1rem; padding: 1rem; text-decoration: none; color: inherit; }
  .pv-friend-avatar { width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); display: flex; align-items: center; justify-content: center; font-weight: bold; overflow: hidden; flex-shrink: 0; }
  .pv-friend-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .pv-friend-name { font-weight: 600; font-size: 1.05rem; }

  /* ── Responsive ── */
