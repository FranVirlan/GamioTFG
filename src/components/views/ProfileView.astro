  .btn-unlink-game { background: transparent; border: none; color: var(--color-text-muted); font-size: 1.4rem; cursor: pointer; line-height: 1; padding: 0.2rem 0.4rem; border-radius: 4px; transition: all 0.2s; }
  .btn-unlink-game:hover { color: #ef4444; background: rgba(239, 68, 68, 0.1); }
  .ga-card-body { display: flex; flex-direction: column; gap: 1rem; }
