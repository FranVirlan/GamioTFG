---
/**
 * ProfileView.astro
 * Vista del perfil de usuario con avatar, información y estadísticas.
 */
interface Props {
  isOwnProfile?: boolean;
  friendStatus?: string;
  friendRequestId?: string | null;
  friendsList?: any[];
  user?: {
    id?: string;
    name: string;
    avatarUrl?: string;
    level: number;
    xp?: number;
    points?: number;
    selectedTitle?: string;
    selectedBorder?: string;
    followers: number;
    gamesPlayed: number;
    description: string;
    favoriteGames?: string[];
    playStyle?: string;
    playerTypeSought?: string;
  };
  gameAccounts?: Record<string, any>;
}

const { 
  isOwnProfile = true,
  friendStatus = 'none',
  friendRequestId = null,
  friendsList = [],
  gameAccounts = {},
  user
} = Astro.props;

const popularGames = [
  "League of Legends", "Valorant", "Counter-Strike 2",
  "Dead By Daylight", "Fortnite", "Apex Legends",
  "Overwatch 2", "Call of Duty: Warzone", "Rocket League", "EA FC 25"
];

const defaultAvatars = [
  'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=150&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1578632767115-351597cf2477?w=150&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1563089145-599997674d42?w=150&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1550745165-9bc0b252726f?w=150&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1566241477600-ac026ad43874?w=150&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1589254065878-42c9da997008?w=150&auto=format&fit=crop'
];
---

<div class="profile-view animate-fade-in-up">
  <!-- Cabecera de perfil -->
  <div class="profile-header">
    <div class="profile-banner"></div>
    <div class="profile-info-container">
      <div class={`profile-avatar ${user.selectedBorder || ''}`}>
        {user.avatarUrl ? (
          <img src={user.avatarUrl} alt={user.name} />
        ) : (
          <span>{user.name.charAt(0).toUpperCase()}</span>
        )}
      </div>
      <div class="profile-basic-info">
        <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
          <h2 class="profile-name" style="margin: 0; font-family: var(--font-heading); font-size: 1.8rem;">{user.name}</h2>
          {user.selectedTitle && (
            <span class="profile-title-badge">{user.selectedTitle}</span>
          )}
        </div>
        <p class="profile-description" style="margin-top: 0.5rem; color: var(--color-text-secondary); font-size: 0.95rem; line-height: 1.5;">{user.description}</p>
      </div>
      <div class="profile-actions">
        {isOwnProfile ? (
          <>
            <button class="btn-primary" id="edit-profile-btn">Editar Perfil</button>
            <button class="btn-secondary" id="settings-btn">Ajustes</button>
          </>
        ) : (
          <>
            {friendStatus === 'accepted' && <button class="btn-primary" disabled style="background: rgba(34, 197, 94, 0.2); color: #4ADE80; border-color: rgba(34, 197, 94, 0.4);">✓ Amigos</button>}
            {friendStatus === 'pending_sent' && <button class="btn-primary" disabled style="background: rgba(124, 58, 237, 0.2); color: #C4B5FD; border-color: rgba(124, 58, 237, 0.4);">Solicitud Pendiente</button>}
            {friendStatus === 'pending_received' && <button class="btn-primary btn-accept-friend-req" data-request-id={friendRequestId}>Aceptar Solicitud</button>}
            {friendStatus === 'none' && <button class="btn-primary btn-add-friend" data-target-id={user.id}>Añadir Amigo</button>}
            
            <button class="btn-secondary message-btn" data-target-id={user.id}>Mensaje</button>
            <button class="btn-danger report-profile-btn" data-target-id={user.id} style="padding: 0.6rem 1.2rem; display: flex; align-items: center; gap: 0.5rem; background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171; border-radius: var(--radius-sm); font-weight: 600; cursor: pointer; transition: all 0.2s;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/>
              </svg>
              Reportar
            </button>
          </>
        )}
      </div>
    </div>
  </div>

  <!-- Estadísticas -->
  <div class="profile-stats">
    <div class="stat-card" style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.5rem; min-height: 120px;">
      <span class="stat-value text-primary">Nv. {user.level}</span>
      <span class="stat-label">Nivel Actual</span>
      {typeof user.xp !== 'undefined' && (
        <div style="width: 100%; margin-top: 0.5rem;">
          <div style="display: flex; justify-content: space-between; font-size: 0.7rem; color: var(--color-text-muted); margin-bottom: 0.25rem;">
            <span>XP: {user.xp % 100}/100</span>
            <span>Tot: {user.xp} XP</span>
          </div>
          <div class="xp-progress-container">
            <div class="xp-progress-bar" style={`width: ${user.xp % 100}%`}></div>
          </div>
        </div>
      )}
    </div>
    <div class="stat-card" style="display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 120px;">
      <span class="stat-value" style="color: #FFB800;">✨ {user.points || 0}</span>
      <span class="stat-label">Puntos Gamio</span>
    </div>
    <div class="stat-card" style="display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 120px;">
      <span class="stat-value text-accent">{user.gamesPlayed}</span>
      <span class="stat-label">Partidas Jugadas</span>
    </div>
    <div class="stat-card clickable-stat" id="friends-stat-card" style="display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 120px;">
      <span class="stat-value text-secondary">{user.followers}</span>
      <span class="stat-label">Amigos</span>
    </div>
  </div>

  <!-- Preferencias de Jugador -->
  {(user.playStyle || user.playerTypeSought || (user.favoriteGames && user.favoriteGames.length > 0)) && (
    <div class="profile-preferences">
      <h3>Preferencias de Jugador</h3>
      <div class="preferences-grid">
        {user.favoriteGames && user.favoriteGames.length > 0 && (
          <div class="preference-card">
            <h4>🎮 Juegos Favoritos</h4>
            <div class="tags-container">
              {user.favoriteGames.map((game: string) => (
                <span class="tag game-tag">{game}</span>
              ))}
            </div>
          </div>
        )}
        {(user.playStyle || user.playerTypeSought) && (
          <div class="preference-card">
            <h4>⚔️ Estilo y Búsqueda</h4>
            <div class="tags-container">
              {user.playStyle && (
                <span class="tag style-tag">Estilo: {user.playStyle}</span>
              )}
              {user.playerTypeSought && (
                <span class="tag sought-tag">Busca: {user.playerTypeSought}</span>
              )}
            </div>
          </div>
        )}
      </div>
    </div>
  )}

  <!-- Cuentas de Juego & Estadísticas Reales -->
  <div class="profile-game-accounts">
    <div class="game-accounts-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.5rem;">
      <h3 style="margin: 0; font-family: var(--font-heading); font-size: 1.3rem;">🎮 Cuentas de Juego & Estadísticas Reales</h3>
      {isOwnProfile && (
        <button class="btn-primary" id="connect-game-account-btn" style="padding: 0.5rem 1rem; font-size: 0.85rem;">
          ⚡ Vincular Cuenta de Juego
        </button>
      )}
    </div>

    {Object.keys(gameAccounts).length === 0 ? (
      <div class="empty-state" style="padding: 2.5rem; text-align: center;">
        <p style="margin-bottom: 1rem; color: var(--color-text-secondary);">Aún no se han vinculado cuentas de juego para mostrar estadísticas autenticadas.</p>
        {isOwnProfile && (
          <button class="btn-secondary" id="connect-game-account-empty-btn" style="font-size: 0.9rem;">
            + Vincular mi primera cuenta (Riot, Epic, Steam...)
          </button>
        )}
      </div>
    ) : (
      <div class="game-accounts-grid">
        {Object.entries(gameAccounts).map(([gameName, acc]) => (
          <div class="game-account-card">
            <div class="ga-card-header">
              <div class="ga-game-badge">
                <span class="ga-game-name">{acc.game || gameName}</span>
                {acc.verified && <span class="ga-verified-tag">✓ Tracker.gg Verificado</span>}
              </div>
              {isOwnProfile && (
                <button class="btn-unlink-game" data-game={gameName} title="Desvincular esta cuenta">
                  ×
                </button>
              )}
            </div>

            <div class="ga-card-body">
              <div class="ga-rank-info">
                {acc.rankIcon ? (
                  <img src={acc.rankIcon} alt={acc.rankName || gameName} class="ga-rank-icon" />
                ) : (
                  <div class="ga-rank-icon-placeholder">🎮</div>
                )}
                <div>
                  <h4 class="ga-rank-name">{acc.handle}</h4>
                  <p class="ga-handle">{acc.platform || 'Oficial'} {acc.region ? `(${acc.region})` : ''}</p>
                </div>
              </div>

              <div class="ga-tracker-direct-container" style="margin-top: 0.5rem;">
                <a href={acc.trackerUrl || `https://tracker.gg`} target="_blank" rel="noopener noreferrer" class="btn-primary btn-block" style="text-decoration: none; display: flex; align-items: center; justify-content: center; gap: 0.5rem; background: linear-gradient(135deg, var(--color-secondary), var(--color-primary-dark)); font-size: 0.88rem; padding: 0.75rem;">
                  <span>📊 Ver Estadísticas en Tracker.gg</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    )}
  </div>

  <!-- Juegos Recientes -->
  <div class="profile-recent">
    <h3>Juegos Recientes</h3>
    <div class="empty-state">
      <p>Aún no hay juegos recientes para mostrar.</p>
    </div>
  </div>
</div>

<!-- ══════════ MODAL: Editar Perfil ══════════ -->
{isOwnProfile && (
<div id="edit-profile-modal" class="pv-modal-overlay pv-hidden">
  <div class="pv-modal-content animate-fade-in-up">
    <div class="pv-modal-header">
      <h3>✏️ Editar Perfil</h3>
      <button class="pv-close-btn" data-close="edit-profile-modal">&times;</button>
    </div>
    <form id="edit-profile-form" class="pv-form">
      <div class="pv-form-group">
        <label for="edit-name">Nombre de usuario</label>
        <input type="text" id="edit-name" value={user.name} required />
      </div>
      <div class="pv-form-group">
        <label for="edit-description">Descripción</label>
        <textarea id="edit-description" rows="3">{user.description}</textarea>
      </div>

      <div class="pv-form-group">
        <label>Elige tu foto de perfil</label>
        <div class="pv-avatars-grid">
          {defaultAvatars.map((avatar, idx) => (
            <label class="pv-avatar-option">
              <input type="radio" name="edit-avatar" value={avatar} checked={user.avatarUrl === avatar} />
              <img src={avatar} alt={`Avatar ${idx + 1}`} class="pv-avatar-img" />
            </label>
          ))}
        </div>
      </div>

      <div class="pv-form-group">
        <label>Juegos Favoritos (Puedes elegir varios)</label>
        <div class="pv-games-grid">
          {popularGames.map(game => (
            <label class="pv-game-checkbox">
              <input type="checkbox" name="edit-games" value={game}
                checked={user.favoriteGames?.includes(game)} />
              <span class="pv-game-pill">{game}</span>
            </label>
          ))}
        </div>
      </div>

      <div class="pv-form-group">
        <label>Estilo de juego</label>
        <div class="pv-radio-group">
          {["Casual", "Competitivo", "Tryhard", "Depende del día"].map(style => (
            <label class="pv-radio-option">
              <input type="radio" name="edit-play-style" value={style}
                checked={user.playStyle === style} />
              <span class="pv-radio-pill">{style}</span>
            </label>
          ))}
        </div>
      </div>

      <div class="pv-form-group">
        <label>Tipo de jugadores que buscas</label>
        <div class="pv-radio-group">
          {["Social", "Ranked", "Mixto"].map(type => (
            <label class="pv-radio-option">
              <input type="radio" name="edit-player-type" value={type}
                checked={user.playerTypeSought === type} />
              <span class="pv-radio-pill">{type}</span>
            </label>
          ))}
        </div>
      </div>

      <div class="pv-modal-footer">
        <button type="button" class="btn-secondary" data-close="edit-profile-modal">Cancelar</button>
        <button type="submit" class="btn-primary" id="save-profile-btn">Guardar Cambios</button>
      </div>
    </form>
  </div>
</div>
)}

<!-- ══════════ MODAL: Ajustes ══════════ -->
{isOwnProfile && (
<div id="settings-modal" class="pv-modal-overlay pv-hidden">
  <div class="pv-modal-content animate-fade-in-up">
    <div class="pv-modal-header">
      <h3>⚙️ Ajustes</h3>
      <button class="pv-close-btn" data-close="settings-modal">&times;</button>
    </div>
    <div class="pv-form">
      <!-- Cambiar contraseña -->
      <div class="pv-settings-section">
        <h4>🔒 Cambiar Contraseña</h4>
        <div class="pv-form-group">
          <label for="new-password">Nueva contraseña</label>
          <input type="password" id="new-password" placeholder="Mínimo 6 caracteres" minlength="6" />
        </div>
        <div class="pv-form-group">
          <label for="confirm-password">Confirmar contraseña</label>
          <input type="password" id="confirm-password" placeholder="Repite la contraseña" minlength="6" />
        </div>
        <button class="btn-primary btn-block" id="change-password-btn">Actualizar Contraseña</button>
      </div>

      <div class="pv-divider"></div>

      <!-- Zona peligrosa -->
      <div class="pv-settings-section pv-danger-zone">
        <h4>⚠️ Zona de Peligro</h4>
        <p class="pv-danger-text">Estas acciones no se pueden deshacer.</p>
        <a href="/api/auth/signout" class="btn-danger btn-block" id="logout-btn">Cerrar Sesión</a>
      </div>
    </div>
  </div>
</div>
)}

<!-- ══════════ MODAL: Reportar Jugador ══════════ -->
{!isOwnProfile && (
<div id="report-user-modal" class="pv-modal-overlay pv-hidden">
  <div class="pv-modal-content animate-fade-in-up">
    <div class="pv-modal-header">
      <h3 style="color: #f87171; display: flex; align-items: center; gap: 0.5rem;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/>
        </svg>
        Reportar a {user.name}
      </h3>
      <button class="pv-close-btn" data-close="report-user-modal">&times;</button>
    </div>
    <form id="report-user-form" class="pv-form">
      <input type="hidden" id="report-target-id" value={user.id} />
      
      <div class="pv-form-group">
        <label for="report-reason">Motivo de la denuncia</label>
        <select id="report-reason" style="width: 100%; padding: 0.75rem 1rem; font-size: 0.95rem; font-family: var(--font-sans); color: var(--color-text-primary); background: rgba(11,15,26,0.6); border: 1px solid var(--color-border); border-radius: var(--radius-sm); outline: none; cursor: pointer;" required>
          <option value="" disabled selected>Selecciona un motivo...</option>
          <option value="chat_abuse">Abuso o acoso en chat (insultos, toxicidad)</option>
          <option value="gameplay_abuse">Mala conducta al jugar (trampas, abandono)</option>
          <option value="spam">Spam / Publicidad molesta</option>
          <option value="other">Otro motivo</option>
        </select>
      </div>

      <div class="pv-form-group">
        <label for="report-details">Detalles adicionales</label>
        <textarea id="report-details" rows="4" placeholder="Describe brevemente lo ocurrido..." required></textarea>
      </div>

      <div class="pv-modal-footer">
        <button type="button" class="btn-secondary" data-close="report-user-modal">Cancelar</button>
        <button type="submit" class="btn-primary" id="submit-report-btn" style="background: #ef4444; border-color: rgba(239, 68, 68, 0.4); box-shadow: 0 4px 15px rgba(239, 68, 68, 0.2);">Enviar Denuncia 🚩</button>
      </div>
    </form>
  </div>
</div>
)}

<!-- ══════════ MODAL: Lista de Amigos ══════════ -->
<div id="friends-modal" class="pv-modal-overlay pv-hidden">
  <div class="pv-modal-content animate-fade-in-up">
    <div class="pv-modal-header">
      <h3>🫂 Lista de Amigos</h3>
      <button class="pv-close-btn" data-close="friends-modal">&times;</button>
    </div>
    <div class="pv-friends-list">
      {(!friendsList || friendsList.length === 0) ? (
        <div class="empty-state" style="padding: 2rem;">
          <p>No hay amigos que mostrar.</p>
        </div>
      ) : (
        friendsList.map((friend) => (
          <div class="pv-friend-item">
            <a href={`/perfil?usuario=${friend.name}`} class="pv-friend-link">
              <div class="pv-friend-avatar">
                {friend.avatar_url ? (
                  <img src={friend.avatar_url} alt={friend.name} />
                ) : (
                  <span>{friend.name.charAt(0).toUpperCase()}</span>
                )}
              </div>
              <span class="pv-friend-name">{friend.name}</span>
            </a>
          </div>
        ))
      )}
    </div>
  </div>
</div>

<!-- ══════════ MODAL: Vincular Cuenta de Juego ══════════ -->
{isOwnProfile && (
<div id="connect-game-modal" class="pv-modal-overlay pv-hidden">
  <div class="pv-modal-content animate-fade-in-up">
    <div class="pv-modal-header">
      <h3>🎮 Vincular Cuenta de Juego</h3>
      <button class="pv-close-btn" data-close="connect-game-modal">&times;</button>
    </div>
    <form id="connect-game-form" class="pv-form">
      <div class="pv-form-group">
        <label for="connect-game-select">Selecciona el juego</label>
        <select id="connect-game-select" class="pv-select" style="width: 100%; padding: 0.75rem 1rem; font-size: 0.95rem; font-family: var(--font-sans); color: var(--color-text-primary); background: rgba(11,15,26,0.6); border: 1px solid var(--color-border); border-radius: var(--radius-sm); outline: none;" required>
          <option value="Valorant">Valorant (Riot Games)</option>
          <option value="League of Legends">League of Legends (Riot Games)</option>
          <option value="Fortnite">Fortnite (Epic Games)</option>
          <option value="Apex Legends">Apex Legends (EA Games)</option>
          <option value="Counter-Strike 2">Counter-Strike 2 (Steam)</option>
          <option value="Rocket League">Rocket League (Epic / Steam)</option>
          <option value="Call of Duty: Warzone">Call of Duty: Warzone (Activision)</option>
          <option value="EA FC 25">EA FC 25 (EA Sports)</option>
        </select>
      </div>

      <div class="pv-form-group">
        <label for="connect-handle-input" id="handle-label">Riot ID (ejemplo: Mixwell#EUW)</label>
        <input type="text" id="connect-handle-input" placeholder="Nombre#Tag o Usuario" required />
        <small id="handle-hint" style="color: var(--color-text-muted); font-size: 0.8rem; margin-top: 0.2rem;">Introduce tu Riot ID completo incluyendo el signo # y el Tag (ej: Sova#1234).</small>
      </div>

      <div class="pv-form-group" id="platform-group">
        <label for="connect-platform-select">Plataforma / Red de Cuenta</label>
        <select id="connect-platform-select" class="pv-select" style="width: 100%; padding: 0.75rem 1rem; font-size: 0.95rem; font-family: var(--font-sans); color: var(--color-text-primary); background: rgba(11,15,26,0.6); border: 1px solid var(--color-border); border-radius: var(--radius-sm); outline: none;">
          <option value="riot">Riot Games</option>
        </select>
      </div>

      <div class="pv-form-group" id="region-group">
        <label for="connect-region-select">Región de juego</label>
        <select id="connect-region-select" class="pv-select" style="width: 100%; padding: 0.75rem 1rem; font-size: 0.95rem; font-family: var(--font-sans); color: var(--color-text-primary); background: rgba(11,15,26,0.6); border: 1px solid var(--color-border); border-radius: var(--radius-sm); outline: none;">
          <option value="EUW">EUW / Europa</option>
          <option value="NA">NA / Norteamérica</option>
          <option value="LATAM">LATAM / América Latina</option>
          <option value="AP">AP / Asia-Pacífico</option>
          <option value="KR">KR / Corea</option>
        </select>
      </div>

      <div class="pv-modal-footer">
        <button type="button" class="btn-secondary" data-close="connect-game-modal">Cancelar</button>
        <button type="submit" class="btn-primary" id="submit-connect-game-btn">⚡ Conectar con Tracker.gg</button>
      </div>
    </form>
  </div>
</div>
)}

<style>
  /* ── Profile Layout ── */
  .profile-view { display: flex; flex-direction: column; gap: 2rem; width: 100%; }
  .profile-header { background: var(--color-surface-card); border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; }
  .profile-banner { height: 150px; background: linear-gradient(135deg, rgba(124,58,237,0.4), rgba(56,189,248,0.4)); width: 100%; }
  .profile-info-container { padding: 0 2rem 2rem; display: flex; flex-wrap: wrap; align-items: flex-end; gap: 1.5rem; position: relative; margin-top: -50px; }
  .profile-avatar { width: 100px; height: 100px; border-radius: 50%; background: linear-gradient(135deg, var(--color-primary), var(--color-accent)); border: 4px solid var(--color-surface-card); display: flex; align-items: center; justify-content: center; font-size: 2.5rem; font-weight: 700; color: white; overflow: hidden; flex-shrink: 0; }
  .profile-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .profile-basic-info { flex: 1; min-width: 250px; padding-bottom: 0.5rem; }
  .profile-name { font-family: var(--font-heading); font-size: 1.8rem; margin-bottom: 0.5rem; }
