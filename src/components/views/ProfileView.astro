</style>

<script>
  // ── Modal helpers ──
  function openModal(id: string) {
    document.getElementById(id)?.classList.remove('pv-hidden');
    document.body.style.overflow = 'hidden';
  }
  function closeModal(id: string) {
    document.getElementById(id)?.classList.add('pv-hidden');
    const openModals = document.querySelectorAll('.pv-modal-overlay:not(.pv-hidden)');
    if (openModals.length === 0) {
      document.body.style.overflow = '';
    }
  }

  // Close buttons
  document.querySelectorAll('[data-close]').forEach(btn => {
    btn.addEventListener('click', () => {
      const modalId = (btn as HTMLElement).dataset.close!;
      closeModal(modalId);
    });
  });

  // Close on overlay click
  document.querySelectorAll('.pv-modal-overlay').forEach(overlay => {
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) closeModal(overlay.id);
    });
  });

  // ── Open Edit Profile ──
  document.getElementById('edit-profile-btn')?.addEventListener('click', () => {
    openModal('edit-profile-modal');
  });

  // ── Open Report User Modal ──
  document.querySelector('.report-profile-btn')?.addEventListener('click', () => {
    openModal('report-user-modal');
  });

  // ── Submit Report ──
  const reportForm = document.getElementById('report-user-form') as HTMLFormElement;
  if (reportForm) {
    reportForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = document.getElementById('submit-report-btn') as HTMLButtonElement;
      const originalText = submitBtn.textContent;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Enviando...';

      const reported_id = (document.getElementById('report-target-id') as HTMLInputElement).value;
      const reason = (document.getElementById('report-reason') as HTMLSelectElement).value;
      const details = (document.getElementById('report-details') as HTMLTextAreaElement).value;

      try {
        const res = await fetch('/api/reports', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reported_id, reason, details })
        });

        if (res.ok) {
          alert('¡Denuncia enviada correctamente! Un administrador revisará la incidencia.');
          closeModal('report-user-modal');
          reportForm.reset();
        } else {
          const data = await res.json();
          alert('Error: ' + (data.error || 'No se pudo enviar la denuncia.'));
          submitBtn.disabled = false;
          submitBtn.textContent = originalText;
        }
      } catch (err) {
        alert('Error conectando con el servidor.');
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
      }
    });
  }

  // ── Open Settings ──
  document.getElementById('settings-btn')?.addEventListener('click', () => {
    openModal('settings-modal');
  });

  // ── Open Friends List ──
  document.getElementById('friends-stat-card')?.addEventListener('click', () => {
    openModal('friends-modal');
  });

  // ── Save Profile ──
  const editForm = document.getElementById('edit-profile-form') as HTMLFormElement;
  if (editForm) {
    editForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const saveBtn = document.getElementById('save-profile-btn') as HTMLButtonElement;
      const originalText = saveBtn.textContent;
      saveBtn.disabled = true;
      saveBtn.textContent = 'Guardando...';

      const name = (document.getElementById('edit-name') as HTMLInputElement).value;
      const description = (document.getElementById('edit-description') as HTMLTextAreaElement).value;
      const favorite_games = Array.from(editForm.querySelectorAll('input[name="edit-games"]:checked')).map(el => (el as HTMLInputElement).value);
      const play_style = (editForm.querySelector('input[name="edit-play-style"]:checked') as HTMLInputElement)?.value || '';
      const player_type_sought = (editForm.querySelector('input[name="edit-player-type"]:checked') as HTMLInputElement)?.value || '';
      const avatar_url = (editForm.querySelector('input[name="edit-avatar"]:checked') as HTMLInputElement)?.value || '';

      try {
        const res = await fetch('/api/profile', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, description, favorite_games, play_style, player_type_sought, avatar_url })
        });

        if (res.ok) {
          window.location.reload();
        } else {
          const data = await res.json();
          alert('Error: ' + (data.error || 'No se pudo guardar'));
          saveBtn.disabled = false;
          saveBtn.textContent = originalText;
        }
      } catch (err) {
        alert('Error conectando con el servidor.');
        saveBtn.disabled = false;
        saveBtn.textContent = originalText;
      }
    });
  }

  // ── Change Password ──
  document.getElementById('change-password-btn')?.addEventListener('click', async () => {
    const newPass = (document.getElementById('new-password') as HTMLInputElement).value;
    const confirmPass = (document.getElementById('confirm-password') as HTMLInputElement).value;

    if (!newPass || newPass.length < 6) {
      alert('La contraseña debe tener al menos 6 caracteres.');
      return;
    }
    if (newPass !== confirmPass) {
      alert('Las contraseñas no coinciden.');
      return;
    }

    const btn = document.getElementById('change-password-btn') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Actualizando...';

    try {
      const res = await fetch('/api/auth/change-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password: newPass })
      });

      if (res.ok) {
        alert('¡Contraseña actualizada correctamente!');
        (document.getElementById('new-password') as HTMLInputElement).value = '';
        (document.getElementById('confirm-password') as HTMLInputElement).value = '';
        closeModal('settings-modal');
      } else {
        const data = await res.json();
        alert('Error: ' + (data.error || 'No se pudo actualizar'));
      }
    } catch (err) {
      alert('Error conectando con el servidor.');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Actualizar Contraseña';
    }
  });

  // ── Event Delegation for Profile Buttons ──
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;

    // --- Message Button ---
    const msgBtn = target.closest('.message-btn') as HTMLButtonElement;
    if (msgBtn && !msgBtn.disabled) {
      const targetId = msgBtn.dataset.targetId;
      if (!targetId) return;
      
      const originalText = msgBtn.textContent;
      msgBtn.textContent = 'Iniciando...';
      msgBtn.disabled = true;
      try {
        const res = await fetch('/api/conversations', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ target_profile_id: targetId })
        });
        const data = await res.json();
        if (res.ok && data.id) {
          window.location.href = `/mensajes/${data.id}`;
        } else {
          alert('Error: ' + (data.error || 'No se pudo iniciar el chat'));
          msgBtn.textContent = originalText;
          msgBtn.disabled = false;
        }
      } catch (err) {
        alert('Error conectando con el servidor.');
        msgBtn.textContent = originalText;
        msgBtn.disabled = false;
      }
      return; // Stop here if handled
    }

    // --- Add Friend Button ---
    const addBtn = target.closest('.btn-add-friend') as HTMLButtonElement;
    if (addBtn && !addBtn.disabled) {
      const targetId = addBtn.dataset.targetId;
      if (!targetId) return;
      
      const originalText = addBtn.textContent;
      addBtn.textContent = 'Enviando...';
      addBtn.disabled = true;
      try {
        const res = await fetch('/api/friends/request', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ receiver_id: targetId })
        });
        if (res.ok) {
          window.location.reload(); 
        } else {
          const data = await res.json();
          alert('Error: ' + (data.error || 'No se pudo enviar la solicitud.'));
          addBtn.textContent = originalText;
          addBtn.disabled = false;
        }
      } catch (err) {
        alert('Error conectando con el servidor.');
        addBtn.textContent = originalText;
        addBtn.disabled = false;
      }
      return; // Stop here if handled
    }

    // --- Accept Friend Request Button (on Profile) ---
    const acceptReqBtn = target.closest('.btn-accept-friend-req') as HTMLButtonElement;
    if (acceptReqBtn && !acceptReqBtn.disabled) {
      const reqId = acceptReqBtn.dataset.requestId;
      if (!reqId) return;
      
      const originalText = acceptReqBtn.textContent;
      acceptReqBtn.textContent = 'Aceptando...';
      acceptReqBtn.disabled = true;
      try {
        const res = await fetch('/api/friends/respond', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ request_id: reqId, status: 'accepted' })
        });
        if (res.ok) {
          window.location.reload();
        } else {
          alert('Error al aceptar solicitud.');
          acceptReqBtn.textContent = originalText;
          acceptReqBtn.disabled = false;
        }
      } catch (err) {
        alert('Error de conexión.');
        acceptReqBtn.textContent = originalText;
        acceptReqBtn.disabled = false;
      }
    }
  });

  // ── Open Connect Game Account Modal ──
  const openConnectModal = () => openModal('connect-game-modal');
  document.getElementById('connect-game-account-btn')?.addEventListener('click', openConnectModal);
  document.getElementById('connect-game-account-empty-btn')?.addEventListener('click', openConnectModal);

  // ── Dynamic Form Hints and Platform Options for Game Selection ──
  const gameSelect = document.getElementById('connect-game-select') as HTMLSelectElement;
  const platformSelect = document.getElementById('connect-platform-select') as HTMLSelectElement;
  const handleLabel = document.getElementById('handle-label');
  const handleInput = document.getElementById('connect-handle-input') as HTMLInputElement;
  const handleHint = document.getElementById('handle-hint');

  function updateGameFormOptions() {
    if (!gameSelect || !platformSelect) return;
    const selectedGame = gameSelect.value;
    platformSelect.innerHTML = '';

    if (selectedGame === 'Valorant' || selectedGame === 'League of Legends') {
      platformSelect.innerHTML = `
        <option value="riot">Riot Games</option>
      `;
      if (handleLabel) handleLabel.textContent = 'Riot ID (ejemplo: Mixwell#EUW)';
      if (handleInput) handleInput.placeholder = 'Nombre#Tag';
      if (handleHint) handleHint.textContent = 'Introduce tu Riot ID completo incluyendo el signo # y el Tag (ej: Sova#1234).';
    } else if (selectedGame === 'Fortnite') {
      platformSelect.innerHTML = `
        <option value="epic">Epic Games</option>
        <option value="psn">PlayStation Network (PSN)</option>
        <option value="xbl">Xbox Live</option>
      `;
      if (handleLabel) handleLabel.textContent = 'Usuario de Epic Games / PSN / Xbox';
      if (handleInput) handleInput.placeholder = 'Usuario de Epic Games o Gamertag';
      if (handleHint) handleHint.textContent = 'Introduce tu nombre de usuario público registrado en Epic Games o consola.';
    } else if (selectedGame === 'Rocket League') {
      platformSelect.innerHTML = `
        <option value="epic">Epic Games</option>
        <option value="steam">Steam</option>
        <option value="psn">PlayStation Network (PSN)</option>
        <option value="xbl">Xbox Live</option>
      `;
      if (handleLabel) handleLabel.textContent = 'ID de Epic Games / Steam / Consola';
      if (handleInput) handleInput.placeholder = 'Usuario de Epic Games o Steam ID';
      if (handleHint) handleHint.textContent = 'Introduce tu usuario de Epic Games, ID de Steam o Gamertag.';
    } else if (selectedGame === 'Apex Legends') {
      platformSelect.innerHTML = `
        <option value="origin">EA / Origin (PC)</option>
        <option value="psn">PlayStation Network (PSN)</option>
        <option value="xbl">Xbox Live</option>
      `;
      if (handleLabel) handleLabel.textContent = 'EA / Origin Handle';
      if (handleInput) handleInput.placeholder = 'Gamertag o ID de EA';
      if (handleHint) handleHint.textContent = 'Introduce tu identificador de cuenta EA, Origin, PSN o Xbox.';
    } else if (selectedGame === 'Counter-Strike 2') {
      platformSelect.innerHTML = `
        <option value="steam">Steam</option>
      `;
      if (handleLabel) handleLabel.textContent = 'Steam ID / Vanity URL';
      if (handleInput) handleInput.placeholder = 'Steam ID64 o Alias';
      if (handleHint) handleHint.textContent = 'Introduce tu identificador único de Steam o nombre personalizado de perfil.';
    } else if (selectedGame === 'Call of Duty: Warzone') {
      platformSelect.innerHTML = `
        <option value="atvi">Activision ID (Nombre#1234)</option>
        <option value="battlenet">Battle.net</option>
        <option value="psn">PlayStation Network (PSN)</option>
        <option value="xbl">Xbox Live</option>
      `;
      if (handleLabel) handleLabel.textContent = 'Activision ID / Gamertag';
      if (handleInput) handleInput.placeholder = 'Nombre#1234 o ID';
      if (handleHint) handleHint.textContent = 'Introduce tu Activision ID completo con # y los números finales.';
    } else {
      platformSelect.innerHTML = `
        <option value="origin">EA Sports / Origin</option>
        <option value="psn">PlayStation Network</option>
        <option value="xbl">Xbox Live</option>
      `;
      if (handleLabel) handleLabel.textContent = 'Gamertag o ID de Jugador';
      if (handleInput) handleInput.placeholder = 'Tu Nick / ID de usuario';
      if (handleHint) handleHint.textContent = 'Introduce tu nombre de usuario oficial en el juego.';
    }
  }

  gameSelect?.addEventListener('change', updateGameFormOptions);
  // Run once initially
  updateGameFormOptions();

  // ── Submit Connect Game Account ──
  const connectGameForm = document.getElementById('connect-game-form') as HTMLFormElement;
  if (connectGameForm) {
    connectGameForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = document.getElementById('submit-connect-game-btn') as HTMLButtonElement;
      const originalText = submitBtn.textContent;
      submitBtn.disabled = true;
      submitBtn.textContent = '⚡ Vinculando con Tracker.gg...';

      const game = gameSelect.value;
      const handle = handleInput.value.trim();
      const platform = platformSelect?.value || 'epic';
      const region = (document.getElementById('connect-region-select') as HTMLSelectElement)?.value || 'EUW';

      try {
        const res = await fetch('/api/game-accounts/connect', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ game, handle, platform, region })
        });

        const data = await res.json();
        if (res.ok && data.success) {
          alert(`¡Éxito! Cuenta de ${game} vinculada correctamente con Tracker.gg.`);
          window.location.reload();
        } else {
          alert('Error al vincular cuenta: ' + (data.error || 'No se pudo verificar la cuenta de juego.'));
          submitBtn.disabled = false;
          submitBtn.textContent = originalText;
        }
      } catch (err) {
        alert('Error conectando con el servidor de estadísticas.');
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
      }
    });
  }

  // ── Unlink Game Account Buttons ──
  document.querySelectorAll('.btn-unlink-game').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const gameName = (btn as HTMLElement).dataset.game;
      if (!gameName) return;

      if (!confirm(`¿Seguro que deseas desvincular tu cuenta de ${gameName}?`)) {
        return;
      }

      try {
        const res = await fetch('/api/game-accounts/disconnect', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ game: gameName })
        });

        if (res.ok) {
          window.location.reload();
        } else {
          const data = await res.json();
          alert('Error: ' + (data.error || 'No se pudo desvincular.'));
        }
      } catch (err) {
        alert('Error conectando con el servidor.');
      }
    });
  });
</script>
