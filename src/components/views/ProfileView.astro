---
/**
 * ProfileView.astro
 * Vista del perfil de usuario con avatar, información y estadísticas.
 */
interface Props {
  isOwnProfile?: boolean;
  user?: {
    id?: string;
    name: string;
    avatarUrl?: string;
    level: number;
    followers: number;
    gamesPlayed: number;
    description: string;
  };
}

const { 
  isOwnProfile = true,
  user = {
    name: 'Usuario Gamio',
    level: 42,
    followers: 1250,
    gamesPlayed: 340,
    description: 'Jugador competitivo de Valorant y amante de los juegos indies. Siempre buscando equipo para rankear.',
  }
} = Astro.props;
---

<div class="profile-view animate-fade-in-up">
  <!-- Cabecera de perfil -->
  <div class="profile-header">
    <div class="profile-banner"></div>
    <div class="profile-info-container">
      <div class="profile-avatar">
        {user.avatarUrl ? (
          <img src={user.avatarUrl} alt={user.name} />
        ) : (
          <span>{user.name.charAt(0).toUpperCase()}</span>
        )}
      </div>
      <div class="profile-basic-info">
        <h2 class="profile-name">{user.name}</h2>
        <p class="profile-description">{user.description}</p>
      </div>
      <div class="profile-actions">
        {isOwnProfile ? (
          <>
            <button class="btn-primary">Editar Perfil</button>
            <button class="btn-secondary">Ajustes</button>
          </>
        ) : (
          <>
            <button class="btn-primary">Añadir Amigo</button>
            <button class="btn-secondary message-btn" data-target-id={user.id}>Mensaje</button>
          </>
        )}
      </div>
    </div>
  </div>

  <!-- Estadísticas -->
  <div class="profile-stats">
    <div class="stat-card">
      <span class="stat-value text-primary">Nv. {user.level}</span>
      <span class="stat-label">Nivel Actual</span>
    </div>
    <div class="stat-card">
      <span class="stat-value text-accent">{user.gamesPlayed}</span>
      <span class="stat-label">Partidas Jugadas</span>
    </div>
    <div class="stat-card">
      <span class="stat-value text-secondary">{user.followers}</span>
      <span class="stat-label">Seguidores</span>
    </div>
  </div>

  <!-- Contenido Adicional (Mock de Juegos Recientes) -->
  <div class="profile-recent">
    <h3>Juegos Recientes</h3>
    <div class="empty-state">
      <p>Aún no hay juegos recientes para mostrar.</p>
    </div>
  </div>
</div>

<style>
  .profile-view {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    width: 100%;
  }

  /* Header */
  .profile-header {
    background: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .profile-banner {
    height: 150px;
    background: linear-gradient(135deg, rgba(124, 58, 237, 0.4), rgba(56, 189, 248, 0.4));
    width: 100%;
  }

  .profile-info-container {
    padding: 0 2rem 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 1.5rem;
    position: relative;
    margin-top: -50px;
  }

  .profile-avatar {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    border: 4px solid var(--color-surface-card);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    font-weight: 700;
    color: white;
    overflow: hidden;
    flex-shrink: 0;
  }

  .profile-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .profile-basic-info {
    flex: 1;
    min-width: 250px;
    padding-bottom: 0.5rem;
  }

  .profile-name {
    font-family: var(--font-heading);
    font-size: 1.8rem;
    margin-bottom: 0.5rem;
  }

  .profile-description {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .profile-actions {
    display: flex;
    gap: 1rem;
    padding-bottom: 0.5rem;
  }

  /* Stats */
  .profile-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }

  .stat-card {
    background: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .stat-value {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 700;
  }

  .text-primary { color: var(--color-primary); }
  .text-accent { color: var(--color-accent); }
  .text-secondary { color: var(--color-secondary); }

  .stat-label {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Recent Region */
  .profile-recent h3 {
    margin-bottom: 1rem;
    font-family: var(--font-heading);
  }

  .empty-state {
    padding: 3rem;
    text-align: center;
    background: var(--color-surface-card);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .profile-info-container {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .profile-actions {
      justify-content: center;
      width: 100%;
    }
  }
</style>

<script>
  const msgBtns = document.querySelectorAll('.message-btn');
  msgBtns.forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const targetId = (e.currentTarget as HTMLElement).dataset.targetId;
      if (!targetId) {
        alert('Este es un jugador de prueba (mock). No puedes enviarle mensajes privados porque no existe en la base de datos.');
        return;
      }

      const originalText = btn.textContent;
      btn.textContent = 'Iniciando...';
      btn.setAttribute('disabled', 'true');

      try {
        const res = await fetch('/api/conversations', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ target_profile_id: targetId })
        });
        const data = await res.json();
        
        if (res.ok && data.id) {
          window.location.href = `/mensajes/${data.id}`;
        } else {
          alert('Error: ' + (data.error || 'No se pudo iniciar el chat'));
          btn.textContent = originalText;
          btn.removeAttribute('disabled');
        }
      } catch (err) {
        console.error(err);
        alert('Error conectando con el servidor.');
        btn.textContent = originalText;
        btn.removeAttribute('disabled');
      }
    });
  });
</script>
