  .ga-rank-icon-placeholder { width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; font-size: 1.8rem; background: rgba(255,255,255,0.05); border-radius: 50%; }
  .ga-rank-name { font-family: var(--font-heading); font-size: 1.15rem; margin: 0 0 0.2rem 0; color: var(--color-primary-light); }
