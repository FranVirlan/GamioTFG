---
/**
 * MainLayout.astro — Layout principal de Gamio
 * Dual mode: sidebar+topbar for authenticated users, navbar for public pages
 */

import Navbar from '../components/Navbar.astro';
import Sidebar from '../components/Sidebar.astro';
import Topbar from '../components/Topbar.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  useSidebar?: boolean;
}

const {
  title = 'Gamio 🎮 — Tu plataforma gaming social',
  description = 'Gamio es la plataforma gaming social donde encuentras jugadores, compites y conectas con tu comunidad gamer.',
  useSidebar = false,
} = Astro.props;

const user = Astro.locals.user;
const showSidebar = useSidebar && user;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B0F1A" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts: Inter + Space Grotesk -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body class={showSidebar ? 'has-sidebar' : 'gradient-bg'}>
    {showSidebar ? (
      <>
        <Sidebar user={user} currentPath={currentPath} />
        <Topbar user={user} />
        <main class="main-with-sidebar">
          <slot />
        </main>
      </>
    ) : (
      <>
        <Navbar user={user} />
        <main>
          <slot />
        </main>
      </>
    )}
  </body>
</html>

<style>
  .has-sidebar {
    background: var(--color-bg-primary);
  }

  .main-with-sidebar {
    margin-left: var(--sidebar-width);
    padding-top: var(--topbar-height);
    min-height: 100vh;
  }

  @media (max-width: 768px) {
    .main-with-sidebar {
      margin-left: 0;
      padding-top: calc(var(--topbar-height) + 0.5rem);
    }
  }
</style>
