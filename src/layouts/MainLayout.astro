---
/**
 * MainLayout.astro — Layout principal de Gamio
 * Unified mode: Navbar everywhere
 */

import Navbar from '../components/layout/Navbar.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Gamio 🎮 — Tu plataforma gaming social',
  description = 'Gamio es la plataforma gaming social donde encuentras jugadores, compites y conectas con tu comunidad gamer.',
} = Astro.props;

const user = Astro.locals.user;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B0F1A" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts: Inter + Space Grotesk -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body class="gradient-bg" data-auth={user ? 'true' : 'false'}>
    <Navbar user={user} />
    <main class:list={['main-content', { 'no-padding': Astro.url.pathname === '/' }]}>
      <slot />
    </main>
  </body>
</html>

<style>
  .main-content {
    /* Agregamos padding-top para compensar el Navbar fijo */
    padding-top: 80px;
    min-height: 100vh;
  }

  .main-content.no-padding {
    padding-top: 0;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Intercepta todos los clics buscando la clase .requires-auth
    document.addEventListener('click', (e) => {
      const target = e.target as Element;
      const authBtn = target.closest('.requires-auth');
      
      if (authBtn) {
        const isAuthenticated = document.body.dataset.auth === 'true';
        
        if (!isAuthenticated) {
          e.preventDefault();
          e.stopPropagation();
          
          const currentPath = window.location.pathname;
          window.location.href = `/login?next=${encodeURIComponent(currentPath)}`;
        }
      }
    });
  });
</script>
