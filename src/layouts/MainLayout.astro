---
/**
 * MainLayout.astro — Layout principal de Gamio
 * Unified mode: Navbar everywhere
 */

import Navbar from '../components/layout/Navbar.astro';
import '../styles/global.css';
import { createServerClient } from '../lib/supabase';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Gamio 🎮 — Tu plataforma gaming social',
  description = 'Gamio es la plataforma gaming social donde encuentras jugadores, compites y conectas con tu comunidad gamer.',
} = Astro.props;

const user = Astro.locals.user;
let lastDailyClaim: string | null = null;
if (user) {
  try {
    const accessToken = Astro.cookies.get('sb-access-token')?.value;
    const authSupabase = createServerClient(accessToken);
    const { data: profile } = await authSupabase
      .from('profiles')
      .select('last_daily_claim')
      .eq('id', user.id)
      .single();
    lastDailyClaim = profile?.last_daily_claim || null;
  } catch (err) {
    console.error('Error fetching last_daily_claim in MainLayout:', err);
  }
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B0F1A" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts: Inter + Space Grotesk -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body class="gradient-bg" data-auth={user ? 'true' : 'false'} data-last-claim={lastDailyClaim || ''}>
    <Navbar user={user} />
    <main class:list={['main-content', { 'no-padding': Astro.url.pathname === '/' }]}>
      <slot />
    </main>

    <!-- ══════════ MODALES PERSONALIZADOS GLOBALES (GAMING GLASS) ══════════ -->
    <div id="global-alert-modal" class="alert-modal-overlay alert-hidden">
      <div class="alert-modal-content glass-strong animate-scale-in">
        <div class="alert-modal-icon" id="global-alert-icon">✨</div>
        <h3 class="alert-modal-title" id="global-alert-title">Notificación</h3>
        <p class="alert-modal-message" id="global-alert-message">Mensaje del sistema...</p>
        <button class="btn-neon alert-modal-btn" id="global-alert-close-btn">Aceptar</button>
      </div>
    </div>

    <div id="global-confirm-modal" class="alert-modal-overlay alert-hidden">
      <div class="alert-modal-content glass-strong animate-scale-in">
        <div class="alert-modal-icon confirm" id="global-confirm-icon">🛡️</div>
        <h3 class="alert-modal-title" id="global-confirm-title">Confirmar Acción</h3>
        <p class="alert-modal-message" id="global-confirm-message">¿Estás seguro de que deseas continuar?</p>
        <div class="alert-modal-actions">
          <button class="btn-secondary alert-modal-btn" id="global-confirm-cancel-btn" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.15);">Cancelar</button>
          <button class="btn-neon alert-modal-btn" id="global-confirm-confirm-btn">Confirmar</button>
        </div>
      </div>
    </div>
  </body>
</html>

<style>
  .main-content {
    /* Agregamos padding-top para compensar el Navbar fijo */
    padding-top: 80px;
    min-height: 100vh;
  }

  .main-content.no-padding {
    padding-top: 0;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Intercepta todos los clics buscando la clase .requires-auth
    document.addEventListener('click', (e) => {
      const target = e.target as Element;
      const authBtn = target.closest('.requires-auth');
      
      if (authBtn) {
        const isAuthenticated = document.body.dataset.auth === 'true';
        
        if (!isAuthenticated) {
          e.preventDefault();
          e.stopPropagation();
          
          const currentPath = window.location.pathname;
          window.location.href = `/login?next=${encodeURIComponent(currentPath)}`;
        }
      }
    });

    // --- ELEMENTOS DE ALERTA GLOBAL PERSONALIZADA ---
    const alertModal = document.getElementById('global-alert-modal') as HTMLElement;
    const alertIcon = document.getElementById('global-alert-icon') as HTMLElement;
    const alertTitle = document.getElementById('global-alert-title') as HTMLElement;
    const alertMessage = document.getElementById('global-alert-message') as HTMLElement;
    const alertCloseBtn = document.getElementById('global-alert-close-btn') as HTMLButtonElement;

    const confirmModal = document.getElementById('global-confirm-modal') as HTMLElement;
    const confirmIcon = document.getElementById('global-confirm-icon') as HTMLElement;
    const confirmTitle = document.getElementById('global-confirm-title') as HTMLElement;
    const confirmMessage = document.getElementById('global-confirm-message') as HTMLElement;
    const confirmCancelBtn = document.getElementById('global-confirm-cancel-btn') as HTMLButtonElement;
    const confirmConfirmBtn = document.getElementById('global-confirm-confirm-btn') as HTMLButtonElement;

    if (alertModal && confirmModal) {
      // Función global para mostrar alertas
      const customAlert = (message: string, title = 'Notificación', icon = '✨', type = 'info'): Promise<void> => {
        return new Promise((resolve) => {
          alertTitle.textContent = title;
          alertMessage.textContent = message;
          alertIcon.textContent = icon;
          
          alertIcon.className = 'alert-modal-icon';
          if (type === 'error') {
            alertIcon.classList.add('error');
          } else if (type === 'confirm') {
            alertIcon.classList.add('confirm');
          }

          alertModal.classList.remove('alert-hidden');

          const handleClose = () => {
            alertModal.classList.add('alert-hidden');
            alertCloseBtn.removeEventListener('click', handleClose);
            resolve();
          };
          
          alertCloseBtn.addEventListener('click', handleClose);
        });
      };

      // Función global para mostrar confirmaciones
      const customConfirm = (message: string, title = 'Confirmar Acción', icon = '🛡️'): Promise<boolean> => {
        return new Promise((resolve) => {
          confirmTitle.textContent = title;
          confirmMessage.textContent = message;
          confirmIcon.textContent = icon;
          
          confirmModal.classList.remove('alert-hidden');

          const handleCancel = () => {
            confirmModal.classList.add('alert-hidden');
            cleanup();
            resolve(false);
          };

          const handleConfirm = () => {
            confirmModal.classList.add('alert-hidden');
            cleanup();
            resolve(true);
          };

          const cleanup = () => {
            confirmCancelBtn.removeEventListener('click', handleCancel);
            confirmConfirmBtn.removeEventListener('click', handleConfirm);
          };

          confirmCancelBtn.addEventListener('click', handleCancel);
          confirmConfirmBtn.addEventListener('click', handleConfirm);
        });
      };

      // Exponerlas globalmente en window para poder invocarlas desde cualquier vista
      (window as any).showCustomAlert = customAlert;
      (window as any).showCustomConfirm = customConfirm;

      // Sobrescribir window.alert nativo de forma no-bloqueante
      window.alert = (message: any) => {
        const msgStr = String(message);
        let title = 'Notificación';
        let icon = '✨';
        let type = 'info';

        const msgLower = msgStr.toLowerCase();
        if (msgLower.includes('error') || msgLower.includes('falló') || msgLower.includes('no se pudo') || msgLower.includes('contraseña')) {
          title = '¡Oops! Algo salió mal';
          icon = '⚠️';
          type = 'error';
        } else if (msgLower.includes('felicidades') || msgLower.includes('conseguido') || msgLower.includes('reclamado') || msgLower.includes('éxito') || msgLower.includes('correcto') || msgLower.includes('actualizada')) {
          title = '¡Enhorabuena!';
          icon = '🎉';
          type = 'info';
        }

        customAlert(msgStr, title, icon, type);
      };
    }

    // --- NUEVO: AVISO DE BIENVENIDA Y TRACKER DE COOLDOWN DE RECOMPENSA DIARIA ---
    
    // 1. Mensaje de bienvenida para nuevos registros (?welcome=true)
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.has('welcome')) {
      // Limpiar el parámetro de la URL elegantemente
      const newUrl = window.location.pathname + window.location.search.replace(/[?&]welcome=true/, '').replace(/^&/, '?');
      window.history.replaceState({}, document.title, newUrl);
      
      setTimeout(() => {
        if ((window as any).showCustomAlert) {
          (window as any).showCustomAlert(
            "¡Bienvenido a la comunidad de Gamio! 🎮\n\n¿Sabías que tienes una Recompensa Diaria esperándote? Cada 24 horas puedes reclamar Puntos y XP totalmente gratis en la Tienda de Premios. ¡Úsalos para desbloquear bordes de avatar y títulos exclusivos de perfil!",
            "¡Bienvenido a Gamio! 🎉",
            "🎁",
            "info"
          );
        }
      }, 600);
    }

    // 2. Tracker del Cooldown de Recompensa Diaria (Por horas decrecientes)
    function checkDailyCooldown() {
      const lastClaimStr = document.body.dataset.lastClaim;
      // Si el usuario no tiene reclamos anteriores o no está autenticado, no hacemos nada
      if (!lastClaimStr || document.body.dataset.auth !== 'true') return;

      const lastClaim = new Date(lastClaimStr);
      const now = new Date();
      const diffTime = now.getTime() - lastClaim.getTime();
      const diffHours = diffTime / (1000 * 60 * 60);

      if (diffHours < 24) {
        const remainingTime = 24 - diffHours;
        const hoursRemainingInt = Math.ceil(remainingTime);
        
        const cachedHoursStr = localStorage.getItem('gamio_daily_cooldown_hours');
        const cachedHours = cachedHoursStr ? parseInt(cachedHoursStr, 10) : null;
        
        if (cachedHours === null) {
          // Estado inicial, guardamos las horas sin alertar para no molestar inmediatamente al iniciar sesión
          localStorage.setItem('gamio_daily_cooldown_hours', hoursRemainingInt.toString());
        } else if (hoursRemainingInt < cachedHours) {
          // El número de horas restantes ha bajado! Actualizamos y alertamos
          localStorage.setItem('gamio_daily_cooldown_hours', hoursRemainingInt.toString());
          
          setTimeout(() => {
            if ((window as any).showCustomAlert) {
              (window as any).showCustomAlert(
                `Tu Recompensa Diaria estará lista para reclamar en aproximadamente ${hoursRemainingInt} ${hoursRemainingInt === 1 ? 'hora' : 'horas'}. ¡Vuelve pronto para conseguir tus puntos y experiencia!`,
                "Recompensa en camino ⏳",
                "⏳",
                "info"
              );
            }
          }, 800);
        }
      } else {
        // La recompensa ya está disponible
        const notified = localStorage.getItem('gamio_daily_available_notified');
        if (!notified) {
          localStorage.setItem('gamio_daily_available_notified', 'true');
          localStorage.removeItem('gamio_daily_cooldown_hours'); // Reseteamos el tracker de horas
          
          setTimeout(() => {
            if ((window as any).showCustomAlert) {
              (window as any).showCustomAlert(
                "¡Tu Recompensa Diaria ya está disponible para ser reclamada! Dirígete a la Tienda de Premios para obtener tus +25 Puntos y +25 XP gratis.",
                "¡Recompensa Disponible! 🎁",
                "🎁",
                "info"
              );
            }
          }, 800);
        }
      }
    }

    if (document.body.dataset.auth === 'true') {
      // Ejecutar al cargar la página
      checkDailyCooldown();
      // Y comprobar periódicamente cada 5 minutos por si deja la pestaña abierta
      setInterval(checkDailyCooldown, 5 * 60 * 1000);
    }
  });
</script>
