---
import MainLayout from '../../layouts/MainLayout.astro';
import { createServerClient } from '../../lib/supabase';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login');
}

const accessToken = Astro.cookies.get('sb-access-token')?.value || '';
const supabase = createServerClient(accessToken);

// 1. Verificar rigurosamente que el usuario sea administrador
const { data: profile, error: profileErr } = await supabase
  .from('profiles')
  .select('is_admin')
  .eq('id', user.id)
  .single();

if (profileErr || !profile?.is_admin) {
  return Astro.redirect('/');
}

// 2. Obtener lista de reportes con datos del denunciante y denunciado
const { data: reportsData, error: reportsErr } = await supabase
  .from('reports')
  .select(`
    id,
    reason,
    details,
    chat_room,
    status,
    created_at,
    reporter:reporter_id(id, name, avatar_url),
    reported:reported_id(id, name, avatar_url, is_banned)
  `)
  .order('created_at', { ascending: false });

const reports = reportsData || [];
const reportsCount = reports.length;
const pendingCount = reports.filter(r => r.status === 'pending').length;
---

<MainLayout title="Auditoría de Incidencias y Moderación — Gamio 🛡️">
  <section class="admin-page">
    <div class="admin-header animate-fade-in-up">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <span style="font-size: 2.2rem;">🛡️</span>
        <div>
          <h1>Panel de Incidencias</h1>
          <p>Auditoría de conducta y control de suspensiones de la comunidad</p>
        </div>
      </div>
      <div class="stats-row">
        <div class="admin-stat-card">
          <span class="val">{reportsCount}</span>
          <span class="lbl">Reportes Totales</span>
        </div>
        <div class="admin-stat-card border-red">
          <span class="val text-red">{pendingCount}</span>
          <span class="lbl">Pendientes</span>
        </div>
      </div>
    </div>

    {reportsCount === 0 ? (
      <div class="empty-state animate-fade-in-up">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
        <h3>¡Comunidad limpia!</h3>
        <p>No se han registrado reportes ni incidencias de conducta hasta el momento.</p>
      </div>
    ) : (
      <div class="admin-grid animate-fade-in-up">
        <!-- Listado de Reportes (Izquierda) -->
        <div class="reports-sidebar">
          <h3>Listado de Denuncias</h3>
          <div class="reports-list">
            {reports.map((rep) => {
              const reporterName = rep.reporter?.name || 'Desconocido';
              const reportedName = rep.reported?.name || 'Desconocido';
              const statusClass = `status-${rep.status}`;
              const isBanned = rep.reported?.is_banned;
              
              let reasonLabel = 'Otro motivo';
              if (rep.reason === 'chat_abuse') reasonLabel = 'Insultos/Acoso Chat';
              if (rep.reason === 'gameplay_abuse') reasonLabel = 'Mala conducta/Trampas';
              if (rep.reason === 'spam') reasonLabel = 'Spam/Molestias';

              return (
                <div 
                  class={`report-card ${rep.status === 'pending' ? 'active-pending' : ''}`} 
                  data-report-id={rep.id}
                  data-reported-id={rep.reported?.id}
                  data-reported-name={reportedName}
                  data-reported-banned={isBanned ? 'true' : 'false'}
                  data-reporter-name={reporterName}
                  data-reason={reasonLabel}
                  data-details={rep.details}
                  data-room={rep.chat_room || 'No especificada'}
                  data-status={rep.status}
                >
                  <div class="card-head">
                    <span class={`status-badge ${statusClass}`}>{rep.status.toUpperCase()}</span>
                    {isBanned && <span class="banned-badge">SUSPENDIDO</span>}
                  </div>
                  <h4 style="margin: 0.5rem 0 0.25rem;">{reportedName}</h4>
                  <p class="desc">Reportado por: <strong>{reporterName}</strong></p>
                  <div class="card-footer">
                    <span class="reason-tag">{reasonLabel}</span>
                    <span class="time">{new Date(rep.created_at).toLocaleDateString('es-ES', { day: '2-digit', month: 'short' })}</span>
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        <!-- Visor y Auditoría (Derecha) -->
        <div class="auditor-panel" id="auditor-panel">
          <div class="auditor-placeholder" id="auditor-placeholder">
            <span style="font-size: 3rem;">🔍</span>
            <h3>Auditor de Incidencias</h3>
            <p>Selecciona una denuncia de la lista para auditar el historial de chats del jugador y aplicar sanciones en vivo.</p>
          </div>

          <div class="auditor-content hidden" id="auditor-content">
            <div class="auditor-header">
              <div>
                <h2 id="auditor-title">Jugador</h2>
                <p id="auditor-subtitle">Reportado por ...</p>
              </div>
              <div id="auditor-actions" style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                <button class="btn-primary" id="btn-resolve" style="background: rgba(34, 197, 94, 0.15); border-color: rgba(34, 197, 94, 0.3); color: #4ade80;">Resolver</button>
                <button class="btn-secondary" id="btn-dismiss">Desestimar</button>
                <button class="btn-danger" id="btn-ban" style="background: #ef4444; border-color: rgba(239, 68, 68, 0.4); box-shadow: 0 4px 15px rgba(239, 68, 68, 0.25);">Suspender Cuenta 🚫</button>
              </div>
            </div>

            <!-- Información General del Reporte -->
            <div class="report-info-box">
              <div class="info-row">
                <strong>Sala/Contexto:</strong>
                <span id="info-room">...</span>
              </div>
              <div class="info-row" style="flex-direction: column; align-items: flex-start; gap: 0.25rem;">
                <strong>Detalles de la Denuncia:</strong>
                <p id="info-details" class="details-box">...</p>
              </div>
            </div>

            <!-- Auditoría de Chats en Tiempo Real -->
            <div class="chat-auditor-section">
              <h3>💬 Historial de Chats Recientes (Auditoría en Vivo)</h3>
              <p class="help-text">Visualiza los últimos 15 mensajes del jugador en salas públicas para validar si hubo abuso de lenguaje.</p>
              <div class="audit-messages-list" id="audit-messages-list">
                <div class="loader">Consultando base de datos...</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    )}
  </section>
</MainLayout>

<style>
  .admin-page {
    padding: 2rem;
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    min-height: calc(100vh - 120px);
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .admin-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 1.5rem;
  }

  .admin-header h1 {
    font-family: var(--font-heading);
    font-size: 2rem;
    margin: 0 0 0.25rem 0;
  }

  .admin-header p {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    margin: 0;
  }

  .stats-row {
    display: flex;
    gap: 1rem;
  }

  .admin-stat-card {
    background: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0.75rem 1.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    min-width: 140px;
  }

  .admin-stat-card .val {
    font-family: var(--font-heading);
    font-size: 1.8rem;
    font-weight: 700;
  }

  .admin-stat-card .lbl {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .border-red {
    border-color: rgba(239, 68, 68, 0.3);
  }

  .text-red {
    color: #f87171;
  }

  /* Grid del Panel */
  .admin-grid {
    display: grid;
    grid-template-columns: 350px 1fr;
    gap: 2rem;
    height: 600px;
    align-items: stretch;
  }

  /* Sidebar Izquierda */
  .reports-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: rgba(11, 15, 26, 0.4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    overflow: hidden;
  }

  .reports-sidebar h3 {
    margin: 0 0 0.5rem 0;
    font-size: 1.1rem;
    font-family: var(--font-heading);
    color: var(--color-text-primary);
  }

  .reports-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    overflow-y: auto;
    padding-right: 0.25rem;
    flex: 1;
  }

  .reports-list::-webkit-scrollbar { width: 5px; }
  .reports-list::-webkit-scrollbar-thumb { background: var(--color-border); border-radius: 10px; }

  .report-card {
    background: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .report-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-primary);
  }

  .report-card.selected {
    border-color: var(--color-accent);
    box-shadow: 0 0 15px rgba(0, 240, 255, 0.15);
    background: rgba(0, 240, 255, 0.02);
  }

  .card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .status-badge {
    font-size: 0.65rem;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  .status-pending { background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); }
  .status-resolved { background: rgba(34, 197, 94, 0.15); color: #4ade80; border: 1px solid rgba(34, 197, 94, 0.3); }
  .status-dismissed { background: rgba(148, 163, 184, 0.15); color: #94a3b8; border: 1px solid rgba(148, 163, 184, 0.3); }

  .banned-badge {
    background: #ef4444;
    color: white;
    font-size: 0.6rem;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  .report-card h4 {
    color: var(--color-text-primary);
  }

  .report-card .desc {
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    margin: 0.25rem 0 0.5rem 0;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
  }

  .reason-tag {
    background: rgba(255, 255, 255, 0.05);
    color: var(--color-text-secondary);
    padding: 2px 8px;
    border-radius: 100px;
    border: 1px solid var(--color-border);
  }

  .report-card .time {
    color: var(--color-text-muted);
  }

  /* Panel Derecho (Auditor) */
  .auditor-panel {
    background: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .auditor-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 4rem 2rem;
    flex: 1;
    color: var(--color-text-muted);
  }

  .auditor-placeholder h3 {
    color: var(--color-text-secondary);
    margin: 1rem 0 0.5rem 0;
    font-family: var(--font-heading);
  }

  .auditor-placeholder p {
    max-width: 400px;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .auditor-content {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }

  .auditor-header {
    padding: 1.5rem 2rem;
    border-bottom: 1px solid var(--color-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .auditor-header h2 {
    margin: 0 0 0.25rem 0;
    font-family: var(--font-heading);
    font-size: 1.4rem;
  }

  .auditor-header p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  .report-info-box {
    padding: 1.5rem 2rem;
    background: rgba(11, 15, 26, 0.3);
    border-bottom: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .info-row {
    display: flex;
    font-size: 0.9rem;
    gap: 0.5rem;
  }

  .info-row strong {
    color: var(--color-text-secondary);
    min-width: 130px;
  }

  .details-box {
    width: 100%;
    background: rgba(11, 15, 26, 0.6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.75rem 1rem;
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-text-primary);
  }

  /* Chat Auditor Section */
  .chat-auditor-section {
    padding: 1.5rem 2rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    gap: 0.5rem;
  }

  .chat-auditor-section h3 {
    margin: 0;
    font-size: 1rem;
    font-family: var(--font-heading);
    color: var(--color-text-primary);
  }

  .chat-auditor-section .help-text {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin: 0 0 0.5rem 0;
  }

  .audit-messages-list {
    flex: 1;
    overflow-y: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: rgba(11, 15, 26, 0.5);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .audit-messages-list::-webkit-scrollbar { width: 5px; }
  .audit-messages-list::-webkit-scrollbar-thumb { background: var(--color-border); border-radius: 10px; }

  .audit-msg-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    animation: fadeIn 0.2s ease-out;
  }

  .audit-msg-head {
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    color: var(--color-text-muted);
  }

  .audit-msg-bubble {
    background: rgba(43, 53, 76, 0.4);
    border: 1px solid var(--color-border-light, rgba(255,255,255,0.05));
    border-radius: 8px;
    padding: 0.5rem 0.75rem;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    max-width: 90%;
    line-height: 1.3;
  }

  .loader {
    text-align: center;
    padding: 2rem;
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .empty-chat {
    text-align: center;
    padding: 3rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .hidden {
    display: none !important;
  }

  /* Empty state */
  .empty-state {
    text-align: center;
    padding: 5rem 2rem;
    background: var(--color-surface-card);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--color-text-muted);
  }

  .empty-state h3 {
    color: var(--color-text-secondary);
    margin: 1rem 0 0.5rem 0;
    font-family: var(--font-heading);
  }

  .empty-state p {
    font-size: 0.95rem;
  }

  @media (max-width: 992px) {
    .admin-grid {
      grid-template-columns: 1fr;
      height: auto;
    }
    .reports-sidebar {
      height: 350px;
    }
  }
</style>

<script>
  import { supabase } from '../../lib/supabase';

  let selectedReportId: string | null = null;
  let selectedReportedId: string | null = null;
  let selectedReportedName: string | null = null;

  function initIncidencias() {
    const reportsListContainer = document.querySelector('.reports-list');
    const placeholder = document.getElementById('auditor-placeholder');
    const content = document.getElementById('auditor-content');

    const titleEl = document.getElementById('auditor-title');
    const subtitleEl = document.getElementById('auditor-subtitle');
    const roomEl = document.getElementById('info-room');
    const detailsEl = document.getElementById('info-details');
    const messageList = document.getElementById('audit-messages-list');

    const btnResolve = document.getElementById('btn-resolve') as HTMLButtonElement | null;
    const btnDismiss = document.getElementById('btn-dismiss') as HTMLButtonElement | null;
    const btnBan = document.getElementById('btn-ban') as HTMLButtonElement | null;

    if (!reportsListContainer) return;

    // ── Delegación de eventos para las tarjetas de reporte ──
    const onCardClick = async (e: Event) => {
      const target = e.target as HTMLElement;
      const card = target.closest('.report-card') as HTMLElement | null;
      if (!card) return;

      // Remover selecciones anteriores
      document.querySelectorAll('.report-card').forEach(c => c.classList.remove('selected'));
      card.classList.add('selected');

      const reportId = card.dataset.reportId || '';
      const reportedId = card.dataset.reportedId || '';
      const reportedName = card.dataset.reportedName || '';
      const reporterName = card.dataset.reporterName || '';
      const reason = card.dataset.reason || '';
      const details = card.dataset.details || '';
      const room = card.dataset.room || '';
      const isBanned = card.dataset.reportedBanned === 'true';

      selectedReportId = reportId;
      selectedReportedId = reportedId;
      selectedReportedName = reportedName;

      // Ocultar placeholder y mostrar contenido
      placeholder?.classList.add('hidden');
      content?.classList.remove('hidden');

      // Asignar datos del reporte a la UI
      if (titleEl) titleEl.textContent = `Auditoría: ${reportedName}`;
      if (subtitleEl) subtitleEl.textContent = `Reportado por ${reporterName} • Motivo: ${reason}`;
      if (roomEl) roomEl.textContent = room;
      if (detailsEl) detailsEl.textContent = details;

      // Configurar estado del botón de baneo
      if (btnBan) {
        btnBan.textContent = isBanned ? 'Quitar Suspensión 🟢' : 'Suspender Cuenta 🚫';
        btnBan.style.background = isBanned ? 'rgba(34, 197, 94, 0.15)' : '#ef4444';
        btnBan.style.borderColor = isBanned ? 'rgba(34, 197, 94, 0.3)' : 'rgba(239, 68, 68, 0.4)';
        btnBan.style.color = isBanned ? '#4ade80' : 'white';
      }

      // ── Cargar historial de chats del reportado ──
      if (messageList) {
        messageList.innerHTML = '<div class="loader">Consultando base de datos...</div>';
        
        try {
          const { data: messages, error } = await supabase
            .from('messages')
            .select('content, room, created_at')
            .eq('profile_id', reportedId)
            .order('created_at', { ascending: false })
            .limit(15);

          if (error) throw error;

          if (!messages || messages.length === 0) {
            messageList.innerHTML = '<div class="empty-chat">El jugador no ha enviado ningún mensaje de chat público recientemente.</div>';
          } else {
            messageList.innerHTML = '';
            messages.forEach(msg => {
              const msgTime = new Date(msg.created_at).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });
              const msgDate = new Date(msg.created_at).toLocaleDateString('es-ES', { day: '2-digit', month: '2-digit' });
              
              const item = document.createElement('div');
              item.className = 'audit-msg-item';
              item.innerHTML = `
                <div class="audit-msg-head">
                  <span>Sala: #${msg.room || 'global'}</span>
                  <span>${msgDate} - ${msgTime}</span>
                </div>
                <div class="audit-msg-bubble">${msg.content}</div>
              `;
              messageList.appendChild(item);
            });
          }
        } catch (err) {
          console.error('Error fetching audited chats:', err);
          messageList.innerHTML = '<div class="loader" style="color: #f87171;">Error al consultar el historial de chats de Supabase.</div>';
        }
      }
    };

    reportsListContainer.removeEventListener('click', onCardClick);
    reportsListContainer.addEventListener('click', onCardClick);

    // ── BOTÓN: Resolver Incidencia ──
    const onResolveClick = async () => {
      if (!selectedReportId || !btnResolve) return;
      btnResolve.disabled = true;
      btnResolve.textContent = 'Resolviendo...';

      try {
        const res = await fetch('/api/reports', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ report_id: selectedReportId, status: 'resolved' })
        });

        if (res.ok) {
          window.location.reload();
        } else {
          alert('Error al resolver la incidencia.');
          btnResolve.disabled = false;
          btnResolve.textContent = 'Resolver';
        }
      } catch (err) {
        alert('Error de conexión.');
        btnResolve.disabled = false;
        btnResolve.textContent = 'Resolver';
      }
    };
    btnResolve?.removeEventListener('click', onResolveClick);
    btnResolve?.addEventListener('click', onResolveClick);

    // ── BOTÓN: Desestimar Incidencia ──
    const onDismissClick = async () => {
      if (!selectedReportId || !btnDismiss) return;
      btnDismiss.disabled = true;
      btnDismiss.textContent = 'Desestimando...';

      try {
        const res = await fetch('/api/reports', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ report_id: selectedReportId, status: 'dismissed' })
        });

        if (res.ok) {
          window.location.reload();
        } else {
          alert('Error al desestimar la incidencia.');
          btnDismiss.disabled = false;
          btnDismiss.textContent = 'Desestimar';
        }
      } catch (err) {
        alert('Error de conexión.');
        btnDismiss.disabled = false;
        btnDismiss.textContent = 'Desestimar';
      }
    };
    btnDismiss?.removeEventListener('click', onDismissClick);
    btnDismiss?.addEventListener('click', onDismissClick);

    // ── BOTÓN: Banear / Suspender Cuenta ──
    const onBanClick = async () => {
      if (!selectedReportedId || !selectedReportedName || !btnBan) return;
      
      const card = document.querySelector(`.report-card[data-reported-id="${selectedReportedId}"]`) as HTMLElement | null;
      if (!card) return;
      const isCurrentlyBanned = card.dataset.reportedBanned === 'true';
      const actionText = isCurrentlyBanned ? 'levantar la suspensión de' : 'SUSPENDER indefinidamente a';

      const confirmed = confirm(`¿Estás seguro de que deseas ${actionText} al jugador ${selectedReportedName}?`);
      if (!confirmed) return;

      btnBan.disabled = true;
      btnBan.textContent = 'Procesando...';

      try {
        const res = await fetch('/api/admin/ban', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ target_profile_id: selectedReportedId, banned: !isCurrentlyBanned })
        });

        if (res.ok) {
          alert(isCurrentlyBanned ? `¡Se ha levantado la suspensión de ${selectedReportedName}!` : `¡El jugador ${selectedReportedName} ha sido suspendido!`);
          window.location.reload();
        } else {
          alert('Error al procesar el baneo en el servidor.');
          btnBan.disabled = false;
          btnBan.textContent = isCurrentlyBanned ? 'Quitar Suspensión 🟢' : 'Suspender Cuenta 🚫';
        }
      } catch (err) {
        alert('Error de conexión.');
        btnBan.disabled = false;
        btnBan.textContent = isCurrentlyBanned ? 'Quitar Suspensión 🟢' : 'Suspender Cuenta 🚫';
      }
    };
    btnBan?.removeEventListener('click', onBanClick);
    btnBan?.addEventListener('click', onBanClick);
  }

  // Inicializar inmediatamente al cargar el script en el navegador
  initIncidencias();

  // Inicializar en cada navegación con View Transitions de Astro
  document.addEventListener('astro:page-load', initIncidencias);
</script>
