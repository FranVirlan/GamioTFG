---
/**
 * index.astro — Landing Page de Gamio
 * Gaming social platform - Discord + Steam + Twitch aesthetic
 */
import MainLayout from '../layouts/MainLayout.astro';
import Footer from '../components/layout/Footer.astro';
import { supabase } from '../lib/supabase';

// Fetch real-time player count from DB
const { count: totalPlayers } = await supabase
  .from('profiles')
  .select('*', { count: 'exact', head: true });

const playerCount = totalPlayers || 0;

// Array dinámico de juegos para el carrusel
const carouselGames = [
  { title: 'League of Legends', img: 'https://images.igdb.com/igdb/image/upload/t_cover_big/co49wj.jpg' },
  { title: 'Valorant', img: 'https://images.igdb.com/igdb/image/upload/t_cover_big/co2mvt.jpg' },
  { title: 'EA FC 25', img: 'https://steamcdn-a.akamaihd.net/steam/apps/2669320/library_600x900.jpg' },
  { title: 'Dead By Daylight', img: 'https://steamcdn-a.akamaihd.net/steam/apps/381210/library_600x900.jpg' },
  { title: 'Call of Duty: Warzone', img: 'https://steamcdn-a.akamaihd.net/steam/apps/1962663/library_600x900.jpg' },
  { title: 'Rocket League', img: 'https://steamcdn-a.akamaihd.net/steam/apps/252950/library_600x900.jpg' },
  { title: 'Fortnite', img: 'https://upload.wikimedia.org/wikipedia/en/a/ae/Fortnite_Save_The_World.jpg' },
  { title: 'Apex Legends', img: 'https://steamcdn-a.akamaihd.net/steam/apps/1172470/library_600x900.jpg' }
];
---

<MainLayout title="Gamio 🎮 — La plataforma gaming social">
  <!-- Hero Section -->
  <section class="hero" id="hero">
    <video class="hero-video" autoplay muted loop playsinline preload="auto">
      <source src="/hero-bg.mp4" type="video/mp4" />
    </video>
    <div class="hero-overlay"></div>
    
    <div class="container hero-content">
      <h1 class="hero-title animate-fade-in-up">
        BUSCA, AGREGA Y <br />
        <span class="gradient-text-cyan">JUEGA</span>
      </h1>
      <p class="hero-subtitle animate-fade-in-up" style="animation-delay: 0.1s;">
        La red social definitiva para gamers que buscan compañeros de equipo, formar escuadrones y conectar con la comunidad. Si estás cansado de jugar solo, este es tu lugar.
      </p>
      <div class="hero-actions animate-fade-in-up" style="animation-delay: 0.2s;">
        <a href="/signup" class="btn-primary hero-btn-primary">
          ÚNETE AHORA
        </a>
      </div>
    </div>
    
    <!-- Game Posters Decoration -->
    <div class="hero-games-deco animate-fade-in-up" style="animation-delay: 0.4s;">
      <div class="game-poster-sm" style="background-image: url('https://images.igdb.com/igdb/image/upload/t_cover_big/co49wj.jpg');" title="League of Legends"></div>
      <div class="game-poster-sm" style="background-image: url('https://steamcdn-a.akamaihd.net/steam/apps/381210/library_600x900.jpg');" title="Dead By Daylight"></div>
      <div class="game-poster-sm" style="background-image: url('https://images.igdb.com/igdb/image/upload/t_cover_big/co2mvt.jpg');" title="Valorant"></div>
      <div class="game-poster-sm" style="background-image: url('https://steamcdn-a.akamaihd.net/steam/apps/2669320/library_600x900.jpg');" title="EA FC 25"></div>
      <div class="game-poster-sm more-games-card">
        <span class="gradient-text font-heading text-xl font-bold">Y MUCHOS<br>MÁS...</span>
      </div>
    </div>
  </section>

  <!-- Games Section -->
  <section class="games-section">
    <div class="container">
      <h2 class="section-title">NUESTROS <span class="gradient-text">JUEGOS</span></h2>
      <div class="games-carousel" id="games-carousel-track">
        {carouselGames.map((game) => (
          <div class="game-poster" style={`background-image: url('${game.img}');`} title={game.title}></div>
        ))}
      </div>
      <div class="carousel-controls">
        <button class="nav-arrow" id="btn-prev-game" title="Anterior">←</button>
        <button class="nav-arrow" id="btn-next-game" title="Siguiente">→</button>
      </div>
    </div>
  </section>

  <!-- How It Works (Timeline Style) -->
  <section class="how-section-torneum">
    <div class="container">
      <div class="how-header">
        <h2 class="section-title banner-title">CÓMO FUNCIONA GAMIO</h2>
      </div>
      <div class="how-split">
        <div class="how-image">
          <!-- The image will fade between steps -->
          <div class="setup-img-placeholder" id="timeline-image" style="background-image: url('https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=2070&auto=format&fit=crop'); background-size: cover; background-position: center; transition: background-image 0.5s ease-in-out;"></div>
        </div>
        <div class="how-timeline-wrapper" style="display: flex; flex-direction: column; align-items: flex-start;">
          <div class="how-timeline" id="how-timeline">
            <!-- Pill that slides down the track -->
            <div class="timeline-sliding-pill" id="timeline-sliding-pill"></div>
            
            <div class="timeline-step js-timeline-step" data-index="0">
              <div class="timeline-dot"></div>
              <div class="timeline-content">
                <h3>Encuentra a tu equipo ideal</h3>
                <p>Busca jugadores según tu nivel, idioma y estilo de juego.</p>
              </div>
            </div>
            <div class="timeline-step js-timeline-step" data-index="1">
              <div class="timeline-dot"></div>
              <div class="timeline-content">
                <h3>Crea o únete a comunidades</h3>
                <p>Participa en grupos dedicados exclusivamente a tus juegos favoritos.</p>
              </div>
            </div>
            <div class="timeline-step js-timeline-step" data-index="2">
              <div class="timeline-dot"></div>
              <div class="timeline-content">
                <h3>Organiza partidas al instante</h3>
                <p>Usa el chat integrado para coordinar y empezar a jugar sin esperas.</p>
              </div>
            </div>
            <div class="timeline-step js-timeline-step" data-index="3" style="margin-bottom: 0;">
              <div class="timeline-dot"></div>
              <div class="timeline-content">
                <h3>Sube de nivel y gana reputación</h3>
                <p>Recibe valoraciones positivas y destaca como el mejor compañero.</p>
              </div>
            </div>
          </div>
          <a href="/signup" class="btn-primary" style="margin-top: 3rem; align-self: flex-start;">ENCUENTRA TU EQUIPO</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Giant Stats Section -->
  <section class="stats-torneum">
    <div class="container">
      <h2 class="section-title" style="text-align: center; margin-bottom: 3rem; font-size: 2.5rem;">Nuestras estadísticas en <span class="gradient-text">tiempo real</span></h2>
      <div class="stats-grid-giant">
        <div class="stat-giant">
          <span class="stat-num-neon" id="realtime-player-count">{playerCount > 0 ? `+${playerCount}` : '0'}</span>
          <span class="stat-label-torneum">Jugadores activos</span>
        </div>
        <div class="stat-giant">
          <span class="stat-num-neon">+{carouselGames.length}</span>
          <span class="stat-label-torneum">Juegos soportados</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="testimonials-section">
    <div class="container">
      <h2 class="section-title" style="text-align: center;">LO QUE DICEN <span class="gradient-text-cyan">NUESTROS JUGADORES</span></h2>
      <div class="testimonials-grid">
        <div class="testi-card">
          <div class="testi-quote">"Gracias a Gamio encontré a mi equipo actual de Valorant. Pasamos de bronce a diamante en un mes."</div>
          <div class="testi-author">
            <div class="avatar-placeholder"></div>
            <div>
              <strong>@SniperPro</strong>
              <span>Jugador de Valorant</span>
            </div>
          </div>
        </div>
        <div class="testi-card">
          <div class="testi-quote">"La mejor plataforma para encontrar gente rápido. Siempre hay jugadores activos y el ambiente es brutal."</div>
          <div class="testi-author">
            <div class="avatar-placeholder"></div>
            <div>
              <strong>@AlexGamer</strong>
              <span>Jugador de FC 25</span>
            </div>
          </div>
        </div>
        <div class="testi-card">
          <div class="testi-quote">"El sistema de chat y comunidades es increíble. Es como tener Discord pero integrado directamente con el matchmaking."</div>
          <div class="testi-author">
            <div class="avatar-placeholder"></div>
            <div>
              <strong>@Marta10</strong>
              <span>Jugadora de LoL</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Marquee Section -->
  <div class="marquee-container">
    <div class="marquee-content">
      <span>DONDE JUEGAN LOS MEJORES • ÚNETE A LA REVOLUCIÓN • ENCUENTRA TU EQUIPO • DONDE JUEGAN LOS MEJORES • ÚNETE A LA REVOLUCIÓN • ENCUENTRA TU EQUIPO •</span>
    </div>
  </div>

  <Footer />
</MainLayout>

<style>
  /* ── Hero Torneum Style ── */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center; /* Center content vertically now that navbar is transparent */
    overflow: hidden;
  }

  .hero-video {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    object-fit: cover;
    z-index: 0;
    filter: brightness(0.45) saturate(1.2) hue-rotate(-10deg);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 50% 40%, rgba(108, 58, 255, 0.12), transparent 55%),
      linear-gradient(to top, var(--color-bg-primary) 0%, rgba(10, 14, 23, 0.5) 35%, transparent 100%);
    z-index: 1;
  }

  .hero-content {
    text-align: center;
    position: relative;
    z-index: 2;
    padding: 0 1rem;
    max-width: 900px;
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 900; /* Black weight */
    line-height: 1;
    letter-spacing: -0.02em;
    margin-bottom: 2rem;
    color: var(--color-text-primary);
  }

  .hero-subtitle {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: var(--color-text-primary);
    max-width: 700px;
    margin: 0 auto 3rem;
    line-height: 1.6;
    opacity: 0.9;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 4rem;
  }

  .hero-btn-primary {
    padding: 1rem 3rem;
    font-size: 1.1rem;
    letter-spacing: 1px;
    box-shadow: 0 0 30px rgba(108, 58, 255, 0.4);
  }

  .hero-btn-primary:hover {
    box-shadow: 0 0 40px rgba(108, 58, 255, 0.6);
  }

  /* ── Game Posters Deco Hero (Fanned View) ── */
  .hero-games-deco {
    position: absolute;
    bottom: -15px; 
    left: 0;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    z-index: 10;
  }

  .game-poster-sm {
    width: 160px;
    height: 180px;
    border-radius: 20px;
    background-size: cover;
    background-position: center;
    background-color: var(--color-surface-card);
    box-shadow: 0 -5px 25px rgba(0,0,0,0.6);
    margin: 0 -15px; /* Perfect overlap */
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    cursor: pointer;
  }

  /* Rotations and positions to match the exact photo fan */
  .game-poster-sm:nth-child(1) {
    transform: rotate(-14deg) translateY(40px) translateX(10px);
    z-index: 1;
  }
  .game-poster-sm:nth-child(2) {
    transform: rotate(-7deg) translateY(10px) translateX(5px);
    z-index: 2;
  }
  .game-poster-sm:nth-child(3) {
    transform: rotate(0deg) translateY(-10px) scale(1.15);
    z-index: 3;
    box-shadow: 0 -10px 40px rgba(0,0,0,0.9), inset 0 0 0 2px rgba(255,255,255,0.15);
  }
  .game-poster-sm:nth-child(4) {
    transform: rotate(7deg) translateY(10px) translateX(-5px);
    z-index: 2;
  }
  .game-poster-sm:nth-child(5) {
    transform: rotate(14deg) translateY(40px) translateX(-10px);
    z-index: 1;
  }

  .game-poster-sm:hover {
    z-index: 10 !important;
    transform: translateY(-40px) scale(1.25) rotate(0deg) !important;
    box-shadow: 0 30px 60px rgba(0,0,0,0.8), inset 0 0 0 2px var(--color-primary);
  }

  .more-games-card {
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(15, 20, 31, 0.9), rgba(10, 14, 23, 0.95));
    border: 2px dashed rgba(255, 60, 172, 0.5);
    text-align: center;
    backdrop-filter: blur(10px);
  }

  .more-games-card span {
    line-height: 1.2;
    text-shadow: 0 0 15px rgba(255, 60, 172, 0.4);
  }

  .placeholder-text {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 0.9rem;
    color: white;
    text-shadow: 0 2px 4px rgba(0,0,0,0.8);
  }

  .hero-orb-1 {
    width: 500px;
    height: 500px;
    background: rgba(124, 58, 237, 0.15);
    top: -200px;
    right: -100px;
    animation: float 8s ease-in-out infinite;
  }

  .hero-orb-2 {
    width: 400px;
    height: 400px;
    background: rgba(56, 189, 248, 0.1);
    bottom: -150px;
    left: -100px;
    animation: float 10s ease-in-out infinite reverse;
  }

  .hero-orb-3 {
    width: 300px;
    height: 300px;
    background: rgba(34, 197, 94, 0.08);
    top: 40%;
    left: 50%;
    transform: translateX(-50%);
  }

  .hero-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(124, 58, 237, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(124, 58, 237, 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse at center, black 30%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 70%);
    pointer-events: none;
  }

  /* ── Testimonials ── */
  .testimonials-section {
    padding: 6rem 0;
    background: var(--color-bg-primary);
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 3rem;
  }

  .testi-card {
    background: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 250px;
  }

  .testi-quote {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--color-text-primary);
    font-style: italic;
    margin-bottom: 2rem;
    position: relative;
  }
  .testi-quote::before {
    content: '"';
    font-family: serif;
    font-size: 4rem;
    position: absolute;
    top: -20px; left: -15px;
    color: rgba(0, 240, 255, 0.1);
    z-index: 0;
  }

  .testi-author {
    display: flex;
    align-items: center;
    gap: 1rem;
    border-top: 1px solid var(--color-border-light);
    padding-top: 1.5rem;
  }

  .avatar-placeholder {
    width: 45px; height: 45px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
  }

  .testi-author strong {
    display: block;
    color: white;
    font-size: 1rem;
  }
  .testi-author span {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }

  /* ── Marquee ── */
  .marquee-container {
    background: linear-gradient(90deg, var(--color-accent), var(--color-accent-light));
    padding: 1.5rem 0;
    overflow: hidden;
    position: relative;
    transform: rotate(-2deg) scale(1.05); /* Slight slant like Torneum */
    box-shadow: 0 10px 30px rgba(255, 60, 172, 0.2);
    z-index: 10;
    margin-top: -2rem; /* Fix spacing after slant */
    margin-bottom: 5rem;
  }

  .marquee-content {
    white-space: nowrap;
    animation: marquee 20s linear infinite;
  }

  .marquee-content span {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: 1.5rem;
    color: black;
    letter-spacing: 2px;
  }

  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @media (max-width: 768px) {
    .testimonials-grid { grid-template-columns: 1fr; }
  }

  /* ── Typography & Titles ── */
  .section-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 900;
    text-transform: uppercase;
    color: white;
    letter-spacing: -0.02em;
    margin-bottom: 2rem;
  }

  /* ── Games Section ── */
  .games-section {
    padding: 6rem 0;
    background: var(--color-bg-primary);
  }

  .games-carousel {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    padding-bottom: 2rem;
    scroll-snap-type: x mandatory;
    scrollbar-width: none; /* Firefox */
  }
  .games-carousel::-webkit-scrollbar {
    display: none; /* Safari/Chrome */
  }

  .game-poster {
    min-width: 200px;
    height: 280px;
    background-color: var(--color-surface-card);
    border-radius: var(--radius-lg);
    background-size: cover;
    background-position: center;
    scroll-snap-align: start;
    transition: transform 0.3s ease;
  }
  .game-poster:hover {
    transform: translateY(-10px);
  }

  .carousel-controls {
    display: flex;
    justify-content: flex-end;
    gap: 1rem;
    margin-top: -1rem;
  }

  .nav-arrow {
    width: 40px; height: 40px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    background: transparent;
    color: white;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: all 0.2s ease;
  }
  .nav-arrow:hover {
    background: rgba(255,255,255,0.1);
  }

  /* ── How It Works (Timeline) ── */
  .how-section-torneum {
    padding: 4rem 0 6rem;
  }

  .how-header {
    background: var(--color-secondary);
    padding: 1.5rem 3rem;
    border-radius: 0 50px 50px 0;
    display: inline-block;
    margin-bottom: 4rem;
    margin-left: -5vw;
  }

  .banner-title {
    margin-bottom: 0;
    font-size: clamp(1.5rem, 4vw, 2.5rem);
  }

  .how-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .setup-img-placeholder {
    width: 100%;
    aspect-ratio: 4/3;
    background: linear-gradient(135deg, var(--color-surface-hover), var(--color-surface-card));
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
  }

  .how-timeline {
    position: relative;
    padding-left: 2rem;
    padding-bottom: 1rem;
  }

  .how-timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 5px;  /* Starts slightly lower to perfectly match first dot */
    bottom: 1rem; /* Ends well before the button */
    width: 2px;
    background: var(--color-border-light);
  }

  /* Single pill that slides up and down */
  .timeline-sliding-pill {
    position: absolute;
    left: 0;
    top: -0.2rem;
    width: 8px;
    height: 44px;
    border-radius: 12px;
    background: var(--color-accent);
    box-shadow: 0 0 16px rgba(255, 60, 172, 0.6);
    transform: translateX(-50%);
    z-index: 3;
    transition: top 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .timeline-step {
    position: relative;
    margin-bottom: 2.5rem;
    cursor: pointer;
  }

  .timeline-dot {
    position: absolute;
    left: -2rem;
    top: 0.25rem;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-border-light);
    transform: translateX(-50%);
    z-index: 2;
  }


  .timeline-content {
    transition: opacity 0.3s ease;
    opacity: 0.5;
  }
  
  .timeline-step.active .timeline-content {
    opacity: 1;
  }

  .timeline-content h3 {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: white;
  }
  .timeline-content p {
    color: var(--color-text-secondary);
  }

  .mt-4 { margin-top: 2rem; }

  /* ── Stats Giant ── */
  .stats-torneum {
    padding: 6rem 0;
    background: linear-gradient(to bottom, var(--color-bg-secondary), var(--color-bg-primary));
  }

  .stats-grid-giant {
    display: flex;
    justify-content: center;
    text-align: center;
    gap: 8rem;
  }

  .stat-giant {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .stat-num-neon {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: clamp(3rem, 6vw, 5.5rem);
    color: var(--color-primary);
    line-height: 1;
    margin-bottom: 0.5rem;
    text-shadow: 0 0 40px rgba(0, 240, 255, 0.4);
  }

  .stat-label-torneum {
    font-size: 1.1rem;
    color: var(--color-text-primary);
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .how-split {
      grid-template-columns: 1fr;
    }
    .stats-grid-giant {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .how-header {
      margin-left: -1rem;
      border-radius: var(--radius-sm);
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Images array
    const images = [
      "https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=2070&auto=format&fit=crop", // Matchmaking
      "https://images.unsplash.com/photo-1552820728-8b83bb6b773f?q=80&w=2070&auto=format&fit=crop",   // Comunidades
      "https://images.unsplash.com/photo-1550745165-9bc0b252726f?q=80&w=2070&auto=format&fit=crop", // Partidas
      "https://images.unsplash.com/photo-1534423861386-85a16f5d13fd?q=80&w=2070&auto=format&fit=crop"  // Nivel
    ];

    const timelineSteps = document.querySelectorAll('.js-timeline-step');
    const timelineSlidingPill = document.getElementById('timeline-sliding-pill');
    const timelineImage = document.getElementById('timeline-image');
    let currentIndex = 0;
    const maxIndex = timelineSteps.length - 1;

    function activateStep(index) {
      if (!timelineSlidingPill || !timelineImage || timelineSteps.length === 0) return;
      
      // Update opacities
      timelineSteps.forEach((step, i) => {
        if (i === index) {
          step.classList.add('active');
          
          // Move the pill
          // Center the pill (44px) on the dot (top 4px relative to step).
          // step.offsetTop + 4px (dot top) - 22px (half pill) + 5px (half dot) = offsetTop - 13px
          timelineSlidingPill.style.top = `${step.offsetTop - 13}px`;
        } else {
          step.classList.remove('active');
        }
      });
      
      // Update image
      timelineImage.style.backgroundImage = `url('${images[index]}')`;
    }

    // Auto-play the timeline
    let interval = setInterval(() => {
      currentIndex = (currentIndex + 1) % timelineSteps.length;
      activateStep(currentIndex);
    }, 4000); // changes every 4s

    // Initially activate first step
    activateStep(0);

    // Make steps clickable to jump manually
    timelineSteps.forEach((step) => {
      step.addEventListener('click', () => {
        clearInterval(interval); // Stop auto-play on manual click
        const index = parseInt(step.getAttribute('data-index') || '0', 10);
        currentIndex = index;
        activateStep(index);
        
        // Resume autoplay
        interval = setInterval(() => {
          currentIndex = (currentIndex + 1) % timelineSteps.length;
          activateStep(currentIndex);
        }, 4000);
      });
    });
  });

  // ── Carousel Controls Logic ──
  document.addEventListener('DOMContentLoaded', () => {
    const track = document.getElementById('games-carousel-track');
    const btnPrev = document.getElementById('btn-prev-game');
    const btnNext = document.getElementById('btn-next-game');

    if (track && btnPrev && btnNext) {
      const scrollAmount = 260; // Approx card width + gap
      btnPrev.addEventListener('click', () => {
        track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
      });
      btnNext.addEventListener('click', () => {
        track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
      });
    }
  });
</script>

<script>
  // ── WebSocket Realtime Count ──
  import { supabase } from '../lib/supabase';
  
  const playerCountEl = document.getElementById('realtime-player-count');
  
  if (playerCountEl) {
    // Current count extracted from DOM
    let currentCount = parseInt(playerCountEl.textContent.replace('+', '')) || 0;
    
    // Subscribe to INSERT and DELETE events on profiles
    const subscription = supabase.channel('public:profiles')
      .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'profiles' }, payload => {
        currentCount++;
        playerCountEl.textContent = `+${currentCount}`;
      })
      .on('postgres_changes', { event: 'DELETE', schema: 'public', table: 'profiles' }, payload => {
        currentCount = Math.max(0, currentCount - 1);
        playerCountEl.textContent = `+${currentCount}`;
      })
      .subscribe();
  }
</script>

