---
import MainLayout from '../layouts/MainLayout.astro';
import GamesView from '../components/views/GamesView.astro';

const user = Astro.locals.user;
---

<MainLayout title="Juegos — Gamio 🎮">
  <div class="dashboard-content animate-fade-in-up">
    <GamesView />
  </div>
</MainLayout>

<style>
  .dashboard-content {
    padding: 2rem;
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
  }

  @media (max-width: 768px) {
    .dashboard-content {
      padding: 1rem;
    }
  }
</style>
