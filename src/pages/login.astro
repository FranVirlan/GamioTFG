---
/**
 * login.astro — Página de inicio de sesión
 * Diseño card centrada con gradiente de fondo
 */
import MainLayout from '../layouts/MainLayout.astro';
import { supabase } from '../lib/supabase';

let errorMessage = '';
let successMessage = '';

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const email = formData.get('email')?.toString() || '';
    const password = formData.get('password')?.toString() || '';

    if (!email || !password) {
      errorMessage = 'Por favor, completa todos los campos.';
    } else {
      const { data, error } = await supabase.auth.signInWithPassword({
        email,
        password,
      });

      if (error) {
        errorMessage = error.message === 'Invalid login credentials'
          ? 'Email o contraseña incorrectos.'
          : error.message;
      } else if (data.session) {
        Astro.cookies.set('sb-access-token', data.session.access_token, {
          path: '/',
          httpOnly: true,
          secure: true,
          sameSite: 'lax',
          maxAge: 60 * 60,
        });
        Astro.cookies.set('sb-refresh-token', data.session.refresh_token!, {
          path: '/',
          httpOnly: true,
          secure: true,
          sameSite: 'lax',
          maxAge: 60 * 60 * 24 * 7,
        });
        return Astro.redirect('/home');
      }
    }
  } catch (e) {
    errorMessage = 'Ocurrió un error inesperado. Inténtalo de nuevo.';
  }
}

// Check URL params for messages
const urlError = Astro.url.searchParams.get('error');
const urlSuccess = Astro.url.searchParams.get('success');
if (urlError && !errorMessage) errorMessage = urlError;
if (urlSuccess) successMessage = urlSuccess;
---

<MainLayout title="Iniciar Sesión — Gamio 🚀">
  <section class="auth-page">
    <!-- Background decoration -->
    <div class="auth-glow auth-glow-1"></div>
    <div class="auth-glow auth-glow-2"></div>
    <div class="auth-glow auth-glow-3"></div>

    <div class="auth-container animate-fade-in-up">
      <!-- Card -->
      <div class="auth-card">
        <div class="auth-header">
          <a href="/" class="auth-logo">🚀</a>
          <h1>Bienvenido de nuevo</h1>
          <p>Inicia sesión en tu cuenta de Gamio</p>
        </div>

        {errorMessage && (
          <div class="alert alert-error" id="alertError">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10" /><path d="M15 9l-6 6M9 9l6 6" />
            </svg>
            {errorMessage}
          </div>
        )}

        {successMessage && (
          <div class="alert alert-success" id="alertSuccess">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" />
            </svg>
            {successMessage}
          </div>
        )}

        <form method="POST" class="auth-form" id="loginForm">
          <div class="form-group">
            <label for="login-email">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="4" width="20" height="16" rx="2" /><path d="M22 7l-10 7L2 7" />
              </svg>
              Email
            </label>
            <input
              type="email"
              id="login-email"
              name="email"
              placeholder="tu@email.com"
              required
              autocomplete="email"
            />
          </div>

          <div class="form-group">
            <label for="login-password">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />
              </svg>
              Contraseña
            </label>
            <input
              type="password"
              id="login-password"
              name="password"
              placeholder="••••••••"
              required
              minlength="6"
              autocomplete="current-password"
            />
          </div>

          <button type="submit" class="btn-primary auth-submit" id="loginBtn">
            Iniciar Sesión
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </button>
        </form>

        <div class="auth-footer">
          <p>¿No tienes cuenta? <a href="/signup">Crear cuenta</a></p>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .auth-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.5rem;
    position: relative;
    overflow: hidden;
  }

  /* ── Glows ── */
  .auth-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    pointer-events: none;
  }

  .auth-glow-1 {
    width: 500px;
    height: 500px;
    background: rgba(30, 136, 229, 0.15);
    top: -150px;
    left: -150px;
  }

  .auth-glow-2 {
    width: 400px;
    height: 400px;
    background: rgba(124, 77, 255, 0.12);
    bottom: -100px;
    right: -100px;
  }

  .auth-glow-3 {
    width: 300px;
    height: 300px;
    background: rgba(0, 191, 165, 0.1);
    top: 50%;
    left: 60%;
    transform: translate(-50%, -50%);
  }

  /* ── Container ── */
  .auth-container {
    width: 100%;
    max-width: 440px;
    position: relative;
    z-index: 2;
  }

  /* ── Card ── */
  .auth-card {
    background: rgba(30, 41, 59, 0.8);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(148, 163, 184, 0.1);
    border-radius: 20px;
    padding: 2.5rem;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.3);
  }

  /* ── Header ── */
  .auth-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .auth-logo {
    font-size: 2.5rem;
    display: block;
    margin-bottom: 1rem;
    text-decoration: none;
    animation: float 3s ease-in-out infinite;
  }

  .auth-header h1 {
    font-size: 1.6rem;
    font-weight: 800;
    margin-bottom: 0.4rem;
    letter-spacing: -0.02em;
  }

  .auth-header p {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
  }

  /* ── Alerts ── */
  .alert {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border-radius: 10px;
    font-size: 0.85rem;
    font-weight: 500;
    margin-bottom: 1.5rem;
  }

  .alert-error {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.25);
    color: #FCA5A5;
  }

  .alert-success {
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.25);
    color: #86EFAC;
  }

  /* ── Form ── */
  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    margin-bottom: 0.4rem;
  }

  .form-group label svg {
    opacity: 0.6;
  }

  .form-group input {
    width: 100%;
    padding: 0.8rem 1rem;
    font-size: 0.95rem;
    font-family: var(--font-sans);
    color: var(--color-text-primary);
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    outline: none;
    transition: all 0.3s ease;
  }

  .form-group input:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(30, 136, 229, 0.15);
    background: rgba(15, 23, 42, 0.8);
  }

  .form-group input::placeholder {
    color: var(--color-text-muted);
  }

  .auth-submit {
    width: 100%;
    padding: 0.85rem;
    font-size: 1rem;
    margin-top: 0.5rem;
  }

  /* ── Footer ── */
  .auth-footer {
    text-align: center;
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .auth-footer p {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  .auth-footer a {
    color: var(--color-primary);
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .auth-footer a:hover {
    color: var(--color-primary-light);
  }

  /* ── Responsive ── */
  @media (max-width: 480px) {
    .auth-card {
      padding: 2rem 1.5rem;
    }
  }
</style>
