---
/**
 * login.astro — Página de inicio de sesión
 * Gaming aesthetic: violeta, azul neón, glassmorphism
 */
import MainLayout from '../layouts/MainLayout.astro';
import { supabase } from '../lib/supabase';

let errorMessage = '';
let successMessage = '';

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const email = formData.get('email')?.toString() || '';
    const password = formData.get('password')?.toString() || '';

    if (!email || !password) {
      errorMessage = 'Por favor, completa todos los campos.';
    } else {
      const { data, error } = await supabase.auth.signInWithPassword({
        email,
        password,
      });

      if (error) {
        errorMessage = error.message === 'Invalid login credentials'
          ? 'Email o contraseña incorrectos.'
          : error.message;
      } else if (data.session) {
        Astro.cookies.set('sb-access-token', data.session.access_token, {
          path: '/',
          httpOnly: true,
          secure: true,
          sameSite: 'lax',
          maxAge: 60 * 60,
        });
        Astro.cookies.set('sb-refresh-token', data.session.refresh_token!, {
          path: '/',
          httpOnly: true,
          secure: true,
          sameSite: 'lax',
          maxAge: 60 * 60 * 24 * 7,
        });
        return Astro.redirect('/home');
      }
    }
  } catch (e) {
    errorMessage = 'Ocurrió un error inesperado. Inténtalo de nuevo.';
  }
}

const urlError = Astro.url.searchParams.get('error');
const urlSuccess = Astro.url.searchParams.get('success');
if (urlError && !errorMessage) errorMessage = urlError;
if (urlSuccess) successMessage = urlSuccess;
---

<MainLayout title="Iniciar Sesión — Gamio 🎮">
  <section class="auth-page">
    <div class="auth-orb auth-orb-1"></div>
    <div class="auth-orb auth-orb-2"></div>
    <div class="auth-orb auth-orb-3"></div>
    <div class="auth-grid-bg"></div>

    <div class="auth-container animate-fade-in-up">
      <div class="auth-card">
        <div class="auth-header">
          <a href="/" class="auth-logo">🎮</a>
          <h1>Bienvenido de nuevo</h1>
          <p>Inicia sesión en tu cuenta de Gamio</p>
        </div>

        {errorMessage && (
          <div class="alert alert-error" id="alertError">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10" /><path d="M15 9l-6 6M9 9l6 6" />
            </svg>
            {errorMessage}
          </div>
        )}

        {successMessage && (
          <div class="alert alert-success" id="alertSuccess">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" />
            </svg>
            {successMessage}
          </div>
        )}

        <form method="POST" class="auth-form" id="loginForm">
          <div class="form-group">
            <label for="login-email">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="4" width="20" height="16" rx="2" /><path d="M22 7l-10 7L2 7" />
              </svg>
              Email
            </label>
            <input
              type="email"
              id="login-email"
              name="email"
              placeholder="tu@email.com"
              required
              autocomplete="email"
            />
          </div>

          <div class="form-group">
            <label for="login-password">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />
              </svg>
              Contraseña
            </label>
            <div class="password-wrapper">
              <input
                type="password"
                id="login-password"
                name="password"
                placeholder="••••••••"
                required
                minlength="6"
                autocomplete="current-password"
              />
              <button type="button" class="password-toggle" aria-label="Mostrar contraseña">
                <svg class="icon-eye" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
                <svg class="icon-eye-off" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
                  <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                  <line x1="1" y1="1" x2="23" y2="23"></line>
                </svg>
              </button>
            </div>
          </div>

          <button type="submit" class="btn-primary auth-submit" id="loginBtn">
            Iniciar Sesión
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </button>
        </form>

        <div class="auth-footer">
          <p>¿No tienes cuenta? <a href="/signup">Crear cuenta</a></p>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .auth-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.5rem;
    position: relative;
    overflow: hidden;
  }

  /* ── Decorative ── */
  .auth-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    pointer-events: none;
  }

  .auth-orb-1 {
    width: 500px;
    height: 500px;
    background: rgba(0, 240, 255, 0.15); /* Torneum cyan */
    top: -150px;
    left: -150px;
  }

  .auth-orb-2 {
    width: 400px;
    height: 400px;
    background: rgba(255, 60, 172, 0.1); /* Torneum coral */
    bottom: -100px;
    right: -100px;
  }

  .auth-orb-3 {
    width: 300px;
    height: 300px;
    background: rgba(108, 58, 255, 0.08); /* Electric Purple */
    top: 50%;
    left: 60%;
    transform: translate(-50%, -50%);
  }

  .auth-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(0, 240, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 240, 255, 0.02) 1px, transparent 1px);
    background-size: 60px 60px;
    pointer-events: none;
  }

  /* ── Container ── */
  .auth-container {
    width: 100%;
    max-width: 440px;
    position: relative;
    z-index: 2;
  }

  /* ── Card ── */
  .auth-card {
    background: rgba(15, 20, 31, 0.85); /* Darker matching primary bg */
    backdrop-filter: blur(30px);
    -webkit-backdrop-filter: blur(30px);
    border: 1px solid rgba(0, 240, 255, 0.15); /* Cyan border */
    border-radius: var(--radius-xl);
    padding: 2.5rem;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6);
  }

  /* ── Header ── */
  .auth-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .auth-logo {
    font-size: 2.5rem;
    display: block;
    margin-bottom: 1rem;
    text-decoration: none;
    animation: float 4s ease-in-out infinite;
  }

  .auth-header h1 {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 700;
    margin-bottom: 0.4rem;
    letter-spacing: -0.02em;
  }

  .auth-header p {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
  }

  /* ── Alerts ── */
  .alert {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    font-weight: 500;
    margin-bottom: 1.5rem;
  }

  .alert-error {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.25);
    color: var(--color-error-light);
  }

  .alert-success {
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.25);
    color: var(--color-secondary-light);
  }

  /* ── Form ── */
  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    margin-bottom: 0.4rem;
  }

  .form-group label svg {
    opacity: 0.6;
  }

  .form-group input {
    width: 100%;
    padding: 0.8rem 1rem;
    font-size: 0.95rem;
    font-family: var(--font-sans);
    color: var(--color-text-primary);
    background: rgba(11, 15, 26, 0.6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    outline: none;
    transition: all 0.25s ease;
  }

  .form-group input:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(0, 240, 255, 0.12); /* Cyan neon ring */
    background: rgba(11, 15, 26, 0.8);
  }

  .form-group input::placeholder {
    color: var(--color-text-muted);
  }

  /* ── Password Toggle ── */
  .password-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }
  
  .password-wrapper input {
    width: 100%;
    padding-right: 2.75rem; /* Make room for the eye icon */
  }

  .password-toggle {
    position: absolute;
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    color: var(--color-text-secondary);
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s ease;
  }

  .password-toggle:hover {
    color: var(--color-primary); /* Cyan on hover */
  }

  .auth-submit {
    width: 100%;
    padding: 0.85rem;
    font-size: 1rem;
    margin-top: 0.5rem;
  }

  /* ── Footer ── */
  .auth-footer {
    text-align: center;
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .auth-footer p {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  .auth-footer a {
    color: var(--color-primary);
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .auth-footer a:hover {
    color: var(--color-primary-light);
    text-decoration: underline;
  }

  @media (max-width: 480px) {
    .auth-card {
      padding: 2rem 1.5rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtns = document.querySelectorAll('.password-toggle');
    
    toggleBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const input = target.previousElementSibling as HTMLInputElement;
        const iconEye = target.querySelector('.icon-eye') as HTMLElement;
        const iconEyeOff = target.querySelector('.icon-eye-off') as HTMLElement;
        
        if (input.type === 'password') {
          input.type = 'text';
          iconEye.style.display = 'none';
          iconEyeOff.style.display = 'block';
        } else {
          input.type = 'password';
          iconEye.style.display = 'block';
          iconEyeOff.style.display = 'none';
        }
      });
    });
  });
</script>
