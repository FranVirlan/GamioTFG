---
import MainLayout from '../layouts/MainLayout.astro';
import ConversationsSidebar from '../components/views/ConversationsSidebar.astro';
import { createServerClient } from '../lib/supabase';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login');
}

const accessToken = Astro.cookies.get('sb-access-token')?.value;
const supabase = createServerClient(accessToken);

// Obtener las conversaciones del usuario
const { data, error } = await supabase
  .from('conversation_participants')
  .select(`
    conversation_id,
    conversations (
      id,
      updated_at,
      conversation_participants (
        profiles (
          id,
          name,
          avatar_url
        )
      )
    )
  `)
  .eq('profile_id', user.id)
  .order('created_at', { ascending: false });

const formattedConversations = (data || []).map((cp: any) => {
  const conv = cp.conversations;
  const otherParticipant = conv.conversation_participants.find(
    (p: any) => p.profiles.id !== user.id
  )?.profiles;

  return {
    id: conv.id,
    updated_at: conv.updated_at,
    other_user: otherParticipant
  };
}).filter((c: any) => c.other_user);
---

<MainLayout title="Mensajes — Gamio 🎮">
  <div class="messages-page animate-fade-in-up">
    <div class="layout-grid">
      <ConversationsSidebar conversations={formattedConversations} />
      
      <div class="chat-placeholder">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
        </svg>
        <h3>Tus Mensajes</h3>
        <p>Selecciona una conversación de la lista para empezar a chatear.</p>
      </div>
    </div>
  </div>
</MainLayout>

<style>
  .messages-page {
    padding: 2rem;
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    height: calc(100vh - var(--topbar-height) - 4rem);
  }

  .layout-grid {
    display: flex;
    gap: 2rem;
    height: 100%;
  }

  .chat-placeholder {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--color-surface-card);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--color-text-muted);
    text-align: center;
  }

  .chat-placeholder svg {
    margin-bottom: 1rem;
    color: var(--color-border);
  }

  .chat-placeholder h3 {
    color: var(--color-text-secondary);
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }

  @media (max-width: 768px) {
    .messages-page {
      padding: 1rem;
      height: auto;
      min-height: calc(100vh - var(--topbar-height));
    }
    
    .layout-grid {
      flex-direction: column;
    }

    .chat-placeholder {
      display: none;
    }
  }

  @media (min-width: 769px) {
    html, body {
      overflow: hidden !important;
    }
  }
</style>
