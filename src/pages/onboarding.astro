---
/**
 * onboarding.astro
 * Cuestionario de bienvenida para nuevos usuarios.
 */
import MainLayout from '../layouts/MainLayout.astro';
import { createServerClient } from '../lib/supabase';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login');
}

let errorMessage = '';

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const favorite_games = formData.getAll('games') as string[];
    const play_style = formData.get('play_style')?.toString() || '';
    const player_type_sought = formData.get('player_type_sought')?.toString() || '';

    const accessToken = Astro.cookies.get('sb-access-token')?.value;
    const authSupabase = createServerClient(accessToken);

    console.log('--- ONBOARDING DEBUG ---');
    console.log('User ID:', user.id);
    console.log('Access Token exists:', !!accessToken);
    console.log('Data to save:', { favorite_games, play_style, player_type_sought });

    const { data: updateData, error } = await authSupabase
      .from('profiles')
      .update({
        favorite_games,
        play_style,
        player_type_sought,
        onboarding_completed: true,
      })
      .eq('id', user.id)
      .select();

    console.log('Update result:', updateData);
    console.log('Update error:', error);

    if (error) {
      errorMessage = error.message;
    } else if (!updateData || updateData.length === 0) {
      errorMessage = 'No se pudo guardar. Verifica que la política RLS de UPDATE exista en la tabla profiles.';
      console.log('WARNING: Update returned 0 rows — probable RLS issue');
    } else {
      // Otorgar +15 puntos y +30 XP por completar el onboarding de bienvenida (mantiene Nivel 1)
      try {
        await authSupabase.rpc('earn_points', {
          p_profile_id: user.id,
          p_amount: 15,
          p_xp_amount: 30
        });
      } catch (rpcErr) {
        console.error('Error al otorgar puntos por onboarding:', rpcErr);
      }
      return Astro.redirect('/?welcome=true');
    }
  } catch (e) {
    errorMessage = 'Ocurrió un error inesperado al guardar tus preferencias.';
  }
}

const popularGames = [
  "League of Legends", "Valorant", "Counter-Strike 2", 
  "Dead By Daylight", "Fortnite", "Apex Legends", 
  "Overwatch 2", "Call of Duty: Warzone", "Rocket League", "EA FC 25"
];
---

<MainLayout title="Bienvenido a Gamio 🎮 - Queremos conocerte">
  <section class="onboarding-page">
    <div class="auth-orb auth-orb-1"></div>
    <div class="auth-orb auth-orb-2"></div>
    <div class="auth-grid-bg"></div>

    <div class="onboarding-container animate-fade-in-up">
      <div class="onboarding-card">
        <div class="onboarding-header">
          <h1>¡Bienvenido a la comunidad! 🎉</h1>
          <p>Para ayudarte a conectar con los jugadores ideales, cuéntanos un poco sobre ti.</p>
        </div>

        {errorMessage && (
          <div class="alert alert-error">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10" /><path d="M15 9l-6 6M9 9l6 6" />
            </svg>
            {errorMessage}
          </div>
        )}

        <form method="POST" class="onboarding-form">
          
          <div class="form-section">
            <label class="section-title">¿Cuáles son tus juegos favoritos? (Puedes elegir varios)</label>
            <div class="games-grid">
              {popularGames.map(game => (
                <label class="game-checkbox">
                  <input type="checkbox" name="games" value={game} />
                  <span class="game-pill">{game}</span>
                </label>
              ))}
            </div>
          </div>

          <div class="form-section">
            <label class="section-title">¿Cómo definirías tu estilo de juego?</label>
            <div class="options-group">
              <label class="radio-card">
                <input type="radio" name="play_style" value="Casual" required />
                <div class="radio-content">
                  <span class="radio-title">🎮 Casual</span>
                  <span class="radio-desc">Juego para divertirme y desconectar.</span>
                </div>
              </label>
              <label class="radio-card">
                <input type="radio" name="play_style" value="Competitivo" />
                <div class="radio-content">
                  <span class="radio-title">⚔️ Competitivo</span>
                  <span class="radio-desc">Me gusta mejorar, aprender y subir de rango.</span>
                </div>
              </label>
              <label class="radio-card">
                <input type="radio" name="play_style" value="Tryhard" />
                <div class="radio-content">
                  <span class="radio-title">🔥 Tryhard</span>
                  <span class="radio-desc">Doy el 200% en cada partida, juego para ganar.</span>
                </div>
              </label>
              <label class="radio-card">
                <input type="radio" name="play_style" value="Depende del día" />
                <div class="radio-content">
                  <span class="radio-title">⚖️ Depende del día</span>
                  <span class="radio-desc">Hay días que me gusta jugar chill y otros jugar competitivo.</span>
                </div>
              </label>
            </div>
          </div>

          <div class="form-section">
            <label class="section-title">¿Qué tipo de jugadores estás buscando?</label>
            <div class="options-group">
              <label class="radio-card">
                <input type="radio" name="player_type_sought" value="Social" required />
                <div class="radio-content">
                  <span class="radio-title">💬 Social y chill</span>
                  <span class="radio-desc">Gente con la que charlar, reír y pasar un buen rato.</span>
                </div>
              </label>
              <label class="radio-card">
                <input type="radio" name="player_type_sought" value="Ranked" />
                <div class="radio-content">
                  <span class="radio-title">🏆 Serios para rankear</span>
                  <span class="radio-desc">Compañeros constantes para subir en competitivo.</span>
                </div>
              </label>
              <label class="radio-card">
                <input type="radio" name="player_type_sought" value="Mixto" />
                <div class="radio-content">
                  <span class="radio-title">⚖️ Un poco de todo</span>
                  <span class="radio-desc">Depende del día, me adapto a lo que surja.</span>
                </div>
              </label>
            </div>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn-primary auth-submit">
              Comenzar mi aventura
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </button>
            <a href="/?welcome=true" class="skip-link">Saltar por ahora</a>
          </div>
        </form>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .onboarding-page {
    min-height: calc(100vh - 70px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.5rem;
    position: relative;
    overflow: hidden;
  }

  .auth-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    pointer-events: none;
    z-index: 0;
  }

  .auth-orb-1 {
    width: 600px;
    height: 600px;
    background: rgba(0, 240, 255, 0.1);
    top: -200px;
    right: -200px;
  }

  .auth-orb-2 {
    width: 500px;
    height: 500px;
    background: rgba(108, 58, 255, 0.1);
    bottom: -150px;
    left: -150px;
  }

  .auth-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(0, 240, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 240, 255, 0.02) 1px, transparent 1px);
    background-size: 60px 60px;
    pointer-events: none;
    z-index: 0;
  }

  .onboarding-container {
    width: 100%;
    max-width: 800px;
    position: relative;
    z-index: 2;
  }

  .onboarding-card {
    background: rgba(15, 20, 31, 0.85);
    backdrop-filter: blur(30px);
    -webkit-backdrop-filter: blur(30px);
    border: 1px solid rgba(0, 240, 255, 0.15);
    border-radius: var(--radius-xl);
    padding: 3rem;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6);
  }

  .onboarding-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .onboarding-header h1 {
    font-family: var(--font-heading);
    font-size: 2.2rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    background: linear-gradient(135deg, #fff, var(--color-primary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .onboarding-header p {
    color: var(--color-text-secondary);
    font-size: 1.1rem;
  }

  .onboarding-form {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .form-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .section-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-text-primary);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.5rem;
  }

  /* Games Grid */
  .games-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .game-checkbox {
    cursor: pointer;
  }

  .game-checkbox input {
    display: none;
  }

  .game-pill {
    display: inline-block;
    padding: 0.6rem 1.2rem;
    background: rgba(11, 15, 26, 0.6);
    border: 1px solid var(--color-border);
    border-radius: 100px;
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    transition: all 0.2s ease;
  }

  .game-checkbox:hover .game-pill {
    background: rgba(255, 255, 255, 0.05);
    color: var(--color-text-primary);
  }

  .game-checkbox input:checked + .game-pill {
    background: rgba(0, 240, 255, 0.15);
    border-color: var(--color-primary);
    color: var(--color-primary-light);
    box-shadow: 0 0 15px rgba(0, 240, 255, 0.2);
  }

  /* Options Group */
  .options-group {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  .radio-card {
    cursor: pointer;
  }

  .radio-card input {
    display: none;
  }

  .radio-content {
    height: 100%;
    padding: 1.25rem;
    background: rgba(11, 15, 26, 0.6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: all 0.2s ease;
  }

  .radio-title {
    font-weight: 600;
    color: var(--color-text-primary);
    font-size: 1.05rem;
  }

  .radio-desc {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.4;
  }

  .radio-card:hover .radio-content {
    background: rgba(255, 255, 255, 0.03);
    transform: translateY(-2px);
  }

  .radio-card input:checked + .radio-content {
    background: rgba(108, 58, 255, 0.1);
    border-color: var(--color-accent);
    box-shadow: 0 0 20px rgba(108, 58, 255, 0.15);
  }
  
  .radio-card input:checked + .radio-content .radio-title {
    color: var(--color-accent-light);
  }

  /* Form Actions */
  .form-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-top: 1rem;
  }

  .auth-submit {
    width: 100%;
    max-width: 400px;
    padding: 1rem;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }

  .skip-link {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    text-decoration: none;
    transition: color 0.2s;
  }

  .skip-link:hover {
    color: var(--color-text-secondary);
    text-decoration: underline;
  }

  .alert {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem;
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 2rem;
  }

  .alert-error {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.25);
    color: var(--color-error-light);
  }

  @media (max-width: 640px) {
    .onboarding-card {
      padding: 2rem 1.5rem;
    }
    
    .onboarding-header h1 {
      font-size: 1.8rem;
    }
  }
</style>
