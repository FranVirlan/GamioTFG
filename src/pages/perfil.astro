---
import MainLayout from '../layouts/MainLayout.astro';
import ProfileView from '../components/views/ProfileView.astro';

import { supabase } from '../lib/supabase';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login');
}

const { data: myProfile } = await supabase.from('profiles').select('*').eq('id', user.id).single();

const targetUserName = Astro.url.searchParams.get('usuario');
let targetProfile = null;

if (targetUserName) {
  const { data } = await supabase.from('profiles').select('*').eq('name', targetUserName).single();
  targetProfile = data;
}

// Si hay un targetUserName pero no se encuentra en DB, es un mock user.
const isMockUser = targetUserName && !targetProfile;
const isOwnProfile = !targetUserName || (targetProfile && targetProfile.id === user.id);
const displayProfile = targetProfile || (isMockUser ? null : myProfile);

const profileData = {
  id: displayProfile?.id,
  name: displayProfile?.name || targetUserName || user?.user_metadata?.name || user?.email?.split('@')[0] || 'Jugador',
  avatarUrl: displayProfile?.avatar_url || null,
  level: displayProfile?.level || (isMockUser ? Math.floor(Math.random() * 50) + 1 : 1),
  followers: displayProfile?.followers_count || (isMockUser ? Math.floor(Math.random() * 500) : 0),
  gamesPlayed: displayProfile?.games_played || (isMockUser ? Math.floor(Math.random() * 100) : 0),
  description: displayProfile?.description || (isMockUser ? `Perfil de ${targetUserName}. Jugador competitivo siempre buscando equipo para rankear.` : 'Jugador competitivo siempre buscando equipo para rankear.'),
};
---


<MainLayout title={`Perfil de ${profileData.name} — Gamio 🎮`}>
  <div class="dashboard-content animate-fade-in-up">
    <ProfileView user={profileData} isOwnProfile={isOwnProfile} />
  </div>
</MainLayout>

<style>
  .dashboard-content {
    padding: 2rem;
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
  }

  @media (max-width: 768px) {
    .dashboard-content {
      padding: 1rem;
    }
  }
</style>
