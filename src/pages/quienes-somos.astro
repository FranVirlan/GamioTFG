---
/**
 * quienes-somos.astro — Página "Quiénes Somos"
 * Gaming aesthetic con nueva paleta violeta/neón
 */
import MainLayout from '../layouts/MainLayout.astro';
import Footer from '../components/Footer.astro';

const teamValues = [
  {
    icon: '🎯',
    title: 'Nuestra Misión',
    description: 'Crear la mejor plataforma social gaming donde encontrar compañeros de juego sea instantáneo y divertido.',
  },
  {
    icon: '🌟',
    title: 'Nuestra Visión',
    description: 'Ser la referencia en matchmaking gamer, conectando millones de jugadores en partidas épicas cada día.',
  },
  {
    icon: '🤝',
    title: 'Nuestros Valores',
    description: 'Comunidad, fair play, innovación y pasión por los videojuegos. Cada decisión que tomamos se basa en estos pilares.',
  },
];

const features = [
  { icon: '⚡', title: 'Rendimiento', desc: 'Matchmaking instantáneo y sin lag' },
  { icon: '🔒', title: 'Seguridad', desc: 'Protección de datos y juego seguro' },
  { icon: '🌍', title: 'Global', desc: 'Jugadores de todo el mundo' },
  { icon: '📱', title: 'Multiplataforma', desc: 'Juega desde cualquier dispositivo' },
];
---

<MainLayout title="Quiénes Somos — Gamio 🎮">
  <section class="page-hero">
    <div class="container">
      <h1 class="page-title animate-fade-in-up">
        Quiénes <span class="gradient-text">Somos</span>
      </h1>
      <p class="page-subtitle animate-fade-in-up" style="animation-delay: 0.1s;">
        Somos un equipo apasionado por los videojuegos y la tecnología,
        dedicados a conectar gamers de todo el mundo.
      </p>
    </div>
    <div class="hero-orb hero-orb-1"></div>
    <div class="hero-orb hero-orb-2"></div>
  </section>

  <!-- Values -->
  <section class="values-section">
    <div class="container">
      <div class="values-grid">
        {teamValues.map((value, idx) => (
          <div class="value-card card animate-fade-in-up" style={`animation-delay: ${0.1 * idx}s;`}>
            <div class="value-icon">{value.icon}</div>
            <h3>{value.title}</h3>
            <p>{value.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="features-section">
    <div class="container">
      <h2 class="section-heading">¿Por qué <span class="gradient-text-violet">Gamio</span>?</h2>
      <div class="features-grid">
        {features.map((feat, idx) => (
          <div class="feature-item animate-fade-in-up" style={`animation-delay: ${0.1 * idx}s;`}>
            <span class="feature-icon-lg">{feat.icon}</span>
            <h4>{feat.title}</h4>
            <p>{feat.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="cta-banner">
    <div class="container">
      <div class="cta-card">
        <div class="cta-glow"></div>
        <h2>¿Te unes a la aventura?</h2>
        <p>Forma parte de la comunidad de Gamio y encuentra tu equipo perfecto.</p>
        <a href="/signup" class="btn-primary">Unirse ahora</a>
      </div>
    </div>
  </section>

  <Footer />
</MainLayout>

<style>
  .page-hero {
    position: relative;
    padding: 10rem 0 4rem;
    text-align: center;
    overflow: hidden;
  }

  .page-title {
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    font-weight: 700;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .page-subtitle {
    font-size: 1.1rem;
    color: var(--color-text-secondary);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    pointer-events: none;
  }

  .hero-orb-1 {
    width: 400px;
    height: 400px;
    background: rgba(0, 240, 255, 0.15); /* Torneum cyan */
    top: -100px;
    right: -100px;
  }

  .hero-orb-2 {
    width: 350px;
    height: 350px;
    background: rgba(255, 60, 172, 0.1); /* Torneum coral */
    bottom: -50px;
    left: -50px;
  }

  /* ── Values ── */
  .values-section {
    padding: 4rem 0;
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .value-card {
    padding: 2.5rem 2rem;
    text-align: center;
  }

  .value-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .value-card h3 {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .value-card p {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* ── Features ── */
  .features-section {
    padding: 4rem 0;
  }

  .section-heading {
    text-align: center;
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 3rem;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .feature-item {
    text-align: center;
    padding: 2rem 1rem;
    border-radius: var(--radius-lg);
    background: var(--color-surface-card);
    border: 1px solid var(--color-border);
    transition: all 0.25s ease;
  }

  .feature-item:hover {
    border-color: rgba(0, 240, 255, 0.3);
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(0, 240, 255, 0.06);
  }

  .feature-icon-lg {
    font-size: 2.5rem;
    display: block;
    margin-bottom: 1rem;
  }

  .feature-item h4 {
    font-family: var(--font-heading);
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .feature-item p {
    color: var(--color-text-secondary);
    font-size: 0.85rem;
  }

  /* ── CTA ── */
  .cta-banner {
    padding: 4rem 0 2rem;
  }

  .cta-card {
    position: relative;
    text-align: center;
    padding: 4rem 2rem;
    border-radius: var(--radius-2xl);
    background: linear-gradient(135deg, rgba(0, 240, 255, 0.1), rgba(255, 60, 172, 0.06));
    border: 1px solid rgba(0, 240, 255, 0.2);
    overflow: hidden;
  }

  .cta-glow {
    position: absolute;
    top: -50%;
    left: 50%;
    transform: translateX(-50%);
    width: 400px;
    height: 400px;
    background: rgba(0, 240, 255, 0.1);
    border-radius: 50%;
    filter: blur(100px);
    pointer-events: none;
  }

  .cta-card h2 {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 1rem;
    position: relative;
  }

  .cta-card p {
    color: var(--color-text-secondary);
    margin-bottom: 2rem;
    position: relative;
  }

  .cta-card .btn-primary {
    position: relative;
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .values-grid {
      grid-template-columns: 1fr;
    }
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
